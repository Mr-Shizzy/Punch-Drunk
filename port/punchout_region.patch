+// Self-found delays (items found in your own world go off at a random moment).
+bool Delayed(int64_t id) {
+    return id == kHeartTrap || id == kHpTrap || id == kStarTrap || id == kSuperMac || id == kClockTrap || id == kHpZap ||
+           id == kIronFists;
+}
+const char* DelayName(int64_t id) {
+    switch (id) {
+    case kHeartTrap: return "Heart Trap";
+    case kHpTrap: return "HP Trap";
+    case kStarTrap: return "Star Trap";
+    case kClockTrap: return "Clock Trap";
+    case kSuperMac: return "Super Mac";
+    case kHpZap: return "HP Zap";
+    default: return "Iron Fists";
+    }
+}
+bool MayGoOff(int64_t id, long long index) {
+    if (!Delayed(id) || g.slot < 0) return true;
+    const auto by = FoundBy(id, index);
+    if (!by || *by != g.slot) return true;
+    const auto it = g.selfFoundDelays.find(id);
+    if (it == g.selfFoundDelays.end()) {
+        g.selfFoundDelays[id] = std::uniform_real_distribution<double>(3.0, 45.0)(g.rng);
+        Log(std::string(DelayName(id)) + " (found in your own world) is coming at a random moment...", kNote);
+        return false;
+    }
+    return it->second <= 0;
+}
+void WentOff(int64_t id) {
+    g.selfFoundDelays.erase(id);
+}
