+// The first bound key (keyboard) or button (controller) of a control, or kUnbound.
+int FirstBinding(size_t control, bool keyboard) {
+    using namespace PunchOutControls;
+    const int a = Binding(control, keyboard ? Key1 : Pad1);
+    return a != kUnbound ? a : Binding(control, keyboard ? Key2 : Pad2);
+}
+
+// One prompt texture: the binding's glyph or keycap in a 256x256 canvas, `box` pixels tall.
+Rgba DrawBinding(Style style, int code, float box, float maxWidth) {
+    Rgba img;
+    img.w = img.h = 256;
+    img.px.assign(256 * 256 * 4, 0);
+    if (style == Style::Keyboard) {
+        int arrow = 0;
+        const std::string label = KeycapLabel(code, arrow);
+        DrawKeycap(img, box, maxWidth, label, arrow);
+        return img;
+    }
+    if (const char* glyph = PadGlyphName(code)) {
+        const Rgba src = LoadPng(AssetPath(std::string("assets/glyphs/") +
+                                           (style == Style::PlayStation ? "playstation/" : "xbox/") + glyph + ".png"));
+        if (!src.px.empty()) {
+            BlitFit(img, src, box);
+            return img;
+        }
+    }
+    int arrow = 0;
+    DrawKeycap(img, box, maxWidth, PunchOutControls::PadName(code), arrow); // touchpad, paddles...: a labelled cap
+    return img;
+}
+
+// Rebuilds and registers the three prompt textures when the style or the bindings they show change.
+void UpdatePromptArt(Style style) {
+    using namespace PunchOutControls;
+    const bool keyboard = style == Style::Keyboard;
+    int one = FirstBinding(One, keyboard), two = FirstBinding(Two, keyboard);
+    // "Press A" takes the left punch's button in menus and cutscenes (wiimote_emulated.cpp); the star punch's if unbound.
+    const int pressA = one != kUnbound ? one : FirstBinding(PunchOutControls::A, keyboard);
+    const std::array<int, 4> signature = {static_cast<int>(style), one, two, pressA};
+    static std::array<int, 4> applied = {-1, -2, -2, -2};
+    if (signature == applied) return;
+    applied = signature;
+
+    struct Art {
+        const char* file; // the texture it replaces (texture pack naming)
+        int code;
+        float box, maxWidth;
+    };
+    constexpr float kFull = 256.f, kMash = 256.f * 0.74f;
+    const std::array<Art, 3> arts = {{
+        {"tex1_128x128_ff0d42747046b66c_4d71081cc1d2542b_9.png", one, kMash, 250.f},   // mash "1": left punch
+        {"tex1_128x128_6150a782d87e506b_ef58c6d3a3c22c18_9.png", two, kMash, 250.f},   // mash "2": right punch
+        {"tex1_128x128_2a6f353beffd1d2c_5.png", pressA, kFull, 254.f},                // "Press A"
+    }};
+    static std::vector<aurora::texture::ReplacementRegistration> registrations;
+    static std::array<std::vector<uint8_t>, 3> pixels; // borrowed by the registrations: freed only after unregistering
+    aurora::texture::unregister_replacements(registrations);
+    registrations.clear();
+    for (size_t i = 0; i < arts.size(); ++i) {
+        pixels[i].clear();
+        if (arts[i].code == kUnbound) continue; // nothing bound for this device: the pack's (or the game's) art stays
+        pixels[i] = DrawBinding(style, arts[i].code, arts[i].box, arts[i].maxWidth).px;
+        const auto key = aurora::texture::parse_replacement_filename(arts[i].file);
+        if (!key) continue;
+        aurora::texture::RawTextureReplacement raw{
+            .bytes = std::span<const uint8_t>(pixels[i]), .width = 256, .height = 256, .mipCount = 1,
+            .gxFormat = GX_TF_RGBA8_PC, .label = arts[i].file};
+        registrations.push_back(aurora::texture::register_replacement(*key, raw, {.priority = 200}));
+    }
+    std::fprintf(stderr, "[prompts] prompt art for %s: %zu textures\n",
+                 keyboard ? "keyboard" : style == Style::PlayStation ? "playstation" : "xbox", registrations.size());
+}
+
+// The controls screen's "Gamepad" label (patched in from "Wii Remote", punchout_disc_patches.cpp) reads "Keyboard"
+// while the keyboard is in use. The string table sits in guest memory and the screen looks its text up every frame,
+// so the label is rewritten in place (both fit the original 10-character slot). Found by searching for the patched
+// string, on menu screens only and a few times at most (other languages keep their own label).
+void UpdateControlsLabel(bool keyboard, bool menu) {
+    using Clock = std::chrono::steady_clock;
+    static uint8_t* where = nullptr;
+    static int applied = -1, scans = 0;
+    static Clock::time_point nextScan{};
+    const int want = keyboard ? 1 : 0;
+    const auto utf16 = [](const char* s) {
+        std::vector<uint8_t> v;
+        for (; *s; ++s) { v.push_back(0); v.push_back(static_cast<uint8_t>(*s)); }
+        v.resize(20, 0); // the slot: 10 characters
+        return v;
+    };
+    static const std::vector<uint8_t> kGamepad = utf16("Gamepad"), kKeyboard = utf16("Keyboard");
+    const auto holdsLabel = [&](const uint8_t* p) {
+        return p != nullptr && (std::equal(kGamepad.begin(), kGamepad.end(), p) ||
+                                std::equal(kKeyboard.begin(), kKeyboard.end(), p)) && p[20] == 0 && p[21] == 0;
+    };
+    if (where != nullptr && !holdsLabel(where)) { where = nullptr; applied = -1; } // the table was reloaded
+    if (where != nullptr && applied == want) return;
+    if (where == nullptr) {
+        if (!menu || scans >= 4 || Clock::now() < nextScan) return;
+        ++scans;
+        nextScan = Clock::now() + std::chrono::seconds(3);
+        // A whole string: 00 00 before it, its 20 bytes, 00 00 after.
+        for (const auto* pattern : {&kGamepad, &kKeyboard}) {
+            std::vector<uint8_t> needle = {0, 0};
+            needle.insert(needle.end(), pattern->begin(), pattern->end());
+            needle.push_back(0);
+            needle.push_back(0);
+            for (const auto& [base, size] : {std::pair<uint32_t, size_t>{0x80000000u, 0x01800000u},
+                                            std::pair<uint32_t, size_t>{0x90000000u, 0x04000000u}}) {
+                uint8_t* mem = Memory::GetPointer(base, size);
+                if (mem == nullptr) continue;
+                const auto it = std::search(mem, mem + size,
+                                            std::boyer_moore_horspool_searcher(needle.begin(), needle.end()));
+                if (it != mem + size && ((it - mem) & 1) == 0) { where = it + 2; break; }
+            }
+            if (where != nullptr) break;
+        }
+        if (where == nullptr) return;
+        scans = 0;
+    }
+    std::copy(want ? kKeyboard.begin() : kGamepad.begin(), want ? kKeyboard.end() : kGamepad.end(), where);
+    applied = want;
+}
