+// Punch-Out!! bring-up: every 5 s, log which translated function the guest thread is in and
+// how many frames reached the screen, so a hang without a crash still says where it is.
+// Every guest thread on __OSActiveThreadQueue: state, priority, the queue it sleeps on and the
+// call chain from its saved stack pointer. Printed when the presented-frame count stops moving.
+static void PunchOutDumpThreads() noexcept
+{
+    static const char* const kStates[] = {"?", "ready", "running", "?", "waiting", "?", "?", "?", "moribund"};
+    uint32_t thread = 0;
+    if (!Memory::TryRead32(0x800000DCu, thread)) {
+        return;
+    }
+    uint32_t running = 0;
+    Memory::TryRead32(kOSRunningContextAddr, running);
+    for (int count = 0; thread != 0 && count < 32; ++count) {
+        uint32_t stateWord = 0, prio = 0, queue = 0, sp = 0, lr = 0, srr0 = 0, mutex = 0, next = 0;
+        Memory::TryRead32(thread + 0x2C8u, stateWord);
+        Memory::TryRead32(thread + 0x2D0u, prio);
+        Memory::TryRead32(thread + 0x2DCu, queue);
+        Memory::TryRead32(thread + 0x2F0u, mutex);
+        Memory::TryRead32(thread + 0x04u, sp);
+        Memory::TryRead32(thread + 0x84u, lr);
+        Memory::TryRead32(thread + 0x198u, srr0);
+        const uint32_t state = stateWord >> 16;
+        std::fprintf(stderr,
+                     "[threads] %08X%s %-8s prio=%2d waitq=%08X mutex=%08X sp=%08X lr=%08X srr0=%08X\n         chain:",
+                     thread, thread == running ? "*" : " ", state < 9 ? kStates[state] : "?",
+                     static_cast<int32_t>(prio), queue, mutex, sp, lr, srr0);
+        uint32_t frame = sp;
+        for (int depth = 0; depth < 20; ++depth) {
+            uint32_t up = 0, savedLr = 0;
+            if (!Memory::TryRead32(frame, up) || up <= frame || up - frame > 0x10000u ||
+                !Memory::TryRead32(up + 4u, savedLr)) {
+                break;
+            }
+            std::fprintf(stderr, " %08X", savedLr);
+            frame = up;
+        }
+        std::fprintf(stderr, "\n");
+        if (!Memory::TryRead32(thread + 0x2FCu, next)) {
+            break;
+        }
+        thread = next;
+    }
+}
