+// ---- goal / counter (client_logic.py) ----
+int FightsCompletedInOrder(const std::set<int64_t>& checked) {
+    int c = 0;
+    while (c < kNumFights && checked.count(WinId(c + 1))) ++c;
+    return c;
+}
+int TargetCounter(int completed, int fighters) {
+    if (completed >= kNumFights) return kNumFights;
+    const int highest = std::min(kNumFights, 1 + fighters);
+    return std::min(completed + 1, highest) - 1;
+}
+bool GoalReached(const std::set<int64_t>& checked) {
+    int challenges = 0;
+    for (int64_t id = 201; id <= 278; ++id) challenges += checked.count(id) ? 1 : 0;
+    const bool contender = checked.count(WinId(kContenderFights)) != 0, td = checked.count(WinId(kNumFights)) != 0;
+    switch (g.goal) {
+    case 0: return contender;
+    case 1: return td;
+    case 2: return challenges >= g.challengesRequired;
+    case 3: return challenges >= g.challengesRequired && td;
+    default: return false;
+    }
+}
