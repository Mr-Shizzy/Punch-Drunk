diff --git a/runtime/include/wiimote_emulated.h b/runtime/include/wiimote_emulated.h
new file mode 100644
index 0000000..b96b35c
--- /dev/null
+++ b/runtime/include/wiimote_emulated.h
@@ -0,0 +1,23 @@
+#pragma once
+
+// An emulated Wii Remote, held sideways, driven by the PC gamepad (Punch-Out!! bring-up).
+// It sits on virtual remote slot 1 of the emulated Bluetooth controller and speaks the Wii
+// Remote's HID protocol (status, memory reads/writes, report modes), so the game's own WPAD and
+// KPAD drive it exactly like a real one. No motion: the accelerometer reports the remote lying
+// still. The pointer is emulated: while the game has the IR camera on, the right stick moves it
+// (or the PC mouse over the window places it, left click = A) and the camera sees the sensor bar.
+//
+// Controls: keyboard, mouse buttons and gamepad buttons through Punch-Out!!'s bindings (punchout_controls.h,
+// Config.toml [punchout_controls]; defaults there). The keyboard alone is enough to play. The left stick always
+// works as the D-pad; the mouse's left and right buttons are A and B in menus.
+// No HOME button: there is no Wii menu to return to.
+
+#include "bluetooth/bt_controller.h"
+
+namespace Wiimote {
+
+// Slot 1 is the emulated remote unless a physical remote occupies it; the other slots, and slot 1
+// whenever a physical remote is there, go to `physical`.
+Bluetooth::RemoteHost& EmulatedHost(Bluetooth::RemoteHost& physical);
+
+} // namespace Wiimote
