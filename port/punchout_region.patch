diff --git a/runtime/src/hle/punchout_ap_game.cpp b/runtime/src/hle/punchout_ap_game.cpp
new file mode 100644
index 0000000..cabb954
--- /dev/null
+++ b/runtime/src/hle/punchout_ap_game.cpp
@@ -0,0 +1,615 @@
+// Punch-Out!! Archipelago: the game side of the Punch-Out Wii apworld's Riivolution patch (its dol_patch.py),
+// done as native hooks. On Dolphin that patch writes PowerPC code into the game; here code written into memory
+// never runs, so each piece is a wrapper around the game function it hooked. The patch's data (flags, counters,
+// tables, the seed tag) stays at the same addresses in game memory, so the client (punchout_ap_client.cpp, a port
+// of the apworld's client.py) talks to these hooks exactly the way client.py talks to the patch.
+//
+// Everything here is off unless an Archipelago session has given the game its seed data (PunchOutAp::GameApply).
+//
+// Done:  fight frame mailboxes (death link knockdown, Heart Trap "tired", health bar refresh, Star Trap), fighter
+//        swap, move blocking, Second Chance + Mac's knockdown/knockout counters, Super Mac (hits phase through,
+//        tired effect, tint), damage multiplier, Clock Trap, Sandman intro in any circuit, cosmetics (music shuffle,
+//        Little Mac's outfits per circuit or per fight).
+
+#include "abi_bridge.h"
+#include "guest_function_imports.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "ppc_runtime.h"
+#include "guest_abi/guest_region.h"
+
+#include "punchout_ap_game.h"
+#include "third_party/nlohmann/json.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace PunchOutAp {
+namespace ap_game {
+
+constexpr uint32_t kMem1 = 0x80000000u, kMem1Size = 0x01800000u;
+std::atomic<bool> g_active{false};
+
+uint8_t* Mem() {
+    return static_cast<uint8_t*>(Memory::GetPointer(kMem1, kMem1Size));
+}
+bool In(uint32_t a, uint32_t n = 4) {
+    return a >= kMem1 && a - kMem1 <= kMem1Size - n;
+}
+uint32_t R32(uint32_t a) {
+    uint8_t* m = Mem();
+    if (m == nullptr || !In(a)) return 0;
+    const uint8_t* p = m + (a - kMem1);
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+}
+uint8_t R8(uint32_t a) {
+    uint8_t* m = Mem();
+    return m != nullptr && In(a, 1) ? m[a - kMem1] : 0;
+}
+float RF(uint32_t a) {
+    const uint32_t v = R32(a);
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+void W32(uint32_t a, uint32_t v) {
+    uint8_t* m = Mem();
+    if (m == nullptr || !In(a)) return;
+    uint8_t* p = m + (a - kMem1);
+    p[0] = uint8_t(v >> 24); p[1] = uint8_t(v >> 16); p[2] = uint8_t(v >> 8); p[3] = uint8_t(v);
+}
+void W8(uint32_t a, uint8_t v) {
+    uint8_t* m = Mem();
+    if (m != nullptr && In(a, 1)) m[a - kMem1] = v;
+}
+void WF(uint32_t a, float f) {
+    uint32_t v;
+    std::memcpy(&v, &f, 4);
+    W32(a, v);
+}
+bool Ptr(uint32_t v) {
+    return v >= 0x80004000u && v < kMem1 + kMem1Size && (v & 3u) == 0;
+}
+
+uint32_t Fight() {
+    const uint32_t f = R32(kFightPointer);
+    return Ptr(f) && R32(f) == kFightVtable ? f : 0;
+}
+uint32_t Mac() {
+    const uint32_t f = Fight();
+    return f ? R32(f + 4) : 0;
+}
+
+// Calls a guest function, keeping the registers the caller of our wrapper still needs.
+struct SavedRegs {
+    uint32_t gpr[13];
+    uint32_t lr;
+    PPC_FPR fpr[14];
+};
+SavedRegs Save(const CpuContext* ctx) {
+    SavedRegs s;
+    std::memcpy(s.gpr, ctx->gpr, sizeof s.gpr);
+    std::memcpy(s.fpr, ctx->fpr, sizeof s.fpr);
+    s.lr = ctx->lr;
+    return s;
+}
+void Restore(CpuContext* ctx, const SavedRegs& s) {
+    std::memcpy(ctx->gpr, s.gpr, sizeof s.gpr);
+    std::memcpy(ctx->fpr, s.fpr, sizeof s.fpr);
+    ctx->lr = s.lr;
+}
+
+// Move blocking (dol_patch "mask"): a jab that survives keeps BlockHigh (a jab includes it).
+uint32_t MaskMoves(uint32_t cmd) {
+    uint32_t blocked = R32(kInputMask);
+    if (blocked == 0) return cmd;
+    if ((cmd & ~blocked) & 0x0006u) blocked &= ~0x0400u;
+    return cmd & ~blocked;
+}
+
+// Name-copy call sites (each "bl 800A7B28" right before the copy into state+0x10): career picks arm the swap,
+// every other copy disarms it. The hook sees the call site as LR - 4.
+constexpr uint32_t kArmSites[] = {0x80060D74u, 0x80060E70u, 0x80060F28u};
+constexpr uint32_t kDisarmSites[] = {0x8002AF14u, 0x8002B038u, 0x80032910u, 0x80032980u, 0x80061F38u,
+                                     0x800660DCu, 0x80066138u, 0x800661A0u, 0x80100438u, 0x80070AC4u};
+
+GameSeedData g_seed;      // this seed's cosmetics (game thread)
+uint32_t g_musicMode = 0; // GameMode state of the last remapped fighter theme (0 = the game's own)
+
+// Music shuffle: fighter key -> its theme's event (Play_Music_<Bank>_InGame), track name -> (bank, GameMode state).
+constexpr uint32_t kChampionship = 0x876A7122u, kExhibition = 0xB2644902u;
+struct Bank {
+    const char* key;
+    uint32_t event;
+};
+constexpr Bank kBanks[] = {{"GlassJoe", 0xE7A511F4u},    {"VonKaiser", 0x091759FEu},  {"KidQuick", 0x67B7B031u},
+                           {"KingHippo", 0xA7EF1FFBu},   {"PistonHondo", 0xE5BA8D15u}, {"BearHugger", 0xF00AA5BAu},
+                           {"GreatTiger", 0xCA76B24Eu},  {"DonFlamenco", 0x388AF4D6u}, {"AranRyan", 0xCBAB4E88u},
+                           {"SodaPopinski", 0x4BC113DEu}, {"BaldBull", 0x7341BBAEu},   {"MachoMan", 0xFB0CCE74u},
+                           {"Sandman", 0x4576A288u},     {"DonkeyKong", 0xBB2D11D7u}};
+struct Track {
+    const char* name;
+    const char* bank;
+    uint32_t mode;
+};
+constexpr Track kTracks[] = {
+    {"Glass Joe's theme", "GlassJoe", kExhibition},        {"Von Kaiser's theme", "VonKaiser", kExhibition},
+    {"Disco Kid's theme", "KidQuick", kExhibition},        {"King Hippo's theme", "KingHippo", kExhibition},
+    {"Piston Hondo's theme", "PistonHondo", kExhibition},  {"Bear Hugger's theme", "BearHugger", kExhibition},
+    {"Great Tiger's theme", "GreatTiger", kExhibition},    {"Don Flamenco's theme", "DonFlamenco", kExhibition},
+    {"Aran Ryan's theme", "AranRyan", kExhibition},        {"Soda Popinski's theme", "SodaPopinski", kExhibition},
+    {"Bald Bull's theme", "BaldBull", kExhibition},        {"Super Macho Man's theme", "MachoMan", kExhibition},
+    {"Mr. Sandman's theme", "Sandman", kChampionship},     {"Donkey Kong's theme", "DonkeyKong", kChampionship},
+    {"Minor Circuit", "GlassJoe", kChampionship},          {"Minor Circuit title fight", "KingHippo", kChampionship},
+    {"Major Circuit", "BearHugger", kChampionship},        {"Major Circuit title fight", "DonFlamenco", kChampionship},
+    {"World Circuit", "AranRyan", kChampionship}};
+uint32_t BankEvent(const std::string& key) {
+    for (const Bank& b : kBanks) {
+        if (key == b.key) return b.event;
+    }
+    return 0;
+}
+
+// Outfits: material tables (fight / menu) and the character entry's texture slot, per outfit.
+constexpr uint32_t kFightTables[5] = {0x8032C180u, 0x8032C4B0u, 0x8032C7B0u, 0x8032BB7Cu, 0x8032CAB0u};
+constexpr uint32_t kMenuTables[5] = {0x8032C330u, 0x8032C630u, 0x8032C930u, 0x8032BE70u, 0x8032CC30u};
+constexpr uint32_t kTextureSlots[5] = {0x10u, 0x14u, 0x18u, 0x1Cu, 0x20u};
+// 8001C800 call sites (return addresses) that pick by circuit 0..3 (Minor, Major, World, Evolved slot).
+constexpr uint32_t kFightMaterialReturns[4] = {0x8009BA38u, 0x8009BA50u, 0x8009BA68u, 0x8009BA80u};
+constexpr uint32_t kMenuMaterialReturns[4] = {0x8002D5B4u, 0x8002D5C8u, 0x8002D5DCu, 0x8002D5F4u};
+constexpr uint32_t kMenuMacEntry = 0x8031E9D4u; // the front end's Little Mac (keeps the game's choice per fight)
+
+} // namespace ap_game
+
+bool GameActive() {
+    using namespace ap_game;
+    return g_active.load(std::memory_order_relaxed);
+}
+
+void GameApply(const GameSeedData& seed) {
+    using namespace ap_game;
+    if (Mem() == nullptr) return;
+    g_seed = seed;
+    g_musicMode = 0;
+    W32(kSeedTag, seed.seedTag);
+    W32(kSeedMagic, 0x4150504Fu); // "APPO"
+    for (int i = 0; i < 4; ++i) W32(kSwapDebug + uint32_t(i) * 4, 0);
+    W32(kSwapArmed, 0);
+    for (int i = 0; i < 26; ++i) W8(kSwapTable + uint32_t(i), uint8_t(seed.fighterOrder[i]));
+    W8(kSwapTable + 26, 0);
+    W8(kSwapTable + 27, 0);
+    for (uint32_t a : {kInputMask, kHudFlag, kStarTrapFlag, kSecondChances, kSecondChancesFired, kSuperMacFlag,
+                       kFxState, kFxLastMac, kSuperMacIgnored, kClockTrapFlag, kMacKnockdowns, kMacKnockouts}) {
+        W32(a, 0);
+    }
+    WF(kDamageMultiplier, 1.0f);
+    static const char kTired[16] = "littlemac_tired";
+    for (int i = 0; i < 16; ++i) W8(kTiredEffectName + uint32_t(i), uint8_t(kTired[i]));
+    g_active.store(true, std::memory_order_relaxed);
+    std::fprintf(stderr, "[archipelago] game patch on (seed tag %08X)\n", seed.seedTag);
+}
+
+bool ParseCosmetics(const std::string& text, GameSeedData& seed, std::string& problem) {
+    using namespace ap_game;
+    nlohmann::json c;
+    try {
+        c = nlohmann::json::parse(text);
+    } catch (...) {
+        problem = "cosmetics aren't valid JSON";
+        return false;
+    }
+    if (!c.is_object()) return true;
+    if (c.contains("music") && c["music"].is_object()) {
+        for (auto it = c["music"].begin(); it != c["music"].end(); ++it) {
+            const uint32_t from = BankEvent(it.key());
+            const std::string track = it->is_string() ? it->get<std::string>() : "";
+            const Track* t = nullptr;
+            for (const Track& k : kTracks) {
+                if (track == k.name) t = &k;
+            }
+            if (from == 0 || t == nullptr) {
+                problem = "unknown music entry " + it.key() + " -> " + track;
+                continue;
+            }
+            seed.music.push_back({from, BankEvent(t->bank), t->mode});
+        }
+    }
+    if (c.contains("outfits") && c["outfits"].is_object()) {
+        const auto& o = c["outfits"];
+        const std::string mode = o.value("mode", "");
+        if (mode == "per_circuit" && o.contains("circuits") && o["circuits"].is_array() && o["circuits"].size() == 4) {
+            seed.outfitMode = 1;
+            for (int i = 0; i < 4; ++i) seed.circuitOutfits[i] = static_cast<uint8_t>(std::min(4, std::max(0, o["circuits"][i].get<int>())));
+        } else if (mode == "per_fight" && o.contains("boxers") && o["boxers"].is_array() && o["boxers"].size() == 32) {
+            seed.outfitMode = 2;
+            for (int i = 0; i < 32; ++i) seed.boxerOutfits[i] = static_cast<uint8_t>(std::min(4, std::max(0, o["boxers"][i].get<int>())));
+        } else if (!mode.empty()) {
+            problem = "unknown outfit mode " + mode;
+        }
+    }
+    return true;
+}
+
+void GameRelease() {
+    using namespace ap_game;
+    if (!g_active.exchange(false)) return;
+    for (uint32_t a : {kInputMask, kSecondChances, kSuperMacFlag, kClockTrapFlag}) W32(a, 0);
+    WF(kDamageMultiplier, 1.0f);
+    std::fprintf(stderr, "[archipelago] game patch off\n");
+}
