diff --git a/runtime/include/guest_abi/guest_region.h b/runtime/include/guest_abi/guest_region.h
index 1836717..32ddc4e 100644
--- a/runtime/include/guest_abi/guest_region.h
+++ b/runtime/include/guest_abi/guest_region.h
@@ -19,8 +19,18 @@ enum class Id : uint8_t {
     Pal = 0,
     NtscU = 1,
     NtscJ = 2,
+    // Punch-Out!! (R7PE01). Not a Mario Kart release: it only has counterparts for the SDK
+    // functions and data the runtime names, so an address without a row is "absent"
+    // (kAbsentBase | low bits) instead of a compile error.
+    PunchOut = 3,
 };
-inline constexpr size_t kCount = 3;
