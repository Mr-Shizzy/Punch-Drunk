+// ---- round clock ----
+std::optional<float> ReadRoundTime() {
+    const uint32_t f = FindFight(), mac = FindMac();
+    if (!f || !mac || (R32(f + 4) != mac && R32(f + 8) != mac)) return std::nullopt;
+    const float t = RF(f + 0x8C);
+    if (Bad(t) || t < -1 || t > 1000) return std::nullopt;
+    return std::max(t, 0.0f);
+}
+void UpdateRoundClock(bool inFight, double now) {
+    g.roundRestarted = false;
+    const auto t = inFight ? ReadRoundTime() : std::nullopt;
+    if (!t) {
+        g.roundClockMoving = inFight ? -1 : 0;
+        g.lastRoundTime.reset();
+        return;
+    }
+    // Compared over at least 0.1 s (client.py's tick), so the game's slow-motion moments don't read as "stopped".
+    if (g.lastRoundTime && *t > *g.lastRoundTime + 1.0f) g.roundRestarted = true;
+    if (!g.lastRoundTime || g.roundRestarted || now - g.roundClockAt >= 0.1) {
+        g.roundClockMoving = g.lastRoundTime && !g.roundRestarted && *t < *g.lastRoundTime - 1e-5f ? 1 : 0;
+        g.lastRoundTime = t;
+        g.roundClockAt = now;
+    }
+}
+bool RoundPlayable(double now) {
+    if (g.roundClockMoving >= 0) return g.roundClockMoving == 1;
+    return g.fightLoadedAt && now - *g.fightLoadedAt >= g.heartTrapStartDelay;
+}
+bool SuperMacOn() {
+    return g.superMacSecondsLeft > 0;
+}
