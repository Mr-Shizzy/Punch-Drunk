+// ---- 1. Fight per-frame update (PO 80096808, r3 = Fight, f1 = frame time; pseudo PAL 80FF0048) ----
+// Before the update: the death-link mailboxes (Mac's health -1.0 -> knockdown 80097A00, hearts -1.0 -> tired
+// 8000AC54), the health bar refresh flag (8003B080 with the meter's fraction), the Star Trap flag (800F933C).
+// Clock Trap (dol_patch hooks the clock subtraction inside this function): while the flag is set, the clock goes
+// down a second time by what this update took off.
+extern "C" void PunchOut_FightUpdate_pseudo(CpuContext* ctx) {
+    const uint32_t fight = ctx->gpr[3];
+    if (!GameActive() || !Ptr(fight)) {
+        MKW_GUEST_FUNC(80FF0048)(ctx);
+        return;
+    }
+    const SavedRegs saved = Save(ctx);
+    const uint32_t mac = R32(fight + 4);
+    if (Ptr(mac)) {
+        const uint32_t star = R32(mac + 0xCC);
+        if (Ptr(star)) {
+            if (R32(star - 0x48) == 0xBF800000u) { // health == -1.0
+                W32(star - 0x48, 0);
+                W32(mac + 0x20C, 22); // "how he was hit": normal knockdown
+                ctx->gpr[3] = fight;
+                ctx->gpr[4] = mac;
+                ctx->gpr[5] = R32(mac + 0xD0);
+                InvokeIndirectCpu(0x80097A00u, ctx);
+            } else if (R32(star - 0x18) == 0xBF800000u) { // hearts == -1.0
+                W32(star - 0x18, 0);
+                ctx->gpr[3] = mac;
+                InvokeIndirectCpu(0x8000AC54u, ctx);
+            }
+        }
+    }
+    if (const uint32_t which = R32(kHudFlag); which != 0) {
+        W32(kHudFlag, 0);
+        const uint32_t boxer = which <= 2 ? R32(fight + which * 4) : 0;
+        const uint32_t meter = Ptr(boxer) ? R32(boxer + 0xC4) : 0;
+        if (Ptr(meter) && RF(meter + 0x0C) != 0.0f) {
+            ctx->gpr[3] = R32(0x80412BD8u);
+            ctx->gpr[4] = boxer;
+            ctx->fpr[1].d = static_cast<double>(RF(meter + 0x10) / RF(meter + 0x0C));
+            InvokeIndirectCpu(0x8003B080u, ctx);
+        }
+    }
+    if (R32(kStarTrapFlag) != 0) {
+        W32(kStarTrapFlag, 0);
+        const uint32_t m = R32(fight + 4);
+        if (Ptr(m) && R32(m + 0xCC) != 0) {
+            ctx->gpr[3] = m;
+            InvokeIndirectCpu(0x800F933Cu, ctx);
+        }
+    }
+    Restore(ctx, saved);
+    const float clockBefore = RF(fight + 0x8C);
+    MKW_GUEST_FUNC(80FF0048)(ctx);
+    if (R32(kClockTrapFlag) != 0) {
+        const float clockAfter = RF(fight + 0x8C);
+        const float took = clockBefore - clockAfter;
+        if (clockAfter > 0.0f && took > 0.0f && took < 1.0f) WF(fight + 0x8C, std::max(0.0f, clockAfter - took));
+    }
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0048, PunchOut_FightUpdate_pseudo, "PunchOut_FightUpdate_pseudo");
+
+// ---- 2. Fighter swap: scene change (PO 800D9C40, r3 = scene; pseudo PAL 80FF004C) ----
+// The first scene change after a career pick swaps the opponent's name (state+0x10) through the seed's table.
+extern "C" void PunchOut_SceneChange_pseudo(CpuContext* ctx) {
+    const uint32_t state = R32(kGameStatePointer);
+    if (GameActive() && Ptr(state)) {
+        W32(kSwapDebug + 0xC, ctx->gpr[3]);
+        W32(kSwapDebug + 4, R32(kSwapDebug + 4) + 1);
+        if (R8(kSwapArmed) != 0) {
+            W8(kSwapArmed, 0);
+            const SavedRegs saved = Save(ctx);
+            ctx->gpr[3] = state + 0x10;
+            InvokeIndirectCpu(0x800A7BF8u, ctx); // name -> id
+            const uint32_t id = ctx->gpr[3];
+            if (id < 26) {
+                const uint32_t to = R8(kSwapTable + id);
+                if (to != id) {
+                    ctx->gpr[3] = to;
+                    ctx->lr = 0; // not a name-copy site
+                    InvokeIndirectCpu(0x800A7B28u, ctx); // id -> name
+                    const uint32_t name = ctx->gpr[3];
+                    for (uint32_t i = 0; i < 15 && Ptr(name & ~3u); ++i) {
+                        const uint8_t c = R8(name + i);
+                        W8(state + 0x10 + i, c);
+                        if (c == 0) break;
+                    }
+                    std::fprintf(stderr, "[archipelago] fighter swap: career slot %u -> boxer %u\n", id, to);
+                }
+            }
+            Restore(ctx, saved);
+        }
+    }
+    MKW_GUEST_FUNC(80FF004C)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF004C, PunchOut_SceneChange_pseudo, "PunchOut_SceneChange_pseudo");
+
+// Boxer id -> name (PO 800A7B28; pseudo PAL 80FF0050): at the name-copy call sites, arm / disarm the swap.
+extern "C" void PunchOut_IdToName_pseudo(CpuContext* ctx) {
+    if (GameActive()) {
+        const uint32_t site = ctx->lr - 4;
+        bool arm = false, known = false;
+        for (uint32_t s : kArmSites) {
+            if (s == site) arm = known = true;
+        }
+        for (uint32_t s : kDisarmSites) {
+            if (s == site) known = true;
+        }
+        if (known) {
+            const uint32_t state = R32(kGameStatePointer);
+            const uint32_t mode = Ptr(state) ? R32(state + 4) : 0;
+            W32(kSwapDebug, mode);
+            W32(kSwapDebug + 8, ctx->lr);
+            W8(kSwapArmed, arm && mode == 1 ? 1 : 0);
+        }
+    }
+    MKW_GUEST_FUNC(80FF0050)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0050, PunchOut_IdToName_pseudo, "PunchOut_IdToName_pseudo");
+
+// ---- 4. Move blocking: the three control schemes return Mac's move command (r3) ----
+// 800ED9F0 also stores it at [this + 0x15E8] (pseudo PAL 80FF0054); 800EDFF4 (80FF0058) and 800EE698 (80FF005C)
+// only return it.
+extern "C" void PunchOut_ControlScheme1_pseudo(CpuContext* ctx) {
+    const uint32_t self = ctx->gpr[3];
+    MKW_GUEST_FUNC(80FF0054)(ctx);
+    if (GameActive()) {
+        ctx->gpr[3] = MaskMoves(ctx->gpr[3]);
+        if (Ptr(self)) W32(self + 0x15E8, ctx->gpr[3]);
+    }
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0054, PunchOut_ControlScheme1_pseudo, "PunchOut_ControlScheme1_pseudo");
+extern "C" void PunchOut_ControlScheme2_pseudo(CpuContext* ctx) {
+    MKW_GUEST_FUNC(80FF0058)(ctx);
+    if (GameActive()) ctx->gpr[3] = MaskMoves(ctx->gpr[3]);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0058, PunchOut_ControlScheme2_pseudo, "PunchOut_ControlScheme2_pseudo");
+extern "C" void PunchOut_ControlScheme3_pseudo(CpuContext* ctx) {
+    MKW_GUEST_FUNC(80FF005C)(ctx);
+    if (GameActive()) ctx->gpr[3] = MaskMoves(ctx->gpr[3]);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF005C, PunchOut_ControlScheme3_pseudo, "PunchOut_ControlScheme3_pseudo");
+
+// ---- 5. Second Chance and Mac's knockdown / knockout counters ----
+// The knockdown handler (8000A714, r30 = the boxer going down) asks the boxer's script two things through
+// 80161E2C (the answer is left on the script stack): at 8000A774 "second chance?" (yes -> the stagger-and-mash
+// path 8000A794), then at 8000A890 "knockout?" (KnockOut 8000A8B0, else KnockDown 8000A8E0). dol_patch jumps from the
+// knockout test to the second-chance path when Mac has a Second Chance. Here: when Mac's own roll said no and he has
+// one, the knockout question is asked right away; if the answer is "knockout", the second-chance answer is turned
+// into "yes" (the game then takes its own second-chance path and never asks the knockout question).
+// The counters count the knockout question's answers for Mac (a saved knockdown counts as neither).
+// Script call: PO 80161E2C, pseudo PAL 80FF0060.
+namespace {
+constexpr uint32_t kSecondChanceQueryReturn = 0x8000A778u, kKnockoutQueryReturn = 0x8000A894u;
+
+// The knockout question, the way 8000A850..8000A8A4 asks it. Returns true for "knockout".
+bool AskKnockout(CpuContext* ctx, uint32_t boxer) {
+    const uint32_t info = R32(boxer + 0xB4);
+    if (!Ptr(info) || R32(info + 0x6C) == 0) return false;
+    const uint32_t owner = R32(boxer + 0xB0);
+    const uint32_t ctrl = Ptr(owner) ? R32(owner + 0x10) : 0;
+    const uint32_t script = Ptr(ctrl) ? R32(ctrl + 0x18) : 0;
+    if (!Ptr(script)) return false;
+    const uint32_t sp = R32(script + 4);
+    if (!Ptr(sp)) return false;
+    W32(sp, boxer);
+    W32(script + 4, sp + 4);
+    ctx->gpr[3] = script;
+    ctx->gpr[4] = R32(info + 0x68);
+    ctx->gpr[5] = R32(info + 0x6C);
+    ctx->lr = 0;
+    InvokeIndirectCpu(0x80161E2Cu, ctx);
+    return R32(R32(script + 4)) != 0;
+}
+} // namespace
+
+extern "C" void PunchOut_ScriptCall_pseudo(CpuContext* ctx) {
+    const uint32_t ret = ctx->lr;
+    if (!GameActive() || (ret != kSecondChanceQueryReturn && ret != kKnockoutQueryReturn)) {
+        MKW_GUEST_FUNC(80FF0060)(ctx);
+        return;
+    }
+    const uint32_t boxer = ctx->gpr[30]; // the knockdown handler's boxer (callee-saved)
+    const uint32_t script = ctx->gpr[3];
+    MKW_GUEST_FUNC(80FF0060)(ctx);
+    if (boxer == 0 || boxer != Mac() || !Ptr(script)) return;
+    const uint32_t answerAt = R32(script + 4);
+    if (ret == kKnockoutQueryReturn) {
+        const bool knockout = R32(answerAt) != 0;
+        W32(knockout ? kMacKnockouts : kMacKnockdowns, R32(knockout ? kMacKnockouts : kMacKnockdowns) + 1);
+        return;
+    }
+    // Mac's second-chance roll.
+    const int32_t chances = static_cast<int32_t>(R32(kSecondChances));
+    if (R32(answerAt) != 0 || chances <= 0) return;
+    const SavedRegs saved = Save(ctx);
+    const uint32_t r29 = ctx->gpr[29], r30 = ctx->gpr[30], r31 = ctx->gpr[31];
+    const bool knockout = AskKnockout(ctx, boxer);
+    Restore(ctx, saved);
+    ctx->gpr[29] = r29;
+    ctx->gpr[30] = r30;
+    ctx->gpr[31] = r31;
+    if (!knockout) return;
+    W32(answerAt, 1);
+    W32(kSecondChances, static_cast<uint32_t>(chances - 1));
+    W32(kSecondChancesFired, R32(kSecondChancesFired) + 1);
+    std::fprintf(stderr, "[archipelago] Second Chance used\n");
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0060, PunchOut_ScriptCall_pseudo, "PunchOut_ScriptCall_pseudo");
+
+// ---- 7. Super Mac: a hit's reaction step (PO 80014DE4, r3 = the hit, defender at hit+0x28; pseudo PAL 80FF0064)
+// returns 1 ("ignore this hit") for hits on Mac while Super Mac runs.
+extern "C" void PunchOut_HitReaction_pseudo(CpuContext* ctx) {
+    if (GameActive() && R32(kSuperMacFlag) != 0) {
+        const uint32_t hit = ctx->gpr[3];
+        const uint32_t mac = Mac();
+        if (Ptr(hit) && mac != 0 && R32(hit + 0x28) == mac) {
+            W32(kSuperMacIgnored, R32(kSuperMacIgnored) + 1);
+            ctx->gpr[3] = 1;
+            return;
+        }
+    }
+    MKW_GUEST_FUNC(80FF0064)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0064, PunchOut_HitReaction_pseudo, "PunchOut_HitReaction_pseudo");
+
+// ---- 8. Super Mac's tired effect: boxer update (PO 80009C20, r3 = boxer; pseudo PAL 80FF0068) plays / stops
+// "littlemac_tired" on Mac (8000BDC8 / 8000BF30) when the flag changes.
+extern "C" void PunchOut_BoxerUpdate_pseudo(CpuContext* ctx) {
+    const uint32_t boxer = ctx->gpr[3];
+    if (GameActive() && boxer != 0 && boxer == Mac()) {
+        if (R32(kFxLastMac) != boxer) {
+            W32(kFxLastMac, boxer);
+            W32(kFxState, 0);
+        }
+        const uint32_t want = R32(kSuperMacFlag) != 0 ? 1u : 0u;
+        if (want != R32(kFxState)) {
+            W32(kFxState, want);
+            const SavedRegs saved = Save(ctx);
+            ctx->gpr[3] = boxer;
+            ctx->gpr[4] = kTiredEffectName;
+            ctx->gpr[5] = want ? 1u : 0u;
+            InvokeIndirectCpu(want ? 0x8000BDC8u : 0x8000BF30u, ctx);
+            Restore(ctx, saved);
+        }
+    }
+    MKW_GUEST_FUNC(80FF0068)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0068, PunchOut_BoxerUpdate_pseudo, "PunchOut_BoxerUpdate_pseudo");
+
+// ---- 9. Super Mac's tint: draw settings (PO 800B7BCC, r3 -> boxer pointer, r4 = settings; pseudo PAL 80FF006C):
+// settings+0x1D ("tired": the tint colour at 804153A4, which the client turns into a rainbow) for Mac.
+extern "C" void PunchOut_DrawSettings_pseudo(CpuContext* ctx) {
+    const uint32_t holder = ctx->gpr[3], settings = ctx->gpr[4];
+    MKW_GUEST_FUNC(80FF006C)(ctx);
+    if (GameActive() && R32(kSuperMacFlag) != 0 && Ptr(holder) && Ptr(settings)) {
+        const uint32_t mac = Mac();
+        if (mac != 0 && R32(holder) == mac) W8(settings + 0x1D, 1);
+    }
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF006C, PunchOut_DrawSettings_pseudo, "PunchOut_DrawSettings_pseudo");
+
+// ---- 10. Damage multiplier: ChangeHealth (PO 800F8FF4, r3 = boxer, f1 = health change, f2 = ceiling change;
+// pseudo PAL 80FF0070). Damage to anyone but Mac is multiplied (doubled again during Super Mac).
+extern "C" void PunchOut_ChangeHealth_pseudo(CpuContext* ctx) {
+    if (GameActive()) {
+        const uint32_t fight = Fight();
+        if (fight != 0 && R32(fight + 4) != ctx->gpr[3]) {
+            float m = RF(kDamageMultiplier);
+            if (R32(kSuperMacFlag) != 0) m = m + m;
+            for (int r : {1, 2}) {
+                const float v = static_cast<float>(ctx->fpr[r].d);
+                if (v < 0.0f) ctx->fpr[r].d = static_cast<double>(v * m);
+            }
+        }
+    }
+    MKW_GUEST_FUNC(80FF0070)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0070, PunchOut_ChangeHealth_pseudo, "PunchOut_ChangeHealth_pseudo");
+
+// ---- 6. Sandman's intro in any circuit: 800DBDAC asks "World Circuit?" through 800A298C (== 4) before checking for
+// Sandman; dol_patch drops that test. Circuit query PO 800A298C, pseudo PAL 80FF0074: from there, answer 4.
+extern "C" void PunchOut_CircuitQuery_pseudo(CpuContext* ctx) {
+    const bool sandmanCheck = GameActive() && ctx->lr == 0x800DBDC4u;
+    MKW_GUEST_FUNC(80FF0074)(ctx);
+    if (sandmanCheck) ctx->gpr[3] = 4;
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0074, PunchOut_CircuitQuery_pseudo, "PunchOut_CircuitQuery_pseudo");
+
+// ---- 12. Music shuffle ----
+// Every sound event goes through PostEvent (PO 802CF200, wrapped in punchout_audio_trace.cpp, which asks here first):
+// a fighter's in-game theme becomes the seed's track for him, and its GameMode state is kept for the round start.
+extern "C" uint32_t PunchOut_ApMusicEvent(uint32_t event) {
+    if (!GameActive() || g_seed.music.empty()) return event;
+    for (const auto& row : g_seed.music) {
+        if (row.from == event) {
+            g_musicMode = row.mode;
+            return row.to;
+        }
+    }
+    return event;
+}
+// SetState(group, state) (PO 800E64A4, pseudo PAL 80FF0078): the round start sets GameMode to Championship or
+// Exhibition (calls returning to 8009C9A8 / 8009C9C0 / 8009CA10); with a shuffled theme, its own mode instead (the
+// track plays in the mode it was made for).
+extern "C" void PunchOut_SetGameMode_pseudo(CpuContext* ctx) {
+    const uint32_t ret = ctx->lr;
+    if (GameActive() && g_musicMode != 0 && (ret == 0x8009C9A8u || ret == 0x8009C9C0u || ret == 0x8009CA10u)) {
+        ctx->gpr[4] = g_musicMode;
+    }
+    MKW_GUEST_FUNC(80FF0078)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0078, PunchOut_SetGameMode_pseudo, "PunchOut_SetGameMode_pseudo");
+
+// ---- 13. Little Mac's outfits ----
+namespace {
+// Outfit for this fight (per fight: by the opponent, after the swap).
+int FightOutfit(CpuContext* ctx) {
+    const uint32_t state = R32(kGameStatePointer);
+    if (!Ptr(state)) return -1;
+    const SavedRegs saved = Save(ctx);
+    ctx->gpr[3] = state + 0x10;
+    InvokeIndirectCpu(0x800A7BF8u, ctx); // name -> id
+    const uint32_t id = ctx->gpr[3] & 31u;
+    Restore(ctx, saved);
+    return g_seed.boxerOutfits[id];
+}
+} // namespace
+
+// ApplyMaterials(model, table, 0) (PO 8001C800, pseudo PAL 80FF007C): at the fight's and the menu's per-circuit
+// calls, the seed's outfit's table instead.
+extern "C" void PunchOut_ApplyMaterials_pseudo(CpuContext* ctx) {
+    if (GameActive() && g_seed.outfitMode != 0) {
+        const uint32_t ret = ctx->lr;
+        for (int c = 0; c < 4; ++c) {
+            if (ret == kFightMaterialReturns[c]) {
+                const int o = g_seed.outfitMode == 1 ? g_seed.circuitOutfits[c] : FightOutfit(ctx);
+                if (o >= 0) ctx->gpr[4] = kFightTables[o];
+            } else if (ret == kMenuMaterialReturns[c] && g_seed.outfitMode == 1) {
+                ctx->gpr[4] = kMenuTables[g_seed.circuitOutfits[c]];
+            }
+        }
+    }
+    MKW_GUEST_FUNC(80FF007C)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF007C, PunchOut_ApplyMaterials_pseudo, "PunchOut_ApplyMaterials_pseudo");
+
+// A character entry's texture by circuit (PO 8001D8BC, r3 = entry; pseudo PAL 80FF0080): game mode 3/5/6 always takes
+// the Alternate slot (+0x1C); otherwise circuit (state+0x110) 0/1/2/other -> +0x10/+0x14/+0x18/+0x20. The seed's
+// outfit's slot instead.
+extern "C" void PunchOut_OutfitTexture_pseudo(CpuContext* ctx) {
+    const uint32_t entry = ctx->gpr[3];
+    MKW_GUEST_FUNC(80FF0080)(ctx);
+    if (!GameActive() || g_seed.outfitMode == 0 || !Ptr(entry)) return;
+    const uint32_t state = R32(kGameStatePointer);
+    if (!Ptr(state)) return;
+    const uint32_t mode = R32(state + 4);
+    if (mode == 3 || mode == 5 || mode == 6) return;
+    const uint32_t circuit = R32(state + 0x110);
+    const int c = circuit <= 2 ? static_cast<int>(circuit) : 3;
+    int o = -1;
+    if (g_seed.outfitMode == 1) o = g_seed.circuitOutfits[c];
+    else if (entry != kMenuMacEntry) o = FightOutfit(ctx);
+    if (o >= 0) ctx->gpr[3] = R32(entry + kTextureSlots[o]);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0080, PunchOut_OutfitTexture_pseudo, "PunchOut_OutfitTexture_pseudo");
+
+} // namespace PunchOutAp::ap_game
