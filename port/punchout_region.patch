+
+extern "C" bool PAD_HLE_RumbleEnabled();
+
+// Controller menu navigation (hle/punchout_menu.cpp): on menu screens it decides the remote's buttons and
+// may move the pointer onto a button.
+extern "C" bool PunchOut_MenuActive();
+extern "C" uint16_t PunchOut_MenuRemoteButtons();
+extern "C" uint32_t PunchOut_MenuWarp(float* x, float* y);
+extern "C" bool PunchOut_MovieA();
+
+namespace Wiimote {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+using Report = std::vector<uint8_t>;
+
+constexpr size_t kEmulatedSlot = 0;
+constexpr auto kReportInterval = std::chrono::milliseconds(10); // a real remote streams at ~100 Hz
+constexpr size_t kReplyLimit = 64;
+
+// Core button bits, as the remote sends them (two bytes, first byte high).
+constexpr uint16_t kLeft = 0x0100, kRight = 0x0200, kDown = 0x0400, kUp = 0x0800, kPlus = 0x1000;
+constexpr uint16_t kTwo = 0x0001, kOne = 0x0002, kB = 0x0004, kA = 0x0008, kMinus = 0x0010;
+
+// Accelerometer at rest, lying flat (upper 8 of 10 bits): 0 g on X and Y, +1 g on Z.
+constexpr uint8_t kAccelZero = 0x80;
+constexpr uint8_t kAccelOneG = 0x9A;
+
+// EEPROM 0x0000-0x0029: IR camera calibration (two copies), then accelerometer calibration (two
+// copies, checksum = sum of the nine bytes + 0x55). Values as Dolphin's emulated remote uses.
+constexpr std::array<uint8_t, 0x2A> kEepromCalibration = {
+    0xA1, 0xAA, 0x8B, 0x99, 0xAE, 0x9E, 0x78, 0x30, 0xA7, 0x74, 0xD3,
+    0xA1, 0xAA, 0x8B, 0x99, 0xAE, 0x9E, 0x78, 0x30, 0xA7, 0x74, 0xD3,
+    kAccelZero, kAccelZero, kAccelZero, 0x00, kAccelOneG, kAccelOneG, kAccelOneG, 0x00, 0x00, 0xA3,
+    kAccelZero, kAccelZero, kAccelZero, 0x00, kAccelOneG, kAccelOneG, kAccelOneG, 0x00, 0x00, 0xA3,
+};
+constexpr uint32_t kEepromSize = 0x1700;
+
+constexpr uint8_t kErrorNone = 0x00;
+constexpr uint8_t kErrorNoDevice = 0x07;
+constexpr uint8_t kErrorBadAddress = 0x08;
+
+// Pointer (IR camera) emulation, after Dolphin's original emulated remote: the pointer position
+// (-1..1, +x right, +y down) becomes two sensor-bar dots in the 1024x768 camera image.
+constexpr int kCameraWidth = 1024;
+constexpr int kCameraHeight = 768;
+constexpr double kBoundUp = -0.315447, kBoundDown = 0.85, kBoundLeft = 0.443364, kBoundRight = -0.443364;
+constexpr double kDotHalfSpacing = 100.0 / kCameraWidth;
+constexpr uint8_t kDotSize = 3;
+constexpr float kStickDeadzone = 0.15f;
+constexpr float kPointerSpeed = 1.4f; // screen half-widths per second at full right-stick deflection
+
+struct IrDot {
+    int x = 0x3FF;
+    int y = 0x3FF;
+    bool visible = false;
+};
+
+std::array<IrDot, 2> IrDotsFor(float px, float py) {
+    const double up = -py; // the bounds below are written with up positive
+    const double vx = px * (kBoundRight - kBoundLeft) / 2 + (kBoundLeft + kBoundRight) / 2;
+    const double vy = RuntimeConfigFile::WiiSensorBarAbove()
+                          ? up * (kBoundUp - kBoundDown) / 2 + (kBoundUp + kBoundDown) / 2
+                          : up * (kBoundUp - kBoundDown) / 2 - (kBoundUp + kBoundDown) / 2;
+    std::array<IrDot, 2> dots;
+    for (int i = 0; i < 2; ++i) {
+        const double x = vx + (i == 0 ? -kDotHalfSpacing : kDotHalfSpacing);
+        if (x < -1 || x > 1 || vy < -1 || vy > 1) continue;
+        dots[i].x = static_cast<int>(std::lround((x + 1) / 2 * (kCameraWidth - 1)));
+        dots[i].y = static_cast<int>(std::lround((vy + 1) / 2 * (kCameraHeight - 1)));
+        dots[i].visible = true;
+    }
+    return dots;
+}
+
+SDL_Gamepad* FindGamepad() {
+    for (u32 port = 0; port < PAD_CHANMAX; ++port) {
+        const s32 index = PADGetIndexForPort(port);
+        if (index >= 0) {
+            if (SDL_Gamepad* gamepad = PADGetSDLGamepadForIndex(static_cast<u32>(index))) {
+                return gamepad;
+            }
+        }
+    }
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    SDL_Gamepad* found = nullptr;
+    for (int i = 0; ids != nullptr && i < count && found == nullptr; ++i) {
+        found = SDL_GetGamepadFromID(ids[i]);
+    }
+    SDL_free(ids);
+    return found;
+}
+
+// Last pointer position sent to the game ([-1, 1], y down), and the last menu jump applied to it.
+std::atomic<float> g_pointerX{0.f};
+std::atomic<float> g_pointerY{0.f};
+std::atomic<uint32_t> g_appliedWarp{0};
+std::atomic<bool> g_remoteReady{false};
+std::atomic<int> g_lastInputDevice{0};        // 0 nothing pressed yet, 1 keyboard (or mouse buttons), 2 gamepad
+std::atomic<uint32_t> g_userPointerMoves{0}; // right stick or mouse moved the pointer (shows the glove again)
+
+// The remote's buttons from the keyboard, the mouse buttons and the gamepad (nullptr: keyboard and mouse only),
+// through the Punch-Out!! control bindings (punchout_controls.cpp). The left stick always works as the D-pad.
+uint16_t ReadButtons(SDL_Gamepad* gamepad) {
+    if (InputBindings::InputBlocked()) {
+        return 0;
+    }
+    using namespace PunchOutControls;
+    std::array<bool, kControlCount> keyHeld{}, padHeld{};
+    bool anyKey = false, anyPad = false;
+    for (size_t c = 0; c < kControlCount; ++c) {
+        keyHeld[c] = KeyHeld(c);
+        padHeld[c] = PadHeld(c, gamepad);
+        anyKey |= keyHeld[c];
+        anyPad |= padHeld[c];
+    }
+    const auto on = [&](size_t control) { return keyHeld[control] || padHeld[control]; };
+    const auto axis = [gamepad](SDL_GamepadAxis a) {
+        return gamepad != nullptr ? static_cast<int>(SDL_GetGamepadAxis(gamepad, a)) : 0;
+    };
+    constexpr int kStick = 16384;  // half deflection
+    anyPad |= std::abs(axis(SDL_GAMEPAD_AXIS_LEFTX)) > kStick || std::abs(axis(SDL_GAMEPAD_AXIS_LEFTY)) > kStick;
+    // The in-game prompts show whatever was used last (punchout_prompts.cpp).
+    if (anyKey != anyPad) g_lastInputDevice.store(anyKey ? 1 : 2, std::memory_order_relaxed);
+
+    const bool up = on(Up) || axis(SDL_GAMEPAD_AXIS_LEFTY) < -kStick;
+    const bool down = on(Down) || axis(SDL_GAMEPAD_AXIS_LEFTY) > kStick;
+    const bool left = on(Left) || axis(SDL_GAMEPAD_AXIS_LEFTX) < -kStick;
+    const bool right = on(Right) || axis(SDL_GAMEPAD_AXIS_LEFTX) > kStick;
+
+    uint16_t buttons = 0;
+    // Held sideways with the D-pad on the left, the remote's Up arrow points at the screen's left.
+    if (up) buttons |= kRight;
+    if (down) buttons |= kLeft;
+    if (left) buttons |= kUp;
+    if (right) buttons |= kDown;
+    if (on(One)) buttons |= kOne;
+    if (on(Two)) buttons |= kTwo;
+    if (on(B)) buttons |= kB;
+    if (on(PunchOutControls::A)) buttons |= kA;
+    if (on(Plus)) buttons |= kPlus;
+    if (on(Minus)) buttons |= kMinus;
+    // No HOME: there is no Wii menu to go back to.
+    return buttons;
+}
+
+class EmulatedRemote {
+public:
+    EmulatedRemote() { ResetLocked(); }
+
+    // The keyboard is always there, so the remote is too: a gamepad is optional.
+    bool IsAttached() const { return true; }
+
+    bool ConsumeWake() {
+        if (m_wake.exchange(false)) return true;
+        // After the game let the remote go, any button (key or gamepad) connects it again, like a real one.
+        if (m_ready.load() || !m_released.load()) return false;
+        if (ReadButtons(FindGamepad()) != 0) {
+            m_released = false;
+            return true;
+        }
+        return false;
+    }
+
+    void OnLinkStateChanged(Bluetooth::LinkState state) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (state == Bluetooth::LinkState::Ready) {
+            ResetLocked();
+            m_ready = true;
+            g_remoteReady = true;
+            RT_LOG(RT_TAG_HLE) << "Emulated Wii Remote (sideways, gamepad) connected to the game" << std::endl;
+        } else if (state == Bluetooth::LinkState::Down) {
+            g_remoteReady = false;
+            if (m_ready.exchange(false)) {
+                RT_LOG(RT_TAG_HLE) << "Emulated Wii Remote: link down" << std::endl;
+                m_wake = true;
+            }
+            StopRumbleLocked();
+        }
+    }
+
+    void OnGuestDisconnect() {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_ready = false;
+        g_remoteReady = false;
+        m_released = true;
+        StopRumbleLocked();
+        RT_LOG(RT_TAG_HLE) << "Emulated Wii Remote: disconnected by the game (press a button to reconnect)" << std::endl;
+    }
+
+    bool PopInputReport(Report& report) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (!m_replies.empty()) {
+            report = std::move(m_replies.front());
+            m_replies.pop_front();
+            return true;
+        }
+        if (!m_ready) return false;
+        SDL_Gamepad* gamepad = FindGamepad();
+        const auto now = Clock::now();
+        const bool pointerMoved = UpdatePointerLocked(gamepad, now);
+        uint16_t buttons = ReadButtons(gamepad);
+        const bool menu = PunchOut_MenuActive();
+        if (menu) {
+            // Menus: A/B/X/Y/D-pad belong to the menu navigation; + and - stay.
+            buttons = (buttons & (kPlus | kMinus)) | PunchOut_MenuRemoteButtons();
+        } else {
+            // Leaving a menu (e.g. B / Resume on the pause menu) with a button still held: that button does nothing
+            // until it is let go, so it cannot throw a punch the moment the fight comes back.
+            constexpr uint16_t kFight = kOne | kTwo | kA | kB;
+            if (m_wasMenu) m_swallowed = buttons & kFight;
+            m_swallowed &= buttons;
+            buttons &= static_cast<uint16_t>(~m_swallowed);
+            if (PunchOut_MovieA() && (buttons & kOne)) {
+                buttons |= kA; // cutscenes and loading prompts want the remote's A
+            }
+        }
+        m_wasMenu = menu;
+        // The mouse buttons are A and B where the pointer is in use (menus, prompts), not in a fight, so a click
+        // never throws a star punch. (Mouse buttons bound in [punchout_controls] work everywhere.)
+        if (menu || IrMode() || PunchOut_MovieA()) {
+            if (m_mouseClick) buttons |= kA;
+            if (m_mouseRightClick) buttons |= kB;
+        }
+        const bool changed = buttons != m_lastButtons;
+        const bool streaming = m_continuous || m_mode != 0x30;
+        if (!changed && !(streaming && now - m_lastReport >= kReportInterval) &&
+            !(pointerMoved && IrMode())) {
+            return false;
+        }
+        if (changed && m_buttonLogs < 40) {
+            ++m_buttonLogs;
+            RT_LOG(RT_TAG_HLE) << "Emulated Wii Remote buttons 0x" << std::hex << std::setw(4) << std::setfill('0')
+                               << buttons << std::dec << std::setfill(' ') << std::endl;
+        }
+        m_lastButtons = buttons;
+        m_lastReport = now;
+        report = DataReportLocked(buttons);
+        return true;
+    }
+
+    void SendOutputReport(const uint8_t* data, size_t size) {
+        if (size == 0) return;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        LogOutput(data, size);
+        const uint8_t id = data[0];
+        const uint8_t flags = size >= 2 ? data[1] : 0;
+        if (size >= 2 && id != 0x18) {
+            SetRumbleLocked((flags & 0x01) != 0);
+        }
+        const bool ack = (flags & 0x02) != 0;
+        switch (id) {
+        case 0x10: // rumble
+            break;
+        case 0x11: // LEDs
+            m_leds = flags & 0xF0;
+            if (ack) AckLocked(id, kErrorNone);
+            break;
+        case 0x12: // data reporting mode
+            if (size >= 3) {
+                m_continuous = (flags & 0x04) != 0;
+                m_mode = data[2];
+                m_lastReport = {};
+                m_lastButtons = 0xFFFF; // send one report in the new mode right away
+            }
+            if (ack) AckLocked(id, kErrorNone);
+            break;
+        case 0x13: // IR camera pixel clock
+        case 0x1A: // IR camera logic
+            m_irEnabled = (flags & 0x04) != 0;
+            if (ack) AckLocked(id, kErrorNone);
+            break;
+        case 0x14: // speaker enable
+            m_speakerEnabled = (flags & 0x04) != 0;
+            if (ack) AckLocked(id, kErrorNone);
+            break;
+        case 0x19: // speaker mute
+            if (ack) AckLocked(id, kErrorNone);
+            break;
+        case 0x15: // status request
+            PushLocked(StatusReportLocked());
+            break;
+        case 0x16: // write memory or registers
+            WriteMemoryLocked(data, size);
+            break;
+        case 0x17: // read memory or registers
+            ReadMemoryLocked(data, size);
+            break;
+        case 0x18: // speaker data
+        default:
+            break;
+        }
+    }
+
+private:
+    bool IrMode() const {
+        return m_irEnabled && (m_mode == 0x33 || m_mode == 0x36 || m_mode == 0x37);
+    }
+
+    // Right stick moves the pointer; the PC mouse over the game window places it directly and its
+    // left button is the remote's A. Returns true when the pointer moved.
+    bool UpdatePointerLocked(SDL_Gamepad* gamepad, Clock::time_point now) {
+        const float dt = m_lastPointerUpdate == Clock::time_point{}
+                             ? 0.f
+                             : std::min(0.1f, std::chrono::duration<float>(now - m_lastPointerUpdate).count());
+        m_lastPointerUpdate = now;
+        const float oldX = m_pointerX, oldY = m_pointerY;
+        if (gamepad != nullptr && !InputBindings::InputBlocked()) {
+            const auto stick = [gamepad](SDL_GamepadAxis axis) {
+                const float v = SDL_GetGamepadAxis(gamepad, axis) / 32767.f;
+                if (std::fabs(v) < kStickDeadzone) return 0.f;
+                return (v - std::copysign(kStickDeadzone, v)) / (1.f - kStickDeadzone);
+            };
+            const float sx = stick(SDL_GAMEPAD_AXIS_RIGHTX), sy = stick(SDL_GAMEPAD_AXIS_RIGHTY);
+            m_pointerX += sx * kPointerSpeed * dt;
+            m_pointerY += sy * kPointerSpeed * dt;
+            if (sx != 0.f || sy != 0.f) g_userPointerMoves.fetch_add(1, std::memory_order_relaxed);
+        }
+        m_mouseClick = false;
+        m_mouseRightClick = false;
+        if (SDL_Window* window = SDL_GetMouseFocus()) {
+            float mx = 0, my = 0;
+            const SDL_MouseButtonFlags mouseButtons = SDL_GetMouseState(&mx, &my);
+            int width = 0, height = 0;
+            if (SDL_GetWindowSize(window, &width, &height) && width > 0 && height > 0) {
+                if (mx != m_lastMouseX || my != m_lastMouseY) {
+                    m_lastMouseX = mx;
+                    m_lastMouseY = my;
+                    m_pointerX = mx / width * 2.f - 1.f;
+                    m_pointerY = my / height * 2.f - 1.f;
+                    g_userPointerMoves.fetch_add(1, std::memory_order_relaxed);
+                }
+                m_mouseClick = (mouseButtons & SDL_BUTTON_LMASK) != 0 && !InputBindings::InputBlocked();
+                m_mouseRightClick = (mouseButtons & SDL_BUTTON_RMASK) != 0 && !InputBindings::InputBlocked();
+            }
+        }
+        float warpX = 0, warpY = 0;
+        const uint32_t warp = PunchOut_MenuWarp(&warpX, &warpY);
+        if (warp != g_appliedWarp.load(std::memory_order_relaxed)) {
+            m_pointerX = warpX; // the menu navigation put the pointer on a button
+            m_pointerY = warpY;
+            g_appliedWarp.store(warp, std::memory_order_release);
+        }
+        m_pointerX = std::clamp(m_pointerX, -1.f, 1.f);
+        m_pointerY = std::clamp(m_pointerY, -1.f, 1.f);
+        g_pointerX.store(m_pointerX, std::memory_order_relaxed);
+        g_pointerY.store(m_pointerY, std::memory_order_relaxed);
+        return m_pointerX != oldX || m_pointerY != oldY;
+    }
+
+    void PutIrExtended(Report& report) const {
+        const auto dots = IrDotsFor(m_pointerX, m_pointerY);
+        for (int i = 0; i < 4; ++i) {
+            if (i < 2 && m_irEnabled && dots[i].visible) {
+                const IrDot& d = dots[i];
+                report.push_back(static_cast<uint8_t>(d.x));
+                report.push_back(static_cast<uint8_t>(d.y));
+                report.push_back(static_cast<uint8_t>(((d.y >> 8) & 3) << 6 | ((d.x >> 8) & 3) << 4 | kDotSize));
+            } else {
+                report.insert(report.end(), 3, 0xFF);
+            }
+        }
+    }
+
+    void PutIrBasic(Report& report) const {
+        const auto dots = IrDotsFor(m_pointerX, m_pointerY);
+        IrDot a = dots[0], b = dots[1];
+        if (!m_irEnabled || !a.visible) a = IrDot{};
+        if (!m_irEnabled || !b.visible) b = IrDot{};
+        report.push_back(static_cast<uint8_t>(a.x));
+        report.push_back(static_cast<uint8_t>(a.y));
+        report.push_back(static_cast<uint8_t>(((a.y >> 8) & 3) << 6 | ((a.x >> 8) & 3) << 4 |
+                                              ((b.y >> 8) & 3) << 2 | ((b.x >> 8) & 3)));
+        report.push_back(static_cast<uint8_t>(b.x));
+        report.push_back(static_cast<uint8_t>(b.y));
+        report.insert(report.end(), 5, 0xFF); // second pair: no objects
+    }
+
+    void ResetLocked() {
+        m_replies.clear();
+        m_mode = 0x30;
+        m_continuous = false;
+        m_irEnabled = false;
+        m_speakerEnabled = false;
+        m_leds = 0;
+        m_lastButtons = 0xFFFF;
+        m_lastReport = {};
+        m_eeprom.assign(kEepromSize, 0);
+        std::copy(kEepromCalibration.begin(), kEepromCalibration.end(), m_eeprom.begin());
+    }
+
+    void PushLocked(Report report) {
+        if (m_replies.size() < kReplyLimit) m_replies.push_back(std::move(report));
+    }
+
+    void PutButtons(Report& report, uint16_t buttons) const {
+        report.push_back(static_cast<uint8_t>(buttons >> 8));
+        report.push_back(static_cast<uint8_t>(buttons));
+    }
+
+    void AckLocked(uint8_t reportId, uint8_t error) {
+        Report report{0x22};
+        PutButtons(report, m_lastButtons == 0xFFFF ? 0 : m_lastButtons);
+        report.push_back(reportId);
+        report.push_back(error);
+        PushLocked(std::move(report));
+    }
+
+    Report StatusReportLocked() const {
+        Report report{0x20};
+        PutButtons(report, m_lastButtons == 0xFFFF ? 0 : m_lastButtons);
+        uint8_t flags = m_leds;
+        if (m_speakerEnabled) flags |= 0x04;
+        if (m_irEnabled) flags |= 0x08;
+        report.push_back(flags); // no extension, battery not low
+        report.push_back(0x00);
+        report.push_back(0x00);
+        report.push_back(0xC0); // battery level: full
+        return report;
+    }
+
+    void WriteMemoryLocked(const uint8_t* data, size_t size) {
+        if (size < 7) {
+            AckLocked(0x16, kErrorBadAddress);
+            return;
+        }
+        const bool registers = (data[1] & 0x04) != 0;
+        const uint32_t address = (static_cast<uint32_t>(data[2]) << 16) | (data[3] << 8) | data[4];
+        const uint32_t length = std::min<uint32_t>(data[5], 16);
+        uint8_t error = kErrorNone;
+        if (!registers) {
+            if (address + length > kEepromSize) {
+                error = kErrorBadAddress;
+            } else {
+                for (uint32_t i = 0; i < length && 6 + i < size; ++i) m_eeprom[address + i] = data[6 + i];
+            }
+        } else if ((address >> 16) == 0xA4) {
+            error = kErrorNoDevice; // no extension plugged in
+        }
+        // Speaker (0xA2) and IR camera (0xB0) registers just take the write.
+        AckLocked(0x16, error);
+    }
+
+    void ReadMemoryLocked(const uint8_t* data, size_t size) {
+        if (size < 7) return;
+        const bool registers = (data[1] & 0x04) != 0;
+        uint32_t address = (static_cast<uint32_t>(data[2]) << 16) | (data[3] << 8) | data[4];
+        uint32_t remaining = (static_cast<uint32_t>(data[5]) << 8) | data[6];
+        const uint16_t buttons = m_lastButtons == 0xFFFF ? 0 : m_lastButtons;
+        const auto reply = [&](uint8_t error, uint32_t length, const uint8_t* bytes) {
+            Report report{0x21};
+            PutButtons(report, buttons);
+            report.push_back(static_cast<uint8_t>(((length == 0 ? 0 : length - 1) << 4) | error));
+            report.push_back(static_cast<uint8_t>(address >> 8));
+            report.push_back(static_cast<uint8_t>(address));
+            for (uint32_t i = 0; i < 16; ++i) report.push_back(i < length && bytes != nullptr ? bytes[i] : 0);
+            PushLocked(std::move(report));
+        };
+        if (registers && (address >> 16) == 0xA4) {
+            reply(kErrorNoDevice, 1, nullptr);
+            return;
+        }
+        if (!registers && address >= kEepromSize) {
+            reply(kErrorBadAddress, 1, nullptr);
+            return;
+        }
+        while (remaining > 0) {
+            const uint32_t length = std::min<uint32_t>(remaining, 16);
+            uint8_t chunk[16]{};
+            if (!registers) {
+                for (uint32_t i = 0; i < length && address + i < kEepromSize; ++i) chunk[i] = m_eeprom[address + i];
+            }
+            reply(kErrorNone, length, chunk);
+            address += length;
+            remaining -= length;
+        }
+    }
+
+    Report DataReportLocked(uint16_t buttons) const {
+        Report report{m_mode};
+        PutButtons(report, buttons);
+        const auto accel = [&report] {
+            report.push_back(kAccelZero);
+            report.push_back(kAccelZero);
+            report.push_back(kAccelOneG);
+        };
+        const auto bytes = [&report](size_t count, uint8_t value) { report.insert(report.end(), count, value); };
+        switch (m_mode) {
+        case 0x30: break;
+        case 0x31: accel(); break;
+        case 0x32: bytes(8, 0x00); break;
+        case 0x33: accel(); PutIrExtended(report); break;
+        case 0x34: bytes(19, 0x00); break;
+        case 0x35: accel(); bytes(16, 0x00); break;
+        case 0x36: PutIrBasic(report); bytes(9, 0x00); break;
+        case 0x37: accel(); PutIrBasic(report); bytes(6, 0x00); break;
+        case 0x3D: report.assign(1, 0x3D); bytes(21, 0x00); break;
+        case 0x3E:
+        case 0x3F: report.push_back(kAccelZero); bytes(18, 0xFF); break;
+        default: report.assign({0x30}); PutButtons(report, buttons); break;
+        }
+        return report;
+    }
+
+    void SetRumbleLocked(bool on) {
+        if (on == m_rumble) return;
+        m_rumble = on;
+        if (SDL_Gamepad* gamepad = FindGamepad()) {
+            const bool allowed = PAD_HLE_RumbleEnabled();
+            SDL_RumbleGamepad(gamepad, on && allowed ? 0x8000 : 0, on && allowed ? 0x8000 : 0, on ? 5000 : 0);
+        }
+    }
+
+    void StopRumbleLocked() { SetRumbleLocked(false); }
+
+    void LogOutput(const uint8_t* data, size_t size) {
+        // The connection handshake, once; then only mode changes.
+        if (m_outputLogs >= 40 && data[0] != 0x12) return;
+        if (m_outputLogs >= 60) return;
+        ++m_outputLogs;
+        std::cerr << "[hle] Emulated Wii Remote <- " << std::hex << std::setfill('0');
+        for (size_t i = 0; i < std::min<size_t>(size, 8); ++i) std::cerr << std::setw(2) << int(data[i]) << ' ';
+        std::cerr << std::dec << std::setfill(' ') << (size > 8 ? "..." : "") << std::endl;
+    }
+
+    std::mutex m_mutex;
+    std::atomic<bool> m_ready{false};
+    std::atomic<bool> m_wake{true};
+    std::atomic<bool> m_released{false};
+    std::deque<Report> m_replies;
+    std::vector<uint8_t> m_eeprom = std::vector<uint8_t>(kEepromSize, 0);
+    uint8_t m_mode = 0x30;
+    bool m_continuous = false;
+    bool m_irEnabled = false;
+    bool m_speakerEnabled = false;
+    bool m_rumble = false;
+    uint8_t m_leds = 0;
+    uint16_t m_lastButtons = 0xFFFF;
+    bool m_wasMenu = false;
+    uint16_t m_swallowed = 0; // fight buttons held from the menu, ignored until released
+    Clock::time_point m_lastReport{};
+    float m_pointerX = 0.f;
+    float m_pointerY = 0.f;
+    float m_lastMouseX = -1.f;
+    float m_lastMouseY = -1.f;
+    bool m_mouseClick = false;
+    bool m_mouseRightClick = false;
+    Clock::time_point m_lastPointerUpdate{};
+    int m_outputLogs = 0;
+    int m_buttonLogs = 0;
+};
+
+class EmulatingHost final : public Bluetooth::RemoteHost {
+public:
+    explicit EmulatingHost(Bluetooth::RemoteHost& physical) : m_physical(physical) {}
+
+    bool IsAttached(size_t slot) const override {
+        return Emulated(slot) ? m_remote.IsAttached() : m_physical.IsAttached(slot);
+    }
+    bool ConsumeWake(size_t slot) override {
+        return Emulated(slot) ? m_remote.ConsumeWake() : m_physical.ConsumeWake(slot);
+    }
+    bool PopInputReport(size_t slot, std::vector<uint8_t>& report) override {
+        return Emulated(slot) ? m_remote.PopInputReport(report) : m_physical.PopInputReport(slot, report);
+    }
+    void SendOutputReport(size_t slot, const uint8_t* report, size_t size) override {
+        if (Emulated(slot)) {
+            m_remote.SendOutputReport(report, size);
+        } else {
+            m_physical.SendOutputReport(slot, report, size);
+        }
+    }
+    void OnLinkStateChanged(size_t slot, Bluetooth::LinkState state) override {
+        if (Emulated(slot)) {
+            m_remote.OnLinkStateChanged(state);
+        } else {
+            m_physical.OnLinkStateChanged(slot, state);
+        }
+    }
+    void OnGuestDisconnect(size_t slot) override {
+        if (Emulated(slot)) {
+            m_remote.OnGuestDisconnect();
+        } else {
+            m_physical.OnGuestDisconnect(slot);
+        }
+    }
+    void OnGuestInquiry(bool active) override { m_physical.OnGuestInquiry(active); }
+    const char* DeviceName(size_t slot) const override {
+        return Emulated(slot) ? "Nintendo RVL-CNT-01" : m_physical.DeviceName(slot);
+    }
+
+private:
+    // A physical remote already on the slot wins; once the slot is emulated it stays emulated.
+    bool Emulated(size_t slot) const {
+        if (slot != kEmulatedSlot) return false;
+        if (m_emulating.load()) return true;
+        const bool emulate = !m_physical.IsAttached(slot);
+        m_emulating = emulate;
+        return emulate;
+    }
+
+    Bluetooth::RemoteHost& m_physical;
+    mutable EmulatedRemote m_remote;
+    mutable std::atomic<bool> m_emulating{false};
+};
+
+} // namespace
+
+Bluetooth::RemoteHost& EmulatedHost(Bluetooth::RemoteHost& physical) {
+    // Never destroyed, like the physical manager: the Bluetooth controller may outlive statics.
+    static EmulatingHost* host = new EmulatingHost(physical);
+    return *host;
+}
