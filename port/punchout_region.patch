+// Called once per presented frame: arms the GX trace for frames
+// [PUNCHOUT_GX_TRACE_FRAME, PUNCHOUT_GX_TRACE_FRAME + PUNCHOUT_GX_TRACE_FRAMES).
+void PunchOutGxTraceFrameTick(uint64_t presented) noexcept
+{
+    static const long long first = [] {
+        const char* v = std::getenv("PUNCHOUT_GX_TRACE_FRAME");
+        return v ? std::atoll(v) : -1LL;
+    }();
+    static const long long count = [] {
+        const char* v = std::getenv("PUNCHOUT_GX_TRACE_FRAMES");
+        const long long n = v ? std::atoll(v) : 1LL;
+        return n < 1 ? 1LL : n;
+    }();
+    if (first < 0) {
+        return;
+    }
+    const long long frame = static_cast<long long>(presented);
+    if (frame >= first && frame < first + count) {
+        std::fprintf(stderr, "[gxtrace] ===== begin frame %lld =====\n", frame + 1);
+        g_gxTraceOn.store(true, std::memory_order_relaxed);
+    } else if (frame == first + count) {
+        g_gxTraceOn.store(false, std::memory_order_relaxed);
+        std::fprintf(stderr, "[gxtrace] ===== end trace after frame %lld =====\n", frame);
+        std::fflush(stderr);
+    }
+}
