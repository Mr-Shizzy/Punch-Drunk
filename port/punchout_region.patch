+// For the partial GXInitTexObj* setters (wrap mode, filter, TLUT, LOD, user data). Games may build
+// a GXTexObj by copying another one's 32 bytes (Punch-Out!! copies its cached texture objects onto
+// the stack before every draw) and then call only a partial setter on the copy. GetTexObjMeta would
+// mark the slot in sync with those new bytes while keeping the previous texture's data address,
+// so the following GXLoadTexObj took its fast path and drew the previous texture. Re-decode the
+// guest struct first whenever it no longer matches the slot.
+TexObjMeta& GetTexObjMetaForUpdate(uint32_t addr) {
+    TexObjSlot& slot = FindOrCreateTexObjSlot(addr);
+    uint64_t shadow[4];
+    if (ReadTexObjShadow(addr, shadow) && !(slot.hasGuestShadow && ShadowEquals(slot.guestShadow, shadow))) {
+        const TexObjMeta extracted = ExtractTexObjMetaFromGuest(addr);
+        if (IsUsableTexObjMeta(extracted)) {
+            QueueTexObjIntervalUpdate(slot);
+            static_cast<TexObjMeta&>(slot) = MergeGuestTexObjMeta(slot, extracted);
+        }
+    }
+    QueueTexObjIntervalUpdate(slot);
+    MarkTexObjSyncedLocked(slot);
+    return slot;
+}
