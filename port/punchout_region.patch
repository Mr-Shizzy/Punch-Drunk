diff --git a/runtime/CMakeLists.txt b/runtime/CMakeLists.txt
index f0d4fd4..68beb05 100644
--- a/runtime/CMakeLists.txt
+++ b/runtime/CMakeLists.txt
@@ -166,7 +166,10 @@ endif()
 # and would also add a dependency Windows never links.
 add_library(mkw_mbedtls INTERFACE)
 add_library(mkw::mbedtls ALIAS mkw_mbedtls)
-if(NOT MKW_PLATFORM_WINDOWS)
+# Punch-Out!!'s Archipelago client (punchout_ap_net.cpp) uses mbed TLS on Windows too. Windows builds run
+# FETCHCONTENT_FULLY_DISCONNECTED, so their build script puts the pinned tarball's tree in Dependencies/
+# mkw_mbedtls_upstream, which becomes FETCHCONTENT_SOURCE_DIR_MKW_MBEDTLS_UPSTREAM.
+if(TRUE)
     include("${CMAKE_CURRENT_LIST_DIR}/cmake/MbedTLSPin.cmake")
     if(NOT MKW_NATIVE_PREBUILT_DIR)
         include(FetchContent)
