--- /dev/null
+++ b/runtime/src/wiimote/punchout_controls.cpp
@@ -0,0 +1,222 @@
+#include "punchout_controls.h"
+
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_keyboard.h>
+#include <SDL3/SDL_mouse.h>
+#include <SDL3/SDL_scancode.h>
+#include <SDL3/SDL_stdinc.h>
+
+#include <array>
+#include <atomic>
+#include <iostream>
+
+namespace PunchOutControls {
+namespace {
+
+struct ControlInfo {
+    const char* name;
+    const char* action;
+    std::array<int, kSlotCount> defaults;
+};
+
+constexpr int U = kUnbound;
+
+// The default layout: WASD or the arrows to move, J / K to punch, L or Space for the star punch, Q / E to turn
+// menu pages.
+const std::array<ControlInfo, kControlCount> kControls = {{
+    {"Up", "Block (with a punch: punch to the face)", {SDL_SCANCODE_W, SDL_SCANCODE_UP, SDL_GAMEPAD_BUTTON_DPAD_UP, U}},
+    {"Down", "Duck", {SDL_SCANCODE_S, SDL_SCANCODE_DOWN, SDL_GAMEPAD_BUTTON_DPAD_DOWN, U}},
+    {"Left", "Dodge left", {SDL_SCANCODE_A, SDL_SCANCODE_LEFT, SDL_GAMEPAD_BUTTON_DPAD_LEFT, U}},
+    {"Right", "Dodge right", {SDL_SCANCODE_D, SDL_SCANCODE_RIGHT, SDL_GAMEPAD_BUTTON_DPAD_RIGHT, U}},
+    {"1", "Left punch", {SDL_SCANCODE_J, U, SDL_GAMEPAD_BUTTON_SOUTH, U}},
+    {"2", "Right punch", {SDL_SCANCODE_K, U, SDL_GAMEPAD_BUTTON_EAST, U}},
+    {"A", "Star punch", {SDL_SCANCODE_L, SDL_SCANCODE_SPACE, SDL_GAMEPAD_BUTTON_NORTH, U}},
+    {"B", "The remote's B", {U, U, SDL_GAMEPAD_BUTTON_WEST, U}},
+    {"+", "Pause", {SDL_SCANCODE_RETURN, U, SDL_GAMEPAD_BUTTON_START, U}},
+    {"-", "The remote's -", {SDL_SCANCODE_BACKSPACE, U, SDL_GAMEPAD_BUTTON_BACK, U}},
+    {"menus", "Previous page", {SDL_SCANCODE_Q, U, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, U}},
+    {"menus", "Next page", {SDL_SCANCODE_E, U, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, U}},
+}};
+
+std::array<std::atomic<int>, static_cast<size_t>(kControlCount) * kSlotCount> g_bindings;
+std::atomic<bool> g_loaded{false};
+std::atomic<bool> g_lockMouse{false};
+
+constexpr std::array<const char*, 5> kMouseNames = {"Mouse Left", "Mouse Middle", "Mouse Right", "Mouse Side 1",
+                                                    "Mouse Side 2"};
+
+bool IsKeySlot(size_t slot) {
+    return slot == Key1 || slot == Key2;
+}
+
+std::string KeyToConfig(int code) {
+    if (code == kUnbound) return "";
+    if (code > kMouseBase && code <= kMouseBase + 5) return kMouseNames[code - kMouseBase - 1];
+    if (code > SDL_SCANCODE_UNKNOWN && code < SDL_SCANCODE_COUNT) {
+        return SDL_GetScancodeName(static_cast<SDL_Scancode>(code));
+    }
+    return "";
+}
+
+std::string PadToConfig(int code) {
+    if (code == kUnbound) return "";
+    if (code == kTriggerBase + SDL_GAMEPAD_AXIS_LEFT_TRIGGER || code == kTriggerBase + SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) {
+        const char* s = SDL_GetGamepadStringForAxis(static_cast<SDL_GamepadAxis>(code - kTriggerBase));
+        return s != nullptr ? s : "";
+    }
+    if (code >= 0 && code < SDL_GAMEPAD_BUTTON_COUNT) {
+        const char* s = SDL_GetGamepadStringForButton(static_cast<SDL_GamepadButton>(code));
+        return s != nullptr ? s : "";
+    }
+    return "";
+}
+
+bool EqualsIgnoreCase(const std::string& a, const char* b) {
+    size_t i = 0;
+    for (; i < a.size() && b[i] != '\0'; ++i) {
+        if (SDL_tolower(static_cast<unsigned char>(a[i])) != SDL_tolower(static_cast<unsigned char>(b[i]))) return false;
+    }
+    return i == a.size() && b[i] == '\0';
+}
+
+// Returns kUnbound for "" and for names it doesn't know (with a log line).
+int ParseKey(const std::string& text) {
+    if (text.empty()) return kUnbound;
+    for (size_t i = 0; i < kMouseNames.size(); ++i) {
+        if (EqualsIgnoreCase(text, kMouseNames[i])) return kMouseBase + 1 + static_cast<int>(i);
+    }
+    const SDL_Scancode sc = SDL_GetScancodeFromName(text.c_str());
+    if (sc != SDL_SCANCODE_UNKNOWN) return sc;
+    RT_LOG(RT_TAG_HLE) << "[controls] Unknown key name \"" << text << "\" in [punchout_controls]" << std::endl;
+    return kUnbound;
+}
+
+int ParsePad(const std::string& text) {
+    if (text.empty()) return kUnbound;
+    const SDL_GamepadButton button = SDL_GetGamepadButtonFromString(text.c_str());
+    if (button != SDL_GAMEPAD_BUTTON_INVALID) return button;
+    const SDL_GamepadAxis axis = SDL_GetGamepadAxisFromString(text.c_str());
+    if (axis == SDL_GAMEPAD_AXIS_LEFT_TRIGGER || axis == SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) return kTriggerBase + axis;
+    RT_LOG(RT_TAG_HLE) << "[controls] Unknown controller button \"" << text << "\" in [punchout_controls]" << std::endl;
+    return kUnbound;
+}
+
+void EnsureLoaded() {
+    if (!g_loaded.load(std::memory_order_acquire)) Reload();
+}
+
+bool KeyCodeHeld(int code) {
+    if (code == kUnbound) return false;
+    if (code > kMouseBase && code <= kMouseBase + 5) {
+        if (SDL_GetMouseFocus() == nullptr) return false;
+        return (SDL_GetMouseState(nullptr, nullptr) & SDL_BUTTON_MASK(code - kMouseBase)) != 0;
+    }
+    if (code <= SDL_SCANCODE_UNKNOWN || code >= SDL_SCANCODE_COUNT) return false;
+    int count = 0;
+    const bool* keys = SDL_GetKeyboardState(&count);
+    return keys != nullptr && code < count && keys[code];
+}
+
+bool PadCodeHeld(int code, SDL_Gamepad* gamepad) {
+    if (code == kUnbound || gamepad == nullptr) return false;
+    if (code >= kTriggerBase) {
+        return SDL_GetGamepadAxis(gamepad, static_cast<SDL_GamepadAxis>(code - kTriggerBase)) > 16384; // half pulled
+    }
+    return SDL_GetGamepadButton(gamepad, static_cast<SDL_GamepadButton>(code));
+}
+
+} // namespace
+
+void Reload() {
+    for (size_t c = 0; c < kControlCount; ++c) {
+        for (size_t s = 0; s < kSlotCount; ++s) {
+            const auto text = RuntimeConfigFile::PunchOutControl(c, s);
+            const int code = !text ? kControls[c].defaults[s] : IsKeySlot(s) ? ParseKey(*text) : ParsePad(*text);
+            g_bindings[c * kSlotCount + s].store(code, std::memory_order_relaxed);
+        }
+    }
+    g_lockMouse.store(RuntimeConfigFile::LockMouse(false), std::memory_order_relaxed);
+    g_loaded.store(true, std::memory_order_release);
+}
+
+int Binding(size_t control, size_t slot) {
+    if (control >= kControlCount || slot >= kSlotCount) return kUnbound;
+    EnsureLoaded();
+    return g_bindings[control * kSlotCount + slot].load(std::memory_order_relaxed);
+}
+
+void SetBinding(size_t control, size_t slot, int code) {
+    if (control >= kControlCount || slot >= kSlotCount) return;
+    EnsureLoaded();
+    g_bindings[control * kSlotCount + slot].store(code, std::memory_order_relaxed);
+    RuntimeConfigFile::SetPunchOutControl(control, slot, IsKeySlot(slot) ? KeyToConfig(code) : PadToConfig(code));
+}
+
+void ResetDefaults() {
+    for (size_t c = 0; c < kControlCount; ++c) {
+        for (size_t s = 0; s < kSlotCount; ++s) SetBinding(c, s, kControls[c].defaults[s]);
+    }
+}
+
+const char* ControlName(size_t control) {
+    return control < kControlCount ? kControls[control].name : "";
+}
+
+const char* ControlAction(size_t control) {
+    return control < kControlCount ? kControls[control].action : "";
+}
+
+std::string KeyName(int code) {
+    return KeyToConfig(code);
+}
+
+std::string PadName(int code) {
+    switch (code) {
+    case kUnbound: return "";
+    case SDL_GAMEPAD_BUTTON_SOUTH: return "A / Cross";
+    case SDL_GAMEPAD_BUTTON_EAST: return "B / Circle";
+    case SDL_GAMEPAD_BUTTON_WEST: return "X / Square";
+    case SDL_GAMEPAD_BUTTON_NORTH: return "Y / Triangle";
+    case SDL_GAMEPAD_BUTTON_BACK: return "Back / Share";
+    case SDL_GAMEPAD_BUTTON_GUIDE: return "Guide";
+    case SDL_GAMEPAD_BUTTON_START: return "Start / Options";
+    case SDL_GAMEPAD_BUTTON_LEFT_STICK: return "Left stick click";
+    case SDL_GAMEPAD_BUTTON_RIGHT_STICK: return "Right stick click";
+    case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER: return "LB / L1";
+    case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER: return "RB / R1";
+    case SDL_GAMEPAD_BUTTON_DPAD_UP: return "D-pad up";
+    case SDL_GAMEPAD_BUTTON_DPAD_DOWN: return "D-pad down";
+    case SDL_GAMEPAD_BUTTON_DPAD_LEFT: return "D-pad left";
+    case SDL_GAMEPAD_BUTTON_DPAD_RIGHT: return "D-pad right";
+    case SDL_GAMEPAD_BUTTON_TOUCHPAD: return "Touchpad";
+    case kTriggerBase + SDL_GAMEPAD_AXIS_LEFT_TRIGGER: return "LT / L2";
+    case kTriggerBase + SDL_GAMEPAD_AXIS_RIGHT_TRIGGER: return "RT / R2";
+    default: return PadToConfig(code);
+    }
+}
+
+bool KeyHeld(size_t control) {
+    if (control >= kControlCount || SDL_GetKeyboardFocus() == nullptr) return false;
+    return KeyCodeHeld(Binding(control, Key1)) || KeyCodeHeld(Binding(control, Key2));
+}
+
+bool PadHeld(size_t control, SDL_Gamepad* gamepad) {
+    if (control >= kControlCount || gamepad == nullptr) return false;
+    return PadCodeHeld(Binding(control, Pad1), gamepad) || PadCodeHeld(Binding(control, Pad2), gamepad);
+}
+
+bool LockMouse() {
+    EnsureLoaded();
+    return g_lockMouse.load(std::memory_order_relaxed);
+}
+
+void SetLockMouse(bool value) {
+    EnsureLoaded();
+    g_lockMouse.store(value, std::memory_order_relaxed);
+    RuntimeConfigFile::SetLockMouse(value);
+}
+
+} // namespace PunchOutControls
