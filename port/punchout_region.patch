+// A node of an FE ring (next at +0) whose word at +hashOff is `hash`.
+uint32_t RingFind(uint32_t head, uint32_t hashOff, uint32_t hash) {
+    uint32_t n = head;
+    for (int i = 0; i < 512 && IsPtr(n); ++i) {
+        if (R32(n + hashOff) == hash) return n;
+        n = R32(n);
+        if (n == head) break;
+    }
+    return 0;
+}
+// scene (presentation: +0 slide ring) -> slide -> instance path.
+uint32_t SceneInstance(uint32_t scene, const char* slide, std::initializer_list<const char*> path) {
+    const uint32_t s = IsPtr(scene) ? RingFind(R32(scene), 0x44u, FeHash(slide)) : 0u;
+    if (s == 0) return 0;
+    uint32_t children = R32(s + 8u), inst = 0;
+    for (const char* name : path) {
+        inst = RingFind(children, 0x38u, FeHash(name));
+        if (inst == 0) return 0;
+        children = R32(inst + 8u);
+    }
+    return inst;
+}
+// Text instances called `name` (type 3) in an instance tree.
+void FindTexts(uint32_t children, uint32_t hash, uint32_t* out, int max, int& n, int depth = 0) {
+    uint32_t c = children;
+    for (int i = 0; i < 64 && IsPtr(c) && depth < 8; ++i) {
+        if (R32(c + 0x88u) == 3u && R32(c + 0x38u) == hash && n < max) out[n++] = c;
+        FindTexts(R32(c + 8u), hash, out, max, n, depth + 1);
+        c = R32(c);
+        if (c == children) break;
+    }
+}
+// The label texts of a component button instance: "name" in each of the component's slides.
+int ComponentLabels(uint32_t inst, uint32_t* out, int max) {
+    int n = 0;
+    const uint32_t comp = IsPtr(inst) ? R32(inst + 0xCu) : 0u;
+    const uint32_t head = IsPtr(comp) ? R32(comp + 0x78u) : 0u;
+    uint32_t s = head;
+    for (int i = 0; i < 8 && IsPtr(s); ++i) {
+        FindTexts(R32(s + 8u), FeHash("name"), out, max, n);
+        s = R32(s);
+        if (s == head) break;
+    }
+    return n;
+}
