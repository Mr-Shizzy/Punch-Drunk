+void DeathLinkTick(bool /*inFight*/, double now, double elapsed, std::optional<uint32_t> star, std::optional<uint32_t> save, bool saveOk) {
+    // Sending: losses.
+    std::optional<long long> lossTotal;
+    if (save) {
+        long long t = 0;
+        for (int i = 0; i < kNumFights; ++i) t += R8(*save + kSaveLosses + uint32_t(i) * kFightStride);
+        lossTotal = t;
+    }
+    if (!saveOk) {
+        lossTotal = g.lastLossTotal;
+    } else if (g.lastLossTotal && lossTotal && *lossTotal > *g.lastLossTotal) {
+        if (g.deathLinkSend == 1) {
+        } else if (g.deathSinceFightStart) {
+            Log("Death link: Mac lost, but a received death did it, so nothing is sent back.", kNote);
+        } else {
+            SendDeathIfAllowed("lost a fight");
+        }
+    }
+    g.lastLossTotal = lossTotal;
+    // Sending: knockdowns.
+    const long long downs = static_cast<long long>(R32(kMacKnockdowns)) + R32(kMacKnockouts);
+    const auto seen = g.macDownsSeen;
+    g.macDownsSeen = downs;
+    if (seen && downs > *seen && g.deathLinkSend == 1) {
+        if (g.deathActive) Log("Death link: Mac went down, but a received death did it, so nothing is sent back.", kNote);
+        else SendDeathIfAllowed("got knocked down");
+    }
+    if (!star) {
+        if (g.deathActive && (g.deathModeNow == 1 || g.deathModeNow == 2)) EndPunishment("the fight is over.");
+        g.deathHolding = false;
+        g.deathSavedHealth.reset();
+        g.lastHealth.reset();
+        return;
+    }
+    float health = RF(*star - 0x58);
+    if (Bad(health)) return;
+    if (std::fabs(health + 1.0f) < 1e-6f) {
+        if (g.mailboxSince && now - *g.mailboxSince > 1.0) {
+            SetHealth(*star, 0);
+            Log("Death link: the game didn't respond, so Mac is just left on 0 health.", kNote);
+            g.mailboxSince.reset();
+        }
+        g.lastHealth = 0;
+        return;
+    }
+    if (health < -0.01f || health > 1000) return;
+    g.mailboxSince.reset();
+    if (g.lastHealth && health > *g.lastHealth + 0.01f) g.healthLastRose = now;
+    const bool settled = now - g.healthLastRose >= 1.0;
+    if (g.deathActive && g.deathModeNow == 0 && g.roundRestarted) {
+        if (g.deathSavedHealth && *g.deathSavedHealth > 0.01f) {
+            SetHealth(*star, *g.deathSavedHealth);
+            health = *g.deathSavedHealth;
+        }
+        EndPunishment("new round! Mac caught his breath. Health restored.");
+    }
+    if (g.deathLinkTag && ReadyToWrite() && RoundPlayable(now)) {
+        if (!g.deathActive && g.deathsPending > 0 && health > 0.01f && settled) {
+            --g.deathsPending;
+            g.deathActive = true;
+            g.deathHolding = false;
+            g.deathSavedHealth.reset();
+            g.deathSecondsLeft = g.deathLinkSeconds;
+            g.deathSinceFightStart = true;
+            g.deathModeNow = g.deathLinkReceive;
+            if (g.deathModeNow == 2 && Waiting(kSecondChance) > 0 && InCareerMode()) {
+                MarkSome(kSecondChance, 1);
+                g.deathModeNow = 1;
+                Log("Death link: hardcore knockdown, but your Second Chance lets Mac get up from this one (" +
+                        std::to_string(Waiting(kSecondChance)) + " left).", kGood);
+            }
+            if (g.deathModeNow == 1 || g.deathModeNow == 2) {
+                WF(*star - 0x58, -1.0f); // the fight-frame hook knocks him down
+                g.mailboxSince = now;
+                g.deathHolding = true;
+                g.lastHealth = 0;
+                Log(g.deathModeNow == 2 ? "Death link: down goes Mac... and he's NOT getting up." : "Death link: down goes Mac!", kBad);
+                return;
+            }
+            char buf[96];
+            std::snprintf(buf, sizeof buf, "Death link: no health, no breath for %g seconds. Don't get hit!", g.deathSecondsLeft);
+            Log(buf, kBad);
+        }
+        if (g.deathActive && g.deathModeNow != 0) {
+            if (g.deathHolding && health > 0.01f) EndPunishment("Mac beat the count. Back to work.");
+        } else if (g.deathActive) {
+            if (g.deathHolding && health > 0.01f) {
+                EndPunishment("Mac got his health back. Punishment over.");
+            } else {
+                if (!g.deathHolding && !g.deathSavedHealth) g.deathSavedHealth = health;
+                if (health > 0.01f) SetHealth(*star, 0);
+                KeepMacTired(*star);
+                g.deathHolding = true;
+                health = 0;
+                g.deathSecondsLeft -= elapsed;
+                if (g.deathSecondsLeft < 0.001) {
+                    if (g.deathSavedHealth && *g.deathSavedHealth > 0.01f) {
+                        SetHealth(*star, *g.deathSavedHealth);
+                        health = *g.deathSavedHealth;
+                    }
+                    EndPunishment("Mac survived! Health restored.");
+                }
+            }
+        }
+    }
+    g.lastHealth = health;
+}
+
+uint32_t BlockedInputMask() {
+    if (!g.moveUnlocks) return 0;
+    uint32_t m = 0;
+    if (!CountReceived(kLeftJab)) m |= 0x0002;
+    if (!CountReceived(kRightJab)) m |= 0x0004;
+    if (!CountReceived(kBlock)) m |= 0x0400;
+    if (!CountReceived(kDuck)) m |= 0x0200;
+    if (!CountReceived(kDodgeLeft)) m |= 0x8080;
+    if (!CountReceived(kDodgeRight)) m |= 0x4100;
+    return m;
+}
+
+void GameTick(double now) {
+    const double elapsed = g.lastTick < 0 ? 0.0 : std::min(now - g.lastTick, 1.0);
+    g.lastTick = now;
+    if (!g.seedReady) return;
+    // The game patch's seed check (always true here: the patch is built in), kept for the save-slot warnings.
+    std::optional<uint32_t> save = FindSaveSlot();
+    int counter = g.lastCounter >= 0 ? g.lastCounter : 0;
+    std::vector<uint8_t> flags(kFlagsLength, 0);
+    bool saveOk = false;
+    std::string warning;
+    if (!save) {
+        warning = "Load profile slot 6 (the randomizer profile). Until then the client won't touch the save data.";
+    } else {
+        counter = R8(*save + kSaveCounter);
+        ReadBytes(*save + kSaveFlags, flags.data(), kFlagsLength);
+        saveOk = SaveDataPlausible(counter, flags);
+        warning = "Profile slot 6's data doesn't look right (challenges done for fighters you haven't reached). Not "
+                  "sending checks or changing the save. Use a fresh slot 6.";
+    }
+    if (!saveOk) {
+        if (warning != g.saveWarning) {
+            g.saveWarning = warning;
+            Log(warning, kNote);
+        }
+        g.lastCounter = -1;
+    } else {
+        g.saveWarning.clear();
+    }
+    const std::optional<uint32_t> star = FindStar();
+    const bool inFight = star.has_value();
+    UpdateRoundClock(inFight, now);
+    if (inFight && RoundPlayable(now)) {
+        for (auto& [id, d] : g.selfFoundDelays) d -= elapsed;
+    }
+    if (!inFight) {
+        g.fightLoadedAt.reset();
+    } else if (!g.fightLoadedAt) {
+        g.fightLoadedAt = g.seenGameOnce ? now : now - g.heartTrapStartDelay;
+        g.deathSinceFightStart = false;
+    }
+    g.seenGameOnce = true;
+
+    // Wins.
+    g.knownFighters = std::max(g.knownFighters, CountReceived(kFighter));
+    const int highestUnlocked = 1 + g.knownFighters;
+    bool justWon = false;
+    std::set<int64_t> fresh;
+    if (saveOk && g.lastCounter >= 0 && counter > g.lastCounter) {
+        justWon = true;
+        EndIronFists("Iron Fists wore off (you won).");
+        for (int fight = g.lastCounter + 1; fight <= std::min(counter, kNumFights); ++fight) {
+            if (fight > highestUnlocked) {
+                Log("Not counted (not unlocked yet, you'll replay it): " + FightName(fight) + " - Win", kNote);
+            } else {
+                fresh.insert(WinId(fight));
+                Log("Won: " + FightName(fight) + " - Win", kGood);
+            }
+        }
+    }
+    // Challenges.
+    if (saveOk) {
+        for (int n = 1; n <= kNumFights; ++n) {
+            for (int c = 1; c <= 3; ++c) {
+                const int64_t id = ChallengeId(n, c);
+                if (flags[(n - 1) * kFightStride + (c - 1)] && !g.checkedLocal.count(id) && !fresh.count(id)) {
+                    fresh.insert(id);
+                    Log("Challenge done: " + FightName(n) + " - Challenge " + std::to_string(c), kGood);
+                }
+            }
+        }
+    }
+    g.checkedLocal.insert(fresh.begin(), fresh.end());
+    std::vector<int64_t> send;
+    for (int64_t id : g.checkedLocal) {
+        if (g.missing.count(id)) send.push_back(id);
+    }
+    if (!send.empty() && (!fresh.empty() || g.frame % 60 == 0)) Session::Get().Send({{"cmd", "LocationChecks"}, {"locations", send}});
+    const std::set<int64_t> checked = AllChecked();
+    if (!g.finishedGame && GoalReached(checked)) {
+        Session::Get().Send({{"cmd", "StatusUpdate"}, {"status", 30}});
+        g.finishedGame = true;
+        Log("Goal complete! Congratulations, champ.", kGood);
+    }
+    int valueInMemory = counter;
+    if (ReadyToWrite() && saveOk) {
+        // Career counter hold.
+        const bool freeAfterGoal = g.goal == 0 && GoalReached(checked);
+        int target = TargetCounter(FightsCompletedInOrder(checked), CountReceived(kFighter));
+        if (freeAfterGoal) target = counter;
+        if (counter != target && (justWon || g.lastCounter < 0 || !inFight)) {
+            W8(*save + kSaveCounter, static_cast<uint8_t>(target));
+            valueInMemory = target;
+        }
+        // Star punch cap.
+        if (inFight) {
+            const float allowed = static_cast<float>(std::min(3, CountReceived(kStarPunch)));
+            const float limit = RF(*star - 4);
+            if (!Bad(limit) && limit >= 0 && limit <= 3.01f && std::fabs(limit - allowed) > 0.01f) WF(*star - 4, allowed);
+            if (RF(*star) > allowed + 0.01f) WF(*star, allowed);
+        }
+        if (star) HeartTraps(inFight, now, *star, elapsed);
+    }
+    // Move unlocks.
+    uint32_t wanted = ReadyToWrite() && inFight ? BlockedInputMask() : 0;
+    if (g.deathActive && g.deathModeNow == 2 && inFight) wanted |= 0x001E001Eu;
+    if (R32(kInputMask) != wanted) W32(kInputMask, wanted);
+    if (ReadyToWrite()) OtherItems(inFight, now, star, save, saveOk);
+    DeathLinkTick(inFight, now, elapsed, star, save, saveOk);
+    SecondChances(inFight);
+    SuperMacTick(inFight, now, elapsed, star);
+    ClockTrapTick(inFight, now, elapsed);
+    HpZapTick(inFight, now);
+    DamageTick(inFight, now);
+    g.fastPoll = inFight && (g.heartTrapSecondsLeft > 0 || g.deathActive || g.superMacSecondsLeft > 0 || g.clockTrapSecondsLeft > 0);
+    if (g.slot >= 0 && saveOk) g.lastCounter = valueInMemory;
+    else if (!saveOk) g.lastCounter = -1;
+}
+
+void UpdateInfo() {
+    std::vector<std::string> lines;
+    if (g.connected) {
+        lines.push_back("Fighters: " + std::to_string(CountReceived(kFighter)) +
+                        "   Star Punches: " + std::to_string(std::min(3, CountReceived(kStarPunch))) +
+                        "   Checks: " + std::to_string(g.checkedServer.size()) + " done, " + std::to_string(g.missing.size()) + " left");
+        lines.push_back(std::string("Death link: ") + (g.deathLinkTag ? "on" : "off") +
+                        (g.deathsPending ? "  (" + std::to_string(g.deathsPending) + " waiting)" : "") +
+                        (g.finishedGame ? "   Goal complete!" : ""));
+        lines.push_back("Difficulty is held at Normal while connected.");
+    }
+    std::lock_guard<std::mutex> lock(g.mutex);
+    g.info = std::move(lines);
+}
+
+} // namespace ap_client
+
+void ClientStart(const std::string& server, const std::string& slot, const std::string& password) {
+    using namespace ap_client;
+    SessionSettings s;
+    s.server = server;
+    s.slot = slot;
+    s.password = password;
+    s.game = kGameName;
+    s.itemsHandling = 0b111;
+    g.running = true;
+    Session::Get().Start(s);
+    Session::Get().LogText("Archipelago: connecting to " + server + " as " + slot + "...", kNote);
+}
+
+void ClientStop() {
+    using namespace ap_client;
+    g.running = false;
+    Session::Get().Stop();
+    RuntimeConfigFile::SetArchipelagoConnected(false);
+}
+
+bool ClientActive() {
+    using namespace ap_client;
+    return Session::Get().State() != SessionState::Off;
+}
+
+std::vector<std::string> ClientInfoLines() {
+    using namespace ap_client;
+    std::lock_guard<std::mutex> lock(g.mutex);
+    return g.info;
+}
+
+} // namespace PunchOutAp
+
+// Once per game frame, on the game thread (punchout_frame.cpp).
+extern "C" void PunchOut_ArchipelagoFrame() {
+    using namespace PunchOutAp;
+    using namespace PunchOutAp::ap_client;
+    if (!g.running) {
+        if (GameActive()) GameRelease();
+        return;
+    }
+    Json event;
+    while (Session::Get().PopEvent(event)) OnEvent(event);
+    if (!g.connected && GameActive() && Session::Get().State() == SessionState::Off) GameRelease();
+    ++g.frame;
+    if (!g.connected) return;
+    ApplySeed();
+    if (!g.fastPoll && g.frame % 6 != 0) return;
+    GameTick(Now());
+    if (g.frame % 30 == 0) UpdateInfo();
+}
diff --git a/runtime/src/hle/punchout_ap_client.h b/runtime/src/hle/punchout_ap_client.h
