+// Time until the earliest queued guest alarm (the queue is kept sorted by fire time). Lets the
+// scheduler's idle wait wake exactly when OSSleepTicks/OSSetAlarm asked, instead of on its 1 ms poll.
+extern "C" bool OS_HLE_NextAlarmDelay(int64_t* outNanoseconds)
+{
+    try {
+        const uint32_t alarm = ::Memory::Read32(kAlarmQueueAddr);
+        if (alarm == 0) {
+            return false;
+        }
+        const uint64_t fireTime = (static_cast<uint64_t>(::Memory::Read32(alarm + kAlarmFireTimeHiOffset)) << 32) |
+                                  ::Memory::Read32(alarm + kAlarmFireTimeLoOffset);
+        const uint64_t now = OsHleInternal::ReadSystemTime();
+        *outNanoseconds = fireTime <= now ? 0 : TimeBaseContract::TicksToDuration(fireTime - now).count();
+        return true;
+    } catch (const ::Memory::AccessViolation&) {
+        return false;
+    }
+}
