+// LegendOverlays update (vtable 80325788 slot +0xC, PO 80058B08; pseudo PAL 80FF0018) drives the glove: it counts
+// the active pointers in the cursor manager and the legends and shows the cursor layer when any is up:
+// *(*(*(0x80412FF0) + 0x98) + 0x48) = 1. In pad mode that byte goes back to 0 after the update (the pointer is only
+// used to identify boxes then, and the cursor manager is told what is selected directly).
+extern "C" void PunchOut_LegendOverlaysUpdate_pseudo(CpuContext* ctx) {
+    MKW_GUEST_FUNC(80FF0018)(ctx);
+    if (g_mem1 == nullptr || !g_padMode.load(std::memory_order_relaxed) || !g_menuActive.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const uint32_t owner = R32(0x80412FF0u);
+    const uint32_t layer = IsPtr(owner) ? R32(owner + 0x98u) : 0u;
+    if (IsPtr(layer) && InMem1(layer + 0x48u, 1)) g_mem1[layer + 0x48u - kMem1] = 0;
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0018, PunchOut_LegendOverlaysUpdate_pseudo, "PunchOut_LegendOverlaysUpdate_pseudo");
+
