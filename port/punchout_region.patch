+// ---- buttons ----
+uint32_t g_frameNow = 0;
+bool g_noExtras = false;
+constexpr uint32_t kHashHitRegion = 0xA45EB2A8u;
+constexpr uint32_t kPlayFeHover = 0x299E2156u; // 698229078
+constexpr uint32_t kIdNavLeft = FeHash("Nav_LeftButton");
+constexpr uint32_t kIdNavRight = FeHash("Nav_RightButton");
+[[maybe_unused]] constexpr uint32_t kIdCircuitSelect = FeHash("CircuitSelectButton");
+
+bool IsButton(uint32_t b) {
+    if (!InMem1(b, 0x1C) || (b & 3u)) return false;
+    const uint32_t vt = R32(b);
+    if (vt < 0x80300000u || vt >= 0x80380000u || R8(b + 4u) != 1u || R32(b + 0xCu) > 4u) return false;
+    const uint32_t sounds = R32(b + 0x14u);
+    return IsPtr(sounds) && R32(sounds + 4u) == kPlayFeHover;
+}
+
+struct Button {
+    uint32_t addr = 0, inst = 0, id = 0, state = 0, hit = 0;
+    bool navBar = false;
+    bool sounds = false; // plays Play_FE_Hover when highlighted
+    bool extra = false;  // a bare Hit Region (no button object, so no state to check)
+    bool fixed = false;  // a bottom-bar stand-in at the bar's fixed place
+    bool geom = false;
+    float cx = 0, cy = 0, hw = 0, hh = 0, sx = 0;
+    std::string name;
+    bool Contains(float x, float y) const { return geom && std::fabs(x - cx) <= hw && std::fabs(y - cy) <= hh; }
+    bool Big() const { return hw * 2.f >= 0.2f; }
+};
+
+// The first usable live Hit Region in the instance's subtree: children follow the instance in memory, up to the
+// next button's instance (`limit`). Slide copies of a region can sit off screen (slide-in keyframes); skip those.
+void Locate(Button& b, uint32_t limit) {
+    b.geom = false;
+    if (!IsPtr(b.inst)) return;
+    limit = std::min(limit, b.inst + 0x20000u);
+    for (uint32_t a = b.inst + 0x48u, tries = 0; a < limit && tries < 48; a += 4u) {
+        if (R32(a) != kHashHitRegion || !IsNamed(a)) continue;
+        ++tries;
+        if (R32(a + 0x60u) != 1u) continue;
+        const float sx = RF(a + 0x68u), sy = RF(a + 0x68u + 20u), tx = RF(a + 0x68u + 48u), ty = RF(a + 0x68u + 52u);
+        if (!std::isfinite(sx) || !std::isfinite(sy) || !std::isfinite(tx) || !std::isfinite(ty)) continue;
+        Button c = b;
+        c.hit = a;
+        c.sx = sx;
+        c.cx = tx;
+        c.cy = -ty;
+        c.hw = std::fabs(sx) * 0.5f;
+        c.hh = std::fabs(sy) * 0.5f;
+        c.geom = c.hw > 0.01f && c.hw < 0.8f && c.hh > 0.01f && c.hh < 1.0f && std::fabs(c.cx) <= 1.0f &&
+                 std::fabs(c.cy) <= 1.0f && c.hw * c.hh * 4.f <= 0.6f;
+        if (!c.geom) {
+            if (b.hit == 0) b = c; // keep the first one for the log if none is usable
+            continue;
+        }
+        // Several usable ones (slide copies share a place; a carousel like the hub's fighters does not): take the
+        // one nearest the screen centre, where a carousel puts its current entry.
+        if (!b.geom || std::fabs(c.cx) + std::fabs(c.cy) < std::fabs(b.cx) + std::fabs(b.cy)) b = c;
+    }
+}
+
+std::vector<Button> g_buttons;     // every button found on the active screen and the bottom bar
+std::vector<Button> g_targets;     // the ones you can go to: on screen, enabled, deduplicated
+std::vector<std::pair<uint32_t, uint32_t>> g_subtrees; // [instance, end) of every button found
+
+// Clickables without a button object (hub fighter portraits, Exhibition's circuit column, gallery entries): every
+// live Hit Region in the screen's own FENL copy (the heap block holding its buttons' instances) that is not inside
+// a button's subtree. Block found once per screen, its hit regions listed every 60 frames.
+struct ExtraScan {
+    bool guessed = false, logged = false;
+    uint32_t pres = 0, start = 0, end = 0, frame = 0;
+    std::vector<uint32_t> hits;
+} g_extra;
+
+// The heap block holding `addr`: walk back to a block header ([-8] = 0x80000000 | size, [-4] = a heap pointer in
+// .bss/.data, e.g. 803A4570) whose block covers addr. Returns the start; g_extra.end gets the end.
+uint32_t HeapBlockOf(uint32_t addr) {
+    for (uint32_t b = addr & ~3u; b > addr - 0x200000u && b > kMem1 + 8u; b -= 4u) {
+        const uint32_t tag = R32(b - 4u);
+        if (tag < 0x80300000u || tag >= 0x80500000u) continue;
+        const uint32_t header = R32(b - 8u);
+        const uint32_t size = header & 0x7FFFFFFFu;
+        if ((header & 0x80000000u) && size >= 0x400u && size < 0x800000u && b + size > addr) {
+            g_extra.end = b + size;
+            return b;
+        }
+    }
+    return 0;
+}
+
+void AddButton(uint32_t addr, bool navBar) {
+    for (const auto& b : g_buttons) {
+        if (b.addr == addr) return;
+    }
+    if (g_buttons.size() >= 96) return;
+    Button b;
+    b.addr = addr;
+    b.inst = R32(addr + 8u);
+    b.state = R32(addr + 0xCu);
+    b.id = R32(addr + 0x10u);
+    b.sounds = R8(addr + 0x18u) != 0;
+    b.navBar = navBar;
+    g_buttons.push_back(std::move(b));
+}
+
+// Buttons embedded in the screen object, and ones it points at (one level).
+void CollectButtons(uint32_t obj, bool navBar) {
+    if (!IsPtr(obj)) return;
+    // The heap block header right before an object: word -8 = 0x80000000 | size (Hub 0xCC, Profile_Select 0x284,
+    // Exhibition 0x3B4, Main_Menu_Options 0x9C). Without one, look at 0x800 bytes.
+    const uint32_t header = R32(obj - 8u);
+    const uint32_t size = header & 0x7FFFFFFFu;
+    const uint32_t window = (header & 0x80000000u) && size >= 0x20u && size <= 0x4000u ? size : 0x800u;
+    for (uint32_t o = 0; o + 4u <= window; o += 4u) {
+        const uint32_t a = obj + o;
+        // Another screen object right after this one (a closed popup's memory, say): stop.
+        if (o > 0 && R32(a) >= 0x80300000u && R32(a) < 0x80380000u && NameOf(R32(a + 4u)) != nullptr) break;
+        if (IsButton(a)) {
+            AddButton(a, navBar);
+            continue;
+        }
+        const uint32_t p = R32(a);
+        if (p != obj && IsPtr(p) && p >= 0x80400000u && IsButton(p)) AddButton(p, navBar);
+    }
+}
