+    std::sort(top.begin(), top.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+    const double idleMs = g_punchOutIdleMicros.exchange(0) / 1000.0;
+    const uint32_t reads = g_punchOutDvdReads.exchange(0);
