+
+void HsvToRgb(double h, uint8_t out[3]) {
+    const double i = std::floor(h * 6), f = h * 6 - i, q = 1 - f;
+    double r = 0, gg = 0, b = 0;
+    switch (static_cast<int>(i) % 6) {
+    case 0: r = 1; gg = f; b = 0; break;
+    case 1: r = q; gg = 1; b = 0; break;
+    case 2: r = 0; gg = 1; b = f; break;
+    case 3: r = 0; gg = q; b = 1; break;
+    case 4: r = f; gg = 0; b = 1; break;
+    default: r = 1; gg = 0; b = q; break;
+    }
+    out[0] = uint8_t(std::lround(r * 255));
+    out[1] = uint8_t(std::lround(gg * 255));
+    out[2] = uint8_t(std::lround(b * 255));
+}
+void RainbowRgb(double now, double offset, uint8_t out[3]) {
+    HsvToRgb(std::fmod(now / 1.5 + offset, 1.0), out);
+}
+std::optional<std::pair<uint32_t, bool>> FindTiredColours() {
+    uint8_t swapped[100];
+    for (int i = 0; i < 100; i += 4) {
+        for (int k = 0; k < 4; ++k) swapped[i + k] = kTiredColours[i + 3 - k];
+    }
+    for (auto [start, size] : {std::pair<uint32_t, uint32_t>{kMem1, kMem1Size}, {kMem2, kMem2Size}}) {
+        const uint8_t* base = Ram(start, size);
+        if (!base) continue;
+        for (const auto& [table, alphaFirst] : {std::pair<const uint8_t*, bool>{kTiredColours, false}, {swapped, true}}) {
+            for (uint32_t at = 0; at + 100 <= size; at += 4) {
+                if (base[at] == table[0] && std::memcmp(base + at, table, 100) == 0) return std::make_pair(start + at, alphaFirst);
+            }
+        }
+    }
+    return std::nullopt;
+}
+bool TiredColoursLookRight(uint32_t addr, bool af) {
+    uint8_t cur[100];
+    if (!ReadBytes(addr, cur, 100)) return false;
+    for (int i = 0; i < 100; i += 4) {
+        if (cur[i + (af ? 0 : 3)] != kTiredColours[i + 3]) return false;
+    }
+    return true;
+}
+void SuperMacRainbow(double now, bool on) {
+    if (on) {
+        uint8_t rgb[3];
+        RainbowRgb(now, 0, rgb);
+        for (int i = 0; i < 3; ++i) W8(kTiredTint + i, rgb[i]);
+        g.tintChanged = true;
+    } else if (g.tintChanged) {
+        W8(kTiredTint, 0xCC);
+        W8(kTiredTint + 1, 0x33);
+        W8(kTiredTint + 2, 0xFF);
+        g.tintChanged = false;
+    }
+    if (g.tiredColours && !TiredColoursLookRight(g.tiredColours->first, g.tiredColours->second)) {
+        g.tiredColours.reset();
+        g.coloursChanged = false;
+    }
+    if (!on) {
+        if (g.coloursChanged && g.tiredColours) {
+            for (int i = 0; i < 100; i += 4) {
+                for (int k = 0; k < 4; ++k) {
+                    W8(g.tiredColours->first + i + k, g.tiredColours->second ? kTiredColours[i + 3 - k] : kTiredColours[i + k]);
+                }
+            }
+        }
+        g.coloursChanged = false;
+        return;
+    }
+    if (!g.tiredColours) {
+        if (g.coloursSearchedAt && now - *g.coloursSearchedAt < 20) return;
+        g.coloursSearchedAt = now;
+        g.tiredColours = FindTiredColours();
+        if (!g.tiredColours) {
+            if (!g.coloursMissingLogged) {
+                g.coloursMissingLogged = true;
+                Log("(Couldn't find the tired effect's colours in memory, so Super Mac shows it in its normal colours. "
+                    "Everything else works.)", kNote);
+            }
+            return;
+        }
+    }
+    for (int i = 0; i < 25; ++i) {
+        uint8_t rgb[3];
+        RainbowRgb(now, 0.6 * i / 25, rgb);
+        const uint8_t a = kTiredColours[i * 4 + 3];
+        const uint32_t at = g.tiredColours->first + uint32_t(i) * 4;
+        if (g.tiredColours->second) {
+            W8(at, a); W8(at + 1, rgb[2]); W8(at + 2, rgb[1]); W8(at + 3, rgb[0]);
+        } else {
+            W8(at, rgb[0]); W8(at + 1, rgb[1]); W8(at + 2, rgb[2]); W8(at + 3, a);
+        }
+    }
+    g.coloursChanged = true;
+}
+
+void SuperMacTick(bool inFight, double now, double elapsed, std::optional<uint32_t> star) {
+    if (!inFight || !ReadyToWrite() || !star) {
+        if (g.superMacSecondsLeft > 0) {
+            Log("Super Mac wore off.", kNote);
+            g.superMacSecondsLeft = 0;
+        }
+    } else {
+        const bool playable = RoundPlayable(now);
+        float health = GetHealth(*star);
+        const bool standing = !Bad(health) && health > 0.01f && health <= 1000;
+        if (g.superMacSecondsLeft <= 0 && playable && standing && !g.deathActive && Handled(kSuperMac) >= 0 &&
+            Waiting(kSuperMac) > 0 && MayGoOff(kSuperMac, Handled(kSuperMac))) {
+            WentOff(kSuperMac);
+            MarkSome(kSuperMac, 1);
+            g.superMacSecondsLeft = kSuperMacSeconds;
+            const long long w = Waiting(kSuperMac);
+            Log(std::string("Let's-a-Go!") + (w > 0 ? " (" + std::to_string(w) + " more Super Macs waiting)" : ""), kGood);
+        }
+        if (g.superMacSecondsLeft > 0 && playable) {
+            const double step = std::min(elapsed, g.superMacSecondsLeft);
+            g.superMacSecondsLeft -= step;
+            if (standing && !g.deathActive && health < 99.89f) {
+                SetHealth(*star, std::min(kMaxHealth, health + kSuperMacRegen * static_cast<float>(step)));
+            }
+            if (g.superMacSecondsLeft < 0.001) {
+                g.superMacSecondsLeft = 0;
+                Log("Super Mac wore off.", kNote);
+            }
+        }
+    }
+    const uint32_t wanted = g.superMacSecondsLeft > 0 ? 1u : 0u;
+    if (R32(kSuperMacFlag) != wanted) W32(kSuperMacFlag, wanted);
+    SuperMacRainbow(now, wanted != 0);
+}
