+#pragma once
+
+// Punch-Out!!'s controls: which keyboard keys, mouse buttons and controller buttons press each button of the
+// emulated Wii Remote (held sideways). Saved in Config.toml [punchout_controls]; the launcher edits the same keys.
+
+#include <cstddef>
+#include <string>
+
+struct SDL_Gamepad;
+
+namespace PunchOutControls {
+
+// Directions are as the player sees them on screen (the remote is held sideways). PagePrev / PageNext are not remote
+// buttons: they turn menu pages, like a controller's bumpers (punchout_menu.cpp).
+enum Control : size_t { Up, Down, Left, Right, One, Two, A, B, Plus, Minus, PagePrev, PageNext, kControlCount };
+
+// Each control has two keyboard slots and two controller slots.
+enum Slot : size_t { Key1, Key2, Pad1, Pad2, kSlotCount };
+
+constexpr int kUnbound = -1;
+// Keyboard slots: an SDL scancode, or kMouseBase + an SDL mouse button (1 left, 2 middle, 3 right, 4/5 side).
+constexpr int kMouseBase = 1000;
+// Controller slots: an SDL gamepad button, or kTriggerBase + SDL_GAMEPAD_AXIS_LEFT_TRIGGER / RIGHT_TRIGGER.
+constexpr int kTriggerBase = 100;
+
+void Reload();
+int Binding(size_t control, size_t slot);
+void SetBinding(size_t control, size_t slot, int code); // also saves it
+void ResetDefaults();                                   // also saves them
+
+const char* ControlName(size_t control);   // "Up"
+const char* ControlAction(size_t control); // "Block (with a punch: punch to the face)"
+std::string KeyName(int code);             // "J", "Mouse Left", "" when unbound
+std::string PadName(int code);             // "A / Cross", "" when unbound
+
+// Keyboard and mouse slots (only while the game window has the focus).
+bool KeyHeld(size_t control);
+// Controller slots on the given gamepad (nullptr: false).
+bool PadHeld(size_t control, SDL_Gamepad* gamepad);
+
+bool LockMouse();
+void SetLockMouse(bool value); // also saves it
+
+} // namespace PunchOutControls
