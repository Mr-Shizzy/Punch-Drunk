+// ---------------------------------------------------------------------------------------------------------------
+// The prompt art that follows the controls: the fight's mash prompts ("1", "2") and the "Press A" icon show the
+// button or key the player actually bound (PunchOutControls), drawn into 256x256 RGBA textures when the game starts
+// and again whenever the bindings or the device change, and registered over the texture pack (higher priority).
+// Controller buttons use the glyph art (assets/glyphs/<style>/<button>.png, every button including bumpers and
+// triggers); keys are drawn as keycaps with the banner's font. Mash prompts are 74% of the canvas, like the pack's.
+
+struct Rgba {
+    int w = 0, h = 0;
+    std::vector<uint8_t> px; // straight alpha
+};
+
+Rgba LoadPng(const std::string& path) {
+    Rgba img;
+    int n = 0;
+    stbi_uc* data = stbi_load(path.c_str(), &img.w, &img.h, &n, 4);
+    if (data == nullptr) return {};
+    img.px.assign(data, data + static_cast<size_t>(img.w) * img.h * 4);
+    stbi_image_free(data);
+    return img;
+}
+
+std::string AssetPath(const std::string& rel) {
+    const char* base = SDL_GetBasePath();
+    return std::string(base ? base : "") + rel;
+}
+
+// Source-over of one straight-alpha color with coverage a (0..1) onto dst pixel i.
+void Over(Rgba& dst, size_t i, float r, float g, float b, float a) {
+    if (a <= 0.f) return;
+    uint8_t* d = &dst.px[i * 4];
+    const float da = d[3] / 255.f;
+    const float oa = a + da * (1.f - a);
+    if (oa <= 0.f) return;
+    const auto mix = [&](float s, uint8_t dc) { return (s * a + dc / 255.f * da * (1.f - a)) / oa; };
+    d[0] = static_cast<uint8_t>(std::lround(std::clamp(mix(r, d[0]), 0.f, 1.f) * 255.f));
+    d[1] = static_cast<uint8_t>(std::lround(std::clamp(mix(g, d[1]), 0.f, 1.f) * 255.f));
+    d[2] = static_cast<uint8_t>(std::lround(std::clamp(mix(b, d[2]), 0.f, 1.f) * 255.f));
+    d[3] = static_cast<uint8_t>(std::lround(std::clamp(oa, 0.f, 1.f) * 255.f));
+}
+
+// src scaled (bilinear, premultiplied) to fit a box x box square centred on the canvas.
+void BlitFit(Rgba& dst, const Rgba& src, float box) {
+    if (src.w <= 0 || src.h <= 0) return;
+    const float scale = box / static_cast<float>(std::max(src.w, src.h));
+    const float w = src.w * scale, h = src.h * scale;
+    const float x0 = (dst.w - w) * 0.5f, y0 = (dst.h - h) * 0.5f;
+    for (int y = 0; y < dst.h; ++y) {
+        for (int x = 0; x < dst.w; ++x) {
+            const float sx = (x + 0.5f - x0) / scale - 0.5f, sy = (y + 0.5f - y0) / scale - 0.5f;
+            if (sx < -1.f || sy < -1.f || sx > src.w || sy > src.h) continue;
+            float acc[4] = {};
+            const int ix = static_cast<int>(std::floor(sx)), iy = static_cast<int>(std::floor(sy));
+            const float fx = sx - ix, fy = sy - iy;
+            for (int k = 0; k < 4; ++k) {
+                const int px = ix + (k & 1), py = iy + (k >> 1);
+                if (px < 0 || py < 0 || px >= src.w || py >= src.h) continue;
+                const float wgt = ((k & 1) ? fx : 1.f - fx) * ((k >> 1) ? fy : 1.f - fy);
+                const uint8_t* p = &src.px[(static_cast<size_t>(py) * src.w + px) * 4];
+                const float a = p[3] / 255.f;
+                acc[0] += p[0] / 255.f * a * wgt;
+                acc[1] += p[1] / 255.f * a * wgt;
+                acc[2] += p[2] / 255.f * a * wgt;
+                acc[3] += a * wgt;
+            }
+            if (acc[3] <= 0.f) continue;
+            Over(dst, static_cast<size_t>(y) * dst.w + x, acc[0] / acc[3], acc[1] / acc[3], acc[2] / acc[3], acc[3]);
+        }
+    }
+}
+
+// Coverage of a rounded rectangle (centre cx, cy; half size hw, hh; corner radius r) at pixel centre (x, y).
+float RoundRectCoverage(float x, float y, float cx, float cy, float hw, float hh, float r) {
+    const float qx = std::fabs(x - cx) - (hw - r), qy = std::fabs(y - cy) - (hh - r);
+    const float ox = std::max(qx, 0.f), oy = std::max(qy, 0.f);
+    const float d = std::sqrt(ox * ox + oy * oy) + std::min(std::max(qx, qy), 0.f) - r;
+    return std::clamp(0.5f - d, 0.f, 1.f);
+}
+
+void FillRoundRect(Rgba& dst, float cx, float cy, float hw, float hh, float r, float cr, float cg, float cb) {
+    for (int y = 0; y < dst.h; ++y) {
+        for (int x = 0; x < dst.w; ++x) {
+            const float c = RoundRectCoverage(x + 0.5f, y + 0.5f, cx, cy, hw, hh, r);
+            if (c > 0.f) Over(dst, static_cast<size_t>(y) * dst.w + x, cr, cg, cb, c);
+        }
+    }
+}
+
+// A filled triangle, 4x4 supersampled (the arrow keys' arrows).
+void FillTriangle(Rgba& dst, std::array<float, 6> t, float cr, float cg, float cb) {
+    const auto edge = [](float ax, float ay, float bx, float by, float px, float py) {
+        return (bx - ax) * (py - ay) - (by - ay) * (px - ax);
+    };
+    const float minX = std::min({t[0], t[2], t[4]}), maxX = std::max({t[0], t[2], t[4]});
+    const float minY = std::min({t[1], t[3], t[5]}), maxY = std::max({t[1], t[3], t[5]});
+    for (int y = std::max(0, static_cast<int>(minY)); y <= std::min(dst.h - 1, static_cast<int>(maxY)); ++y) {
+        for (int x = std::max(0, static_cast<int>(minX)); x <= std::min(dst.w - 1, static_cast<int>(maxX)); ++x) {
+            int inside = 0;
+            for (int s = 0; s < 16; ++s) {
+                const float px = x + (s % 4 + 0.5f) / 4.f, py = y + (s / 4 + 0.5f) / 4.f;
+                const float e0 = edge(t[0], t[1], t[2], t[3], px, py), e1 = edge(t[2], t[3], t[4], t[5], px, py),
+                            e2 = edge(t[4], t[5], t[0], t[1], px, py);
+                if ((e0 >= 0 && e1 >= 0 && e2 >= 0) || (e0 <= 0 && e1 <= 0 && e2 <= 0)) ++inside;
+            }
+            if (inside) Over(dst, static_cast<size_t>(y) * dst.w + x, cr, cg, cb, inside / 16.f);
+        }
+    }
+}
+
+struct KeyFont {
+    std::vector<uint8_t> ttf;
+    stbtt_fontinfo info{};
+    bool ok = false;
+};
+KeyFont& GetKeyFont() {
+    static KeyFont font;
+    static bool tried = false;
+    if (!tried) {
+        tried = true;
+        std::ifstream in(AssetPath("assets/fonts/OpenSans-SemiBold.ttf"), std::ios::binary);
+        font.ttf.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+        font.ok = !font.ttf.empty() && stbtt_InitFont(&font.info, font.ttf.data(), 0) != 0;
+    }
+    return font;
+}
+
+float TextWidth(KeyFont& f, const std::string& text, float scale) {
+    float w = 0.f;
+    for (size_t i = 0; i < text.size(); ++i) {
+        int adv = 0, lsb = 0;
+        stbtt_GetCodepointHMetrics(&f.info, static_cast<unsigned char>(text[i]), &adv, &lsb);
+        w += adv * scale;
+        if (i + 1 < text.size()) {
+            w += stbtt_GetCodepointKernAdvance(&f.info, static_cast<unsigned char>(text[i]),
+                                               static_cast<unsigned char>(text[i + 1])) * scale;
+        }
+    }
+    return w;
+}
+
+// White text centred on (cx, cy) at pixel height px.
+void DrawText(Rgba& dst, const std::string& text, float cx, float cy, float px) {
+    KeyFont& f = GetKeyFont();
+    if (!f.ok || text.empty()) return;
+    const float scale = stbtt_ScaleForPixelHeight(&f.info, px);
+    int ascent = 0, descent = 0, gap = 0;
+    stbtt_GetFontVMetrics(&f.info, &ascent, &descent, &gap);
+    int capX0 = 0, capY0 = 0, capX1 = 0, capY1 = 0; // centre on the capitals' height, not the full line
+    stbtt_GetCodepointBox(&f.info, 'H', &capX0, &capY0, &capX1, &capY1);
+    const float baseline = cy + capY1 * scale * 0.5f;
+    float x = cx - TextWidth(f, text, scale) * 0.5f;
+    for (size_t i = 0; i < text.size(); ++i) {
+        const int cp = static_cast<unsigned char>(text[i]);
+        int w = 0, h = 0, xoff = 0, yoff = 0;
+        const float sub = x - std::floor(x);
+        unsigned char* bmp = stbtt_GetCodepointBitmapSubpixel(&f.info, scale, scale, sub, 0.f, cp, &w, &h, &xoff, &yoff);
+        const int ox = static_cast<int>(std::floor(x)) + xoff, oy = static_cast<int>(std::lround(baseline)) + yoff;
+        for (int yy = 0; yy < h; ++yy) {
+            for (int xx = 0; xx < w; ++xx) {
+                const int tx = ox + xx, ty = oy + yy;
+                if (tx < 0 || ty < 0 || tx >= dst.w || ty >= dst.h) continue;
+                Over(dst, static_cast<size_t>(ty) * dst.w + tx, 1.f, 1.f, 1.f, bmp[yy * w + xx] / 255.f);
+            }
+        }
+        stbtt_FreeBitmap(bmp, nullptr);
+        int adv = 0, lsb = 0;
+        stbtt_GetCodepointHMetrics(&f.info, cp, &adv, &lsb);
+        x += adv * scale;
+        if (i + 1 < text.size()) x += stbtt_GetCodepointKernAdvance(&f.info, cp, static_cast<unsigned char>(text[i + 1])) * scale;
+    }
+}
+
+// A keycap in the glyphs' look (white rim, dark body, lighter top face): box = the cap's height; wide labels widen
+// the cap up to maxWidth, then shrink the text. arrow: 0 none, 1 up, 2 down, 3 left, 4 right.
+void DrawKeycap(Rgba& dst, float box, float maxWidth, const std::string& label, int arrow) {
+    KeyFont& f = GetKeyFont();
+    const float h = box * 0.84f;
+    float textPx = h * (label.size() <= 2 ? 0.48f : 0.40f);
+    const float textW = f.ok ? TextWidth(f, label, stbtt_ScaleForPixelHeight(&f.info, textPx)) : 0.f;
+    float w = std::max(h, textW + h * 0.55f);
+    if (w > maxWidth) {
+        textPx *= (maxWidth - h * 0.55f) / std::max(1.f, textW);
+        w = maxWidth;
+    }
+    const float cx = dst.w * 0.5f, cy = dst.h * 0.5f, r = h * 0.22f;
+    FillRoundRect(dst, cx, cy, w * 0.5f, h * 0.5f, r, 1.f, 1.f, 1.f);                         // rim
+    const float rim = h * 0.05f;
+    FillRoundRect(dst, cx, cy, w * 0.5f - rim, h * 0.5f - rim, r - rim * 0.6f, 0.17f, 0.17f, 0.18f); // body / lip
+    const float topH = (h - rim * 2.f) * 0.80f, inset = h * 0.07f;                            // top face, raised
+    const float topCy = cy - h * 0.5f + rim + inset * 0.6f + topH * 0.5f;
+    FillRoundRect(dst, cx, topCy, w * 0.5f - rim - inset, topH * 0.5f - inset * 0.4f, r * 0.7f, 0.27f, 0.27f, 0.29f);
+    if (arrow != 0) {
+        const float a = h * 0.17f;
+        std::array<float, 6> t{};
+        switch (arrow) {
+        case 1: t = {cx, topCy - a, cx - a, topCy + a * 0.7f, cx + a, topCy + a * 0.7f}; break;
+        case 2: t = {cx, topCy + a, cx - a, topCy - a * 0.7f, cx + a, topCy - a * 0.7f}; break;
+        case 3: t = {cx - a, topCy, cx + a * 0.7f, topCy - a, cx + a * 0.7f, topCy + a}; break;
+        default: t = {cx + a, topCy, cx - a * 0.7f, topCy - a, cx - a * 0.7f, topCy + a}; break;
+        }
+        FillTriangle(dst, t, 1.f, 1.f, 1.f);
+    } else {
+        DrawText(dst, label, cx, topCy, textPx);
+    }
+}
+
+// The keycap text for a key binding, and its arrow (0 for none).
+std::string KeycapLabel(int code, int& arrow) {
+    arrow = 0;
+    switch (code) {
+    case SDL_SCANCODE_UP: arrow = 1; return "";
+    case SDL_SCANCODE_DOWN: arrow = 2; return "";
+    case SDL_SCANCODE_LEFT: arrow = 3; return "";
+    case SDL_SCANCODE_RIGHT: arrow = 4; return "";
+    case SDL_SCANCODE_RETURN: return "Enter";
+    case SDL_SCANCODE_BACKSPACE: return "Back";
+    case SDL_SCANCODE_CAPSLOCK: return "Caps";
+    case SDL_SCANCODE_PAGEUP: return "PgUp";
+    case SDL_SCANCODE_PAGEDOWN: return "PgDn";
+    case SDL_SCANCODE_INSERT: return "Ins";
+    case SDL_SCANCODE_DELETE: return "Del";
+    case SDL_SCANCODE_LSHIFT: case SDL_SCANCODE_RSHIFT: return "Shift";
+    case SDL_SCANCODE_LCTRL: case SDL_SCANCODE_RCTRL: return "Ctrl";
+    case SDL_SCANCODE_LALT: case SDL_SCANCODE_RALT: return "Alt";
+    case SDL_SCANCODE_LGUI: case SDL_SCANCODE_RGUI: return "Super";
+    case PunchOutControls::kMouseBase + 1: return "LMB";
+    case PunchOutControls::kMouseBase + 2: return "MMB";
+    case PunchOutControls::kMouseBase + 3: return "RMB";
+    case PunchOutControls::kMouseBase + 4: return "M4";
+    case PunchOutControls::kMouseBase + 5: return "M5";
+    default: break;
+    }
+    std::string name = PunchOutControls::KeyName(code);
+    if (name.rfind("Keypad ", 0) == 0) name = "Num" + name.substr(7);
+    return name;
+}
