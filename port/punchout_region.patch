+void HeartTraps(bool inFight, double now, uint32_t star, double elapsed) {
+    if (g.heartTrapsHandled >= 0) {
+        const long long received = CountReceived(kHeartTrap);
+        const long long waiting = received - g.heartTrapsHandled;
+        long long started = 0;
+        if (waiting > 0 && inFight && RoundPlayable(now) && !SuperMacOn()) {
+            while (g.heartTrapsHandled < received && MayGoOff(kHeartTrap, g.heartTrapsHandled)) {
+                WentOff(kHeartTrap);
+                ++g.heartTrapsHandled;
+                ++started;
+            }
+        }
+        if (started) {
+            g.heartTrapSecondsLeft += kHeartTrapSeconds * double(started);
+            g.heartTrapsAnnounced = std::max(g.heartTrapsAnnounced, g.heartTrapsHandled);
+            SaveHandled(HeartTrapsKey(), g.heartTrapsHandled);
+            char buf[96];
+            std::snprintf(buf, sizeof buf, "Heart Trap x%lld! Hearts held at 0 for %.0f seconds.", started, g.heartTrapSecondsLeft);
+            Log(buf, kBad);
+        } else if (waiting > 0 && received > g.heartTrapsAnnounced && !RoundPlayable(now)) {
+            g.heartTrapsAnnounced = received;
+            Log("Heart Trap x" + std::to_string(waiting) + " received. It hits once the round starts.", kNote);
+        }
+    }
+    if (g.heartTrapSecondsLeft > 0 && inFight && RoundPlayable(now) && !SuperMacOn()) {
+        KeepMacTired(star);
+        g.heartTrapSecondsLeft -= elapsed;
+        if (g.heartTrapSecondsLeft < 0.001) {
+            g.heartTrapSecondsLeft = 0;
+            Log("Heart Trap over. Catch your breath, Mac.", kGood);
+        }
+    }
+}
+
+long long ReadyCount(int64_t id) {
+    if (Handled(id) < 0) return 0;
+    long long n = 0;
+    while (n < Waiting(id) && MayGoOff(id, Handled(id) + n)) {
+        WentOff(id);
+        ++n;
+        const auto by = FoundBy(id, Handled(id) + n - 1);
+        if (by && *by == g.slot) break;
+    }
+    return n;
+}
