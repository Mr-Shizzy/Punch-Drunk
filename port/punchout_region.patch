+void HpZapTick(bool inFight, double now) {
+    if (!inFight || g.roundRestarted) g.hpZapUsedThisRound = false;
+    if (!inFight || !ReadyToWrite() || g.hpZapUsedThisRound) return;
+    const long long handled = Handled(kHpZap);
+    if (handled < 0 || Waiting(kHpZap) <= 0 || !RoundPlayable(now)) return;
+    const bool firstOfItem = handled % 3 == 0;
+    if (firstOfItem && !MayGoOff(kHpZap, handled / 3)) return;
+    const auto opp = FindOpponent();
+    uint32_t m = 0;
+    if (opp) {
+        m = R32(opp->first + 0xC4);
+        const float max = InWii(m) ? RF(m + 0x0C) : 0.0f;
+        if (!InWii(m) || Bad(max) || max < 1 || max > 1000) m = 0;
+    }
+    if (!m) {
+        if (!g.zapMissingLogged) {
+            g.zapMissingLogged = true;
+            Log("HP Zap is waiting: couldn't find your opponent's health.", kNote);
+        }
+        return;
+    }
+    const float max = RF(m + 0x0C), h = std::min(RF(m + 0x10), RF(m + 0x18));
+    if (Bad(h) || h <= 1.01f) return;
+    const float nh = std::max(1.0f, h - 0.10f * max);
+    WF(m + 0x18, nh);
+    WF(m + 0x10, nh);
+    RefreshHealthBar(true, opp->second);
+    if (firstOfItem) WentOff(kHpZap);
+    MarkSome(kHpZap, 1);
+    g.hpZapUsedThisRound = true;
+    const long long left = Waiting(kHpZap);
+    Log(std::string("HP Zap! -10% to your opponent.") + (left > 0 ? " (" + std::to_string(left) + " more zaps, one per round)" : ""), kGood);
+}
