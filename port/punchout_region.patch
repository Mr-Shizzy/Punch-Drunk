+// The file's name for the active screen (the generic dialog changes layout per question, so it is never written:
+// its links come from the positions every time).
+std::string ScreenKey() {
+    if (std::strcmp(g_activeName, "?") != 0) return g_activeName;
+    char buf[24];
+    std::snprintf(buf, sizeof buf, "screen_%08X", g_activeHash);
+    return buf;
+}
+bool Dynamic() {
+    return std::strcmp(g_activeName, "dialog") == 0;
+}
+LinkScreen g_live; // links from the latest map (the dialog always; other screens until they are recorded)
+LinkScreen* FileLinksFor(const std::string& name);
+// A screen whose camera moves (the career hubs turn around the ring to the chosen fighter): fixed links would point
+// the wrong way, so its links come from the latest map, like the dialog's.
+bool LiveScreen() {
+    // The hubs themselves (Hub_Minor_Circuit ...), not their results / loading screens.
+    if (std::strncmp(g_activeName, "Hub_", 4) == 0 && std::strstr(g_activeName, "Results") == nullptr &&
+        std::strstr(g_activeName, "Loading") == nullptr) {
+        return true;
+    }
+    const LinkScreen* sc = FileLinksFor(ScreenKey());
+    return sc != nullptr && sc->live;
+}
+
+LinkScreen* UserLinksFor(const std::string& name) {
+    for (auto& sc : g_links) {
+        if (sc.name == name) return &sc;
+    }
+    return nullptr;
+}
+LinkScreen* DefaultLinksFor(const std::string& name) {
+    for (auto& sc : g_defaults) {
+        if (sc.name == name) return &sc;
+    }
+    return nullptr;
+}
+// The links a screen goes by: the user's section, else the built-in one. Read only: changes go through
+// EditableLinksFor (the user's file).
+LinkScreen* FileLinksFor(const std::string& name) {
+    if (LinkScreen* sc = UserLinksFor(name)) return sc;
+    return DefaultLinksFor(name);
+}
+// The user's section for a screen, made from the built-in one (or empty) when there is none yet.
+LinkScreen* EditableLinksFor(const std::string& name) {
+    if (LinkScreen* sc = UserLinksFor(name)) return sc;
+    if (const LinkScreen* d = DefaultLinksFor(name)) {
+        g_links.push_back(*d);
+    } else {
+        g_links.push_back({name, {}, {}});
+    }
+    return &g_links.back();
+}
+LinkScreen* LinksFor(const std::string& name) {
+    if (!Dynamic() && !LiveScreen()) {
+        if (LinkScreen* sc = FileLinksFor(name)) return sc;
+    }
+    return g_live.buttons.empty() ? nullptr : &g_live;
+}
+
+LinkButton* LinkOf(LinkScreen* sc, uint32_t id) {
+    if (!sc) return nullptr;
+    for (auto& b : sc->buttons) {
+        if (b.id == id) return &b;
+    }
+    return nullptr;
+}
+
+const Entry* MapOf(uint32_t id) {
+    for (const auto& e : g_map) {
+        if (e.id == id) return &e;
+    }
+    return nullptr;
+}
+
+std::string OwnerOf(uint32_t screen) {
+    if (screen == g_activePres) return "screen";
+    for (const auto& n : g_navBars) {
+        if (n.addr == screen) return "bar";
+    }
+    return "other";
+}
