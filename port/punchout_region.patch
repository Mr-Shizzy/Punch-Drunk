+void RefreshTargets() {
+    g_buttons.clear();
+    g_targets.clear();
+    if (g_activePres == 0) return;
+    CollectButtons(g_activePres, false);
+    for (const auto& n : g_navBars) {
+        if (n.addr != g_activePres) CollectButtons(n.addr, true);
+    }
+    std::vector<uint32_t> insts;
+    for (const auto& b : g_buttons) {
+        if (IsPtr(b.inst)) insts.push_back(b.inst);
+    }
+    std::sort(insts.begin(), insts.end());
+    g_subtrees.clear();
+    for (auto& b : g_buttons) {
+        const auto next = std::upper_bound(insts.begin(), insts.end(), b.inst);
+        const uint32_t limit = std::min(next == insts.end() ? 0xFFFFFFFFu : *next, b.inst + 0x20000u);
+        Locate(b, limit);
+        if (IsPtr(b.inst)) g_subtrees.push_back({b.inst, limit});
+    }
+    // The bottom bar's buttons have no instance of their own (navigation_widescreen draws them); the screen's
+    // Nav_LeftButton / Nav_RightButton say whether they are there. Fixed places: LEFT (-253,-168) and RIGHT
+    // (258,-168) with 203x52 / 210x53 hit regions at x0.9, in 427 x 254 units.
+    for (auto& b : g_buttons) {
+        if (b.geom || b.navBar || b.state == 3u || (b.id != kIdNavLeft && b.id != kIdNavRight)) continue;
+        const bool left = b.id == kIdNavLeft;
+        b.geom = true;
+        b.fixed = true;
+        b.name = left ? "Back (bottom bar)" : "bottom bar right";
+        b.cx = left ? -0.588f : 0.608f;
+        b.cy = left ? 0.676f : 0.679f;
+        b.hw = left ? 0.214f : 0.221f;
+        b.hh = left ? 0.092f : 0.094f;
+        b.sx = 1.f;
+    }
+    std::vector<const Button*> order;
+    for (const auto& b : g_buttons) {
+        if (!b.fixed) order.push_back(&b);
+    }
+    for (const auto& b : g_buttons) {
+        if (b.fixed) order.push_back(&b);
+    }
+    const bool barRight = ScreenHasRight();
+    for (const Button* bp : order) {
+        const Button& b = *bp;
+        if (!b.geom || b.state == 3u) continue;
+        if (b.navBar && b.cx > 0.2f && !barRight) continue; // the bar's right button is not shown here
+        bool dup = false;
+        for (const auto& t : g_targets) {
+            if (t.inst == b.inst || (t.Contains(b.cx, b.cy) && b.Contains(t.cx, t.cy))) {
+                dup = true;
+                break;
+            }
+        }
+        if (!dup) g_targets.push_back(b);
+    }
+
+    // Extras.
+    if (g_noExtras) return;
+    if (g_extra.pres != g_activePres) {
+        g_extra = ExtraScan{};
+        g_extra.pres = g_activePres;
+        uint32_t lo = 0xFFFFFFFFu, hi = 0;
+        for (const auto& b : g_buttons) {
+            if (b.navBar || !IsPtr(b.inst)) continue;
+            lo = std::min(lo, b.inst);
+            hi = std::max(hi, b.inst);
+        }
+        if (hi != 0) {
+            g_extra.start = HeapBlockOf(lo);
+            // Only a block that is plausibly one menu file (<= 1 MB; Exhibition's is 580 KB) and holds all of the
+            // screen's instances; a whole heap arena would bring in other screens' leftovers.
+            if (g_extra.start == 0 || g_extra.end < hi || g_extra.end - g_extra.start > 0x100000u) {
+                g_extra.start = g_extra.end = 0;
+                g_extra.guessed = true;
+            }
+        }
+        g_extra.frame = 0;
+    }
+    if (g_extra.start != 0 && (g_extra.frame == 0 || g_frameNow - g_extra.frame >= 60)) {
+        g_extra.frame = g_frameNow | 1u;
+        g_extra.hits.clear();
+        for (uint32_t a = g_extra.start + 0x40u; a + 0xA8u < g_extra.end && g_extra.hits.size() < 400; a += 4u) {
+            if (R32(a) == kHashHitRegion && IsNamed(a)) g_extra.hits.push_back(a);
+        }
+        if (!g_extra.logged) {
+            g_extra.logged = true;
+            std::fprintf(stderr, "[nav] %s: own FENL copy %08X..%08X%s, %zu hit regions\n", g_activeName, g_extra.start,
+                         g_extra.end, g_extra.guessed ? " (guessed)" : "", g_extra.hits.size());
+        }
+    }
+    if (g_extra.start == 0 && !g_extra.logged && g_activePres != 0) {
+        g_extra.logged = true;
+        std::fprintf(stderr, "[nav] %s: no single heap block holds its menu file; extra hit regions off\n", g_activeName);
+    }
+    int extras = 0;
+    for (const uint32_t a : g_extra.hits) {
+        if (extras >= 48) break;
+        // (Hit regions of disabled buttons come in too, e.g. the hub's silhouetted fighters: they still show info
+        // when pointed at. The ones the game ignores never light up and are dropped below.)
+        if (R32(a + 0x60u) != 1u) continue;
+        Button e;
+        e.addr = a;
+        e.hit = a;
+        e.name = "extra";
+        const float sx = RF(a + 0x68u), sy = RF(a + 0x68u + 20u), tx = RF(a + 0x68u + 48u), ty = RF(a + 0x68u + 52u);
+        if (!std::isfinite(sx) || !std::isfinite(sy) || !std::isfinite(tx) || !std::isfinite(ty)) continue;
+        e.sx = sx;
+        e.cx = tx;
+        e.cy = -ty;
+        e.hw = std::fabs(sx) * 0.5f;
+        e.hh = std::fabs(sy) * 0.5f;
+        e.geom = e.hw > 0.02f && e.hw < 0.6f && e.hh > 0.02f && e.hh < 0.8f && std::fabs(e.cx) <= 0.98f &&
+                 std::fabs(e.cy) <= 0.98f && e.hw * e.hh * 4.f <= 0.4f;
+        if (!e.geom) continue;
+        bool dup = false;
+        for (const auto& t : g_targets) {
+            if ((t.Contains(e.cx, e.cy) && e.Contains(t.cx, t.cy)) ||
+                (std::fabs(t.cx - e.cx) < 0.03f && std::fabs(t.cy - e.cy) < 0.03f)) {
+                dup = true;
+                break;
+            }
+        }
+        if (dup) continue;
+        e.extra = true;
+        g_targets.push_back(e);
+        ++extras;
+    }
+}
