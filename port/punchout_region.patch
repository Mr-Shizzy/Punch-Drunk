+
+// wss:// through mbed TLS on every platform (Windows too: the runtime's own Schannel code is for the game's
+// network HLE; mbed TLS keeps this client one code path). The CA bundle is cacert.pem beside the executable.
+#define PO_AP_TLS 1
+#include <mbedtls/ctr_drbg.h>
+#include <mbedtls/entropy.h>
+#include <mbedtls/error.h>
