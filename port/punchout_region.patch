+const char* NameOf(uint32_t hash) {
+    for (const auto& s : kScreens) {
+        if (s.hash == hash) return s.name;
+    }
+    return nullptr;
+}
+
+constexpr uint32_t FeHash(const char* s) {
+    uint32_t h = 0xFFFFFFFFu;
+    for (; *s; ++s) {
+        uint32_t c = static_cast<uint8_t>(*s);
+        if (c >= 'A' && c <= 'Z') c |= 0x20;
+        h = h * 33u + c;
+    }
+    return h;
+}
+
+// ---- guest memory (MEM1 only: every FE object lives there) ----
+constexpr uint32_t kMem1 = 0x80000000u, kMem1Size = 0x01800000u;
+uint8_t* g_mem1 = nullptr;
+
+uint32_t Be32(const uint8_t* m) {
+    return (uint32_t(m[0]) << 24) | (uint32_t(m[1]) << 16) | (uint32_t(m[2]) << 8) | m[3];
+}
+bool InMem1(uint32_t a, uint32_t len = 4) {
+    return a >= kMem1 && a - kMem1 <= kMem1Size - len;
+}
+uint32_t R32(uint32_t a) {
+    return g_mem1 != nullptr && InMem1(a) ? Be32(g_mem1 + (a - kMem1)) : 0u;
+}
+uint8_t R8(uint32_t a) {
+    return g_mem1 != nullptr && InMem1(a, 1) ? g_mem1[a - kMem1] : 0u;
+}
+float RF(uint32_t a) {
+    const uint32_t v = R32(a);
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+bool IsPtr(uint32_t v) {
+    return v >= 0x80004000u && v < kMem1 + kMem1Size && (v & 3u) == 0;
+}
+
+// A 32-byte name field right before `hashAddr` whose FE hash is the word at `hashAddr`.
+bool IsNamed(uint32_t hashAddr, std::string* name = nullptr) {
+    if (!InMem1(hashAddr - 32u, 36)) return false;
+    const uint8_t* p = g_mem1 + (hashAddr - 32u - kMem1);
+    uint32_t h = 0xFFFFFFFFu;
+    size_t n = 0;
+    while (n < 31 && p[n] != 0) {
+        uint32_t c = p[n];
+        if (c < 32 || c > 126) return false;
+        if (c >= 'A' && c <= 'Z') c |= 0x20;
+        h = h * 33u + c;
+        ++n;
+    }
+    if (n < 2 || h != Be32(p + 32)) return false;
+    if (name) name->assign(reinterpret_cast<const char*>(p), n);
+    return true;
+}
