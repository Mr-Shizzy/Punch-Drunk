+// ---- difficulty (career fights) ----
+// [punchout] difficulty: normal / hard (no Restart in the fight's pause menu) / insane (no Restart, and Little Mac's
+// first knockdown is a knockout). Career only: a fight counts as career when it was reached from a career hub
+// screen (the game's own mode word is no longer "career" by the time the fight loads).
+std::atomic<int> g_difficulty{-1}; // -1 = not read yet, 0 normal, 1 hard, 2 insane
+std::atomic<bool> g_careerContext{false};
+constexpr uint32_t kIdRestart = 0x4F288A44u; // FeHash("Restart"): the pause menu's Restart button
+constexpr uint32_t kIdQuit = 0x002DDE02u;    // FeHash("Quit")
+int Difficulty() {
+    if (PunchOutAp::ClientActive()) return 0; // Archipelago: always Normal (the apworld's logic assumes it)
+    int d = g_difficulty.load(std::memory_order_relaxed);
+    if (d < 0) {
+        const std::string v = RuntimeConfigFile::Difficulty();
+        d = v == "insane" ? 2 : v == "hard" ? 1 : 0;
+        g_difficulty.store(d, std::memory_order_relaxed);
+        std::fprintf(stderr, "[difficulty] %s (career fights)\n", d == 2 ? "insane" : d == 1 ? "hard" : "normal");
+    }
+    return d;
+}
+bool RestartBlocked() {
+    return Difficulty() >= 1 && g_careerContext.load(std::memory_order_relaxed);
+}
