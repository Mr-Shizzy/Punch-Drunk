+// GXRedirectWriteGatherPipe: between it and GXRestoreWriteGatherPipe the game's stores to the gather
+// pipe (0xCC008000) go to memory at the redirect pointer instead of to the GPU. Punch-Out!! uses it
+// to fill buffers (8011E0F8). Only the game thread writes the pipe, so plain state is enough.
+static bool g_fifoRedirected = false;
+static uint32_t g_fifoRedirectPtr = 0;
+
+bool GxFifoRedirectWrite(uint32_t val, uint32_t sizeBytes) {
+    if (!g_fifoRedirected) {
+        return false;
+    }
+    try {
+        switch (sizeBytes) {
+        case 1: Memory::Write8(g_fifoRedirectPtr, static_cast<uint8_t>(val)); break;
+        case 2: Memory::Write16(g_fifoRedirectPtr, static_cast<uint16_t>(val)); break;
+        default: Memory::Write32(g_fifoRedirectPtr, val); sizeBytes = 4; break;
+        }
+    } catch (const Memory::AccessViolation&) {
+    }
+    g_fifoRedirectPtr += sizeBytes;
+    return true;
+}
