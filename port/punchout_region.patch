+void OnEvent(const Json& cmd) {
+    const std::string name = cmd.value("cmd", "");
+    if (name == "RoomInfo") {
+        g.seedName = cmd.value("seed_name", "");
+    } else if (name == "Connected") {
+        g.slot = cmd.value("slot", -1);
+        g.team = cmd.value("team", 0);
+        g.connected = true;
+        const Json sd = cmd.value("slot_data", Json::object());
+        g.goal = sd.value("goal", 1);
+        g.challengesRequired = sd.value("challenges_required", 20);
+        g.deathLink = sd.value("death_link", 0) != 0;
+        g.deathLinkSend = sd.value("death_link_send", 0);
+        g.deathLinkReceive = sd.value("death_link_receive", 0);
+        g.deathLinkSeconds = sd.value("death_link_seconds", 30.0);
+        g.moveUnlocks = sd.value("move_unlocks", 0) != 0;
+        g.connectedAt = Wall();
+        g.patchWarning.clear();
+        UpdateDeathLinkTag(g.deathLink);
+        const std::string session = g.seedName + "|" + std::to_string(g.slot);
+        if (session != g.sessionId) {
+            g.sessionId = session;
+            g.knownFighters = 0;
+            g.heartTrapSecondsLeft = 0;
+            g.clockTrapSecondsLeft = 0;
+        }
+        // The seed's fighter order: slot_data (apworld 1.6.1+), else the .appunchout file.
+        g.seed = GameSeedData{};
+        g.seed.seedTag = Crc32(session);
+        bool haveOrder = false;
+        Json order = sd.value("fighter_order", Json());
+        Json cosmetics = sd.value("cosmetics", Json());
+        std::string from = "the server";
+        if (!order.is_array()) {
+            const std::string file = RuntimeConfigFile::ArchipelagoPatchFile();
+            if (!file.empty()) {
+                if (const auto data = ReadPatchFile(file)) {
+                    if (data->value("seed_tag", 0u) != g.seed.seedTag) {
+                        Log("The patch file is from a different seed or slot (" + file + "). Using the normal fighter order.", kBad);
+                    } else {
+                        order = data->value("fighter_order", Json());
+                        cosmetics = data->value("cosmetics", Json());
+                        from = "the patch file";
+                    }
+                } else {
+                    Log("Couldn't read the patch file " + file + ".", kBad);
+                }
+            }
+        }
+        if (order.is_array() && order.size() == 26) {
+            haveOrder = true;
+            for (int i = 0; i < 26; ++i) {
+                const int b = order[i].get<int>();
+                g.seed.fighterOrder[i] = static_cast<uint8_t>((b >= 0 && b <= 25) || b == 27 ? b : i);
+            }
+        } else {
+            for (int i = 0; i < 26; ++i) g.seed.fighterOrder[i] = static_cast<uint8_t>(i);
+        }
+        if (cosmetics.is_object()) {
+            std::string problem;
+            ParseCosmetics(cosmetics.dump(), g.seed, problem);
+            if (!problem.empty()) Log("Cosmetics: " + problem, kNote);
+        }
+        if (!haveOrder) {
+            Log("This server's Punch-Out!! apworld doesn't send the fighter order. If the seed shuffles fighters, set the "
+                ".appunchout file in the Archipelago menu and reconnect.", kNote);
+        } else if (from != "the server") {
+            Log("Fighter order from " + from + ".", kNote);
+        }
+        g.seedReady = false;
+        ApplySeed();
+        std::vector<std::string> keys = {HeartTrapsKey()};
+        for (const auto& [id, n] : kOneShotNames) keys.push_back(OneShotKey(id));
+        Session::Get().Send({{"cmd", "Get"}, {"keys", keys}});
+        g.missing.clear();
+        g.checkedServer.clear();
+        for (const auto& v : cmd.value("missing_locations", Json::array())) g.missing.insert(v.get<int64_t>());
+        for (const auto& v : cmd.value("checked_locations", Json::array())) g.checkedServer.insert(v.get<int64_t>());
+        if (!g.checkedLocal.empty()) {
+            Session::Get().Send({{"cmd", "LocationChecks"}, {"locations", std::vector<int64_t>(g.checkedLocal.begin(), g.checkedLocal.end())}});
+        }
+        if (g.finishedGame) Session::Get().Send({{"cmd", "StatusUpdate"}, {"status", 30}});
+        RuntimeConfigFile::SetArchipelagoConnected(true);
+        Log("Connected. Load profile slot 6 (the randomizer profile) to play.", kGood);
+    } else if (name == "Retrieved") {
+        const Json keys = cmd.value("keys", Json::object());
+        if (keys.contains(HeartTrapsKey())) {
+            const Json& v = keys[HeartTrapsKey()];
+            g.heartTrapsHandled = v.is_number() ? v.get<long long>() : 0;
+        }
+        for (const auto& [id, n] : kOneShotNames) {
+            const std::string k = OneShotKey(id);
+            if (keys.contains(k)) g.handled[id] = keys[k].is_number() ? keys[k].get<long long>() : 0;
+        }
+    } else if (name == "ReceivedItems") {
+        const int index = cmd.value("index", 0);
+        if (index == 0) g.items.clear();
+        if (index != static_cast<int>(g.items.size())) {
+            Session::Get().Send({{"cmd", "Sync"}});
+            return;
+        }
+        for (const Json& it : cmd.value("items", Json::array())) {
+            g.items.push_back({it.value("item", int64_t(0)), it.value("player", 0)});
+        }
+        g.itemsSynced = true;
+    } else if (name == "RoomUpdate") {
+        for (const auto& v : cmd.value("checked_locations", Json::array())) {
+            g.checkedServer.insert(v.get<int64_t>());
+            g.missing.erase(v.get<int64_t>());
+        }
+    } else if (name == "Bounced") {
+        const Json tags = cmd.value("tags", Json::array());
+        if (std::find(tags.begin(), tags.end(), "DeathLink") == tags.end() || !g.deathLinkTag) return;
+        const Json data = cmd.value("data", Json::object());
+        const double time = data.value("time", 0.0);
+        if (time == g.lastDeathLink) return;
+        g.lastDeathLink = std::max(time, g.lastDeathLink);
+        const std::string source = data.value("source", "someone");
+        const std::string cause = data.value("cause", "");
+        Log(cause.empty() ? "DeathLink: Received from " + source : "DeathLink: " + cause, kBad);
+        ++g.deathsPending;
+        Log("Death link: " + source + " died. Little Mac will pay for it in the next round.", kBad);
+    } else if (name == "_Disconnected") {
+        g.lastCounter = -1;
+        g.itemsSynced = false;
+        g.connectedAt = 0;
+        g.heartTrapsHandled = -1;
+        g.heartTrapsAnnounced = 0;
+        g.handled.clear();
+        g.fightLoadedAt.reset();
+        g.seenGameOnce = false;
+        g.lastLossTotal.reset();
+        g.secondChancesFiredSeen.reset();
+        g.macDownsSeen.reset();
+        g.wrappersAnnounced = 0;
+        g.connected = false;
+    }
+}
