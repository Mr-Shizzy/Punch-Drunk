+uint32_t g_frontAny = 0;
+uint32_t g_dialogPres = 0; // the generic dialog (restart / quit / save prompts) when it is the newest presentation
+
+void FindScreens() {
+    g_navBars.clear();
+    g_dialogPres = 0;
+    Pres active;
+    uint32_t frontAny = 0;
+    uint32_t mgr = R32(kFeManagerPtr), head = 0, first = 0;
+    if (IsPtr(mgr) && IsPtr(head = R32(mgr + 4u)) && IsPtr(first = R32(head + 4u))) {
+        uint32_t node = first;
+        for (int n = 0; n < 64 && IsPtr(node); ++n) {
+            const uint32_t pres = R32(node);
+            if (IsPtr(pres)) {
+                const uint32_t hash = R32(pres + 4u);
+                if (IsNavBar(hash)) g_navBars.push_back({pres, hash});
+                if (frontAny == 0 && !IsNavBar(hash)) {
+                    frontAny = hash;
+                    if (hash == FeHash("art/fe/dialog")) g_dialogPres = pres;
+                }
+                if (active.addr == 0 && !IsResident(hash)) active = {pres, hash};
+            }
+            node = R32(node + 4u);
+            if (node == first) break;
+        }
+    }
+    const uint32_t stack = R32(kFeStackPtr);
+    const uint32_t depth = IsPtr(stack) ? R32(stack + 0x20u) : 0u;
+    if (depth > 0 && depth <= 16) {
+        const uint32_t pres = R32(stack + (depth - 1u) * 8u);
+        if (IsPtr(pres)) active = {pres, R32(pres + 4u)};
+    }
+    if (frontAny != g_frontAny) {
+        g_frontAny = frontAny;
+        static int frontLogs = 0;
+        if (frontLogs < 200) {
+            ++frontLogs;
+            const char* n = NameOf(frontAny);
+            std::fprintf(stderr, "[fe] newest loaded: %s\n", n ? n : "?");
+        }
+    }
+    g_activePres = active.addr;
+    g_activeHash = active.hash;
+    const char* name = NameOf(active.hash);
+    g_activeName = name ? name : (active.addr ? "?" : "(none)");
+}
