+    const int cur = Difficulty();
+    for (int i = 0; i < 3; ++i) {
+        char key[64];
+        std::snprintf(key, sizeof key, "difficulty_%s%s", kDifficultyNames[i], i == cur ? "_current" : "");
+        const uint32_t id = g_opt.sub ? FeHash(key) : g_opt.labelIds[i];
+        for (int k = 0; k < g_opt.labelCount[i]; ++k) setId(g_opt.labels[i][k], id);
+    }
+    for (int k = 0; k < 2; ++k) {
