+void OtherItems(bool inFight, double now, std::optional<uint32_t> star, std::optional<uint32_t> save, bool saveOk) {
+    if (inFight && RoundPlayable(now) && star) {
+        // Star Trap.
+        const long long st = Waiting(kStarTrap) > 0 && !SuperMacOn() ? ReadyCount(kStarTrap) : 0;
+        if (st) {
+            if (RF(*star) > 0.01f) W32(kStarTrapFlag, 1);
+            MarkSome(kStarTrap, st);
+            Log("Star Trap! Your stars are gone.", kBad);
+        }
+        float health = GetHealth(*star);
+        const bool standing = !Bad(health) && health > 0.01f && health <= 1000;
+        if (standing && !g.deathActive) {
+            const long long hp = Waiting(kHpTrap) > 0 && !SuperMacOn() ? ReadyCount(kHpTrap) : 0;
+            for (long long i = 0; i < hp; ++i) {
+                health = std::max(1.0f, health - kHpTrapDamage);
+                Log("HP Trap! -20 health.", kBad);
+            }
+            const long long w = Waiting(kWrapper);
+            long long eaten = 0;
+            while (eaten < w && health <= kMaxHealth - kHealAmount + 0.01f) {
+                health = std::min(kMaxHealth, health + kHealAmount);
+                ++eaten;
+                Log("Chocolate Bar Wrapper! A little sugar: +15% health.", kGood);
+            }
+            if (eaten || hp) SetHealth(*star, health);
+            if (eaten) MarkSome(kWrapper, eaten);
+            if (hp) MarkSome(kHpTrap, hp);
+            if (Waiting(kWrapper) > 0 && CountReceived(kWrapper) > g.wrappersAnnounced) {
+                g.wrappersAnnounced = CountReceived(kWrapper);
+                Log("Chocolate Bar Wrapper saved for later: it kicks in once you're missing 15% health.", kNote);
+            }
+        }
+    }
+    // Headgear.
+    if (saveOk && save) {
+        const uint8_t s = R8(*save + kHelmetState);
+        if (CountReceived(kHeadgear) == 0 && s != 0) {
+            W8(*save + kHelmetState, 0);
+            W8(*save + kHelmetMessage, 0);
+            Log("The game tried to unlock the Headgear, but you haven't found it yet. Locked again.", kNote);
+        } else if (CountReceived(kHeadgear) > 0 && s == 0) {
+            W8(*save + kHelmetState, 1);
+            W8(*save + kHelmetMessage, 1);
+            Log("Headgear found! Turn it on in the menu to use it.", kGood);
+        }
+    }
+}
