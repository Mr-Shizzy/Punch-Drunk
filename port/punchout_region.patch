+void ClockTrapTick(bool inFight, double now, double elapsed) {
+    const bool playable = inFight && ReadyToWrite() && RoundPlayable(now) && !SuperMacOn();
+    if (playable && Handled(kClockTrap) >= 0) {
+        long long started = 0;
+        while (Waiting(kClockTrap) > 0 && MayGoOff(kClockTrap, Handled(kClockTrap))) {
+            WentOff(kClockTrap);
+            g.handled[kClockTrap] += 1;
+            ++started;
+            const auto by = FoundBy(kClockTrap, Handled(kClockTrap) - 1);
+            if (by && *by == g.slot) break;
+        }
+        if (started) {
+            SaveHandled(OneShotKey(kClockTrap), Handled(kClockTrap));
+            g.clockTrapSecondsLeft += kClockTrapSeconds * double(started);
+            char buf[120];
+            std::snprintf(buf, sizeof buf, "Clock Trap%s! The round clock runs double speed for %.0f seconds.",
+                          started > 1 ? (" x" + std::to_string(started)).c_str() : "", g.clockTrapSecondsLeft);
+            Log(buf, kBad);
+        }
+    }
+    bool on = playable && g.clockTrapSecondsLeft > 0;
+    if (on) {
+        g.clockTrapSecondsLeft -= elapsed;
+        if (g.clockTrapSecondsLeft < 0.001) {
+            g.clockTrapSecondsLeft = 0;
+            on = false;
+            Log("Clock Trap over. The clock's back to normal.", kGood);
+        }
+    }
+    if (R32(kClockTrapFlag) != (on ? 1u : 0u)) W32(kClockTrapFlag, on ? 1u : 0u);
+}
