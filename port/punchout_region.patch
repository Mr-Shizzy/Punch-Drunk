+
+// Once per game frame (punchout_frame.cpp).
+extern "C" void PunchOut_MenuTick() {
+    ++g_frame;
+    if (g_mem1 == nullptr) {
+        try {
+            g_mem1 = static_cast<uint8_t*>(Memory::GetPointer(kMem1, kMem1Size));
+        } catch (...) {
+            g_mem1 = nullptr;
+        }
+        if (g_mem1 == nullptr) return;
+    }
+    const uint32_t before = g_activeHash;
+    FindScreens();
+    // The dialog (e.g. "Restart?" over the pause menu) is reused, not reloaded per screen: it is in front while it is
+    // the newest presentation and shows enabled buttons.
+    {
+        static uint32_t checkedAt = 0, checkedPres = 0;
+        static bool dialogUp = false;
+        if (g_dialogPres != 0 && g_dialogPres != g_activePres) {
+            if (g_dialogPres != checkedPres || g_frame - checkedAt >= 4) {
+                checkedPres = g_dialogPres;
+                checkedAt = g_frame;
+                const uint32_t savedPres = g_activePres;
+                g_activePres = g_dialogPres;
+                g_noExtras = true;
+                RefreshTargets();
+                g_noExtras = false;
+                dialogUp = !g_targets.empty();
+                g_activePres = savedPres;
+                g_lastRefresh = g_frame - 100; // the lists now hold the dialog's: rebuild them below
+            }
+            if (dialogUp) {
+                g_activePres = g_dialogPres;
+                g_activeHash = FeHash("art/fe/dialog");
+                g_activeName = "dialog";
+            }
+        } else {
+            dialogUp = false;
+        }
+    }
+    if (g_activeHash != before) {
+        // Career or not: decided by the menus the fight is reached from.
+        if (std::strncmp(g_activeName, "Hub_", 4) == 0 || std::strncmp(g_activeName, "hub_", 4) == 0) {
+            if (!g_careerContext.exchange(true)) std::fprintf(stderr, "[difficulty] career context\n");
+        } else if (std::strncmp(g_activeName, "Exhibition", 10) == 0 || std::strstr(g_activeName, "H2H") != nullptr ||
+                   std::strcmp(g_activeName, "FE_Menu_Screen") == 0) {
+            if (g_careerContext.exchange(false)) std::fprintf(stderr, "[difficulty] not career\n");
+        }
+        g_screenSince = g_frame;
+        g_screenHovers = false;
+        g_hoverSeqOnScreen = PunchOut_HoverSequence();
+        g_sel = Selection{};
+        g_click.active = false;
+        g_autoSelect = true;
+        g_pendingDir = -1;
+        g_lastDescription.clear();
+        static int screenLogs = 0;
+        if (screenLogs < 300) {
+            ++screenLogs;
+            // With the 8 words before the object (allocator header: learning the object size).
+            std::fprintf(stderr, "[fe] screen: %s (@%08X; before: %08X %08X %08X %08X %08X %08X %08X %08X)\n", g_activeName,
+                         g_activePres, R32(g_activePres - 32u), R32(g_activePres - 28u), R32(g_activePres - 24u),
+                         R32(g_activePres - 20u), R32(g_activePres - 16u), R32(g_activePres - 12u), R32(g_activePres - 8u),
+                         R32(g_activePres - 4u));
+        }
+    }
+    if (PunchOut_HoverSequence() != g_hoverSeqOnScreen) {
+        g_hoverSeqOnScreen = PunchOut_HoverSequence();
+        g_screenHovers = true;
+    }
+
+    g_frameNow = g_frame;
+    const uint32_t pad_bits = Wiimote_PadButtons();
+    const uint32_t pressed = pad_bits & ~g_lastPad;
+    g_lastPad = pad_bits;
+
+    // Button positions animate (slide-ins), so look again every few frames and right before acting.
+    if (g_frame - g_lastRefresh >= 4 || pressed != 0) {
+        g_lastRefresh = g_frame;
+        RefreshTargets();
+        if (g_frame - g_screenSince >= 30) {
+            std::string key = ButtonsKey();
+            if (key != g_lastDescription) {
+                g_lastDescription = key;
+                const std::string text = DescribeButtons();
+                static int listLogs = 0;
+                if (listLogs < 200) {
+                    ++listLogs;
+                    std::fprintf(stderr, "[nav] %s: %zu buttons, %zu to go to%s\n", g_activeName, g_buttons.size(), g_targets.size(),
+                                 text.c_str());
+                }
+            }
+        }
+    }
+
+    // Fights: the pad keeps the fight mapping from the moment the round starts (Wwise InGame = Fight) until the fight
+    // is over (InGame = WinFight / LoseFight / GameOver) or a menu comes up. Before that (fight loading, the "press A"
+    // prompt, intro cutscenes) the pad's A is the remote's A too.
+    const uint32_t inGameSeq = g_inGameSeq.load(std::memory_order_acquire);
+    const bool inGameChanged = inGameSeq != g_inGameSeen;
+    g_inGameSeen = inGameSeq;
+    const uint32_t inGame = g_inGameState.load(std::memory_order_relaxed);
+    // Only a Fight set while a fight is on screen starts fight controls (not the Audio gallery playing a fight song).
+    const bool onFightScreen = g_activePres == 0 || IsFightScreen(g_activeHash);
+    if (inGameChanged && inGame == kInGameFight && onFightScreen) {
+        if (!g_fightLatched) NavLog("round started: fight controls");
+        g_fightLatched = true;
+    } else if (inGameChanged && g_fightLatched &&
+               (inGame == kInGameWin || inGame == kInGameLose || inGame == kInGameGameOver)) {
+        g_fightLatched = false;
+        NavLog("fight over: prompt controls");
+    }
+
+    // Menu controls on screens with buttons, and for a moment after them (screen transitions), never in a fight.
+    static uint32_t menuUntil = 0;
+    const bool fight = g_activePres == 0 || IsFightScreen(g_activeHash);
+    if (!fight && (!g_targets.empty() || !g_map.empty())) {
+        menuUntil = g_frame + 45;
+        if (g_fightLatched && !IsPauseScreen(g_activeHash)) g_fightLatched = false;
+    }
+    const bool menu = !fight && g_frame < menuUntil;
+    // Between rounds (Doc Louis in the corner: "press A to continue") the pad's A is the remote's A again.
+    static const uint32_t kCorner = FeHash("art/fe/CornerMan"), kCornerH2H = FeHash("art/fe/Cornerman_H2H");
+    const bool corner = g_activeHash == kCorner || g_activeHash == kCornerH2H;
+    const bool fightControls = !menu && g_fightLatched && !corner;
+    g_menuActive.store(menu, std::memory_order_release);
+    g_movieA.store(!menu && !fightControls, std::memory_order_relaxed);
+    const int mode = menu ? 1 : fightControls ? 2 : 3;
+    if (mode != g_lastMode) {
+        g_lastMode = mode;
+        NavLog("%s controls on %s", mode == 1 ? "menu" : mode == 2 ? "fight" : "prompt (A = remote A)", g_activeName);
+    }
+    // Map the screen (the hit test answers our grid points; nothing visible moves).
+    if (!fight) {
+        SweepTick(g_padMode.load(std::memory_order_relaxed));
+    } else {
+        g_probes.clear();
+    }
+
+    if (!menu) {
+        g_menuRemote.store(0, std::memory_order_relaxed);
+        g_click.active = false;
+        g_repeatDir = 0;
+        return;
+    }
+
+    // The right stick or the mouse takes over: the game's own pointer handling, glove visible.
+    if (Wiimote_UserPointerMoves() != g_userMoves) {
+        g_userMoves = Wiimote_UserPointerMoves();
+        if (g_padMode.exchange(false, std::memory_order_relaxed)) NavLog("pointer takes over on %s", g_activeName);
+        g_cursorHidden.store(false, std::memory_order_relaxed);
+        g_sel.valid = false;
+        g_click.active = false;
+    }
+    const bool pad = g_padMode.load(std::memory_order_relaxed);
+
+    // Which bumpers do something on this screen (for the prompt banner).
+    {
+        uint32_t bumpers = 0;
+        if (const uint32_t lb = KeyTarget(3); lb != 0 && Present(lb)) bumpers |= 1u;
+        if (const uint32_t rb = KeyTarget(4); rb != 0 && Present(rb)) bumpers |= 2u;
+        g_bumpers.store(bumpers, std::memory_order_relaxed);
+    }
+
+    if (pressed & kPadMark) MarkHere();
+    if (pressed & kPadUnmark) UnmarkHere();
+
+    // The selection went away (locked, screen changed under it): drop it.
+    if (g_sel.valid && g_mapValid && !Present(g_sel.id)) {
+        g_sel.valid = false;
+        g_click.active = false;
+    } else if (g_sel.valid) {
+        if (const Entry* e = MapOf(g_sel.id)) g_sel.screen = e->screen; // keep the presentation current
+    }
+
+    // New screen with the pad in use: start on its first button once it is mapped.
+    if (pad && g_autoSelect && !g_sel.valid && g_mapValid) {
+        g_autoSelect = false;
+        Navigate(0); // with nothing selected this picks the first button
+    }
+
+    uint16_t remote = 0;
+    const uint32_t dir = DirOf(pad_bits);
+    const int d = dir == kPadUp ? 0 : dir == kPadDown ? 1 : dir == kPadLeft ? 2 : 3;
+    if (dir == 0) {
+        g_repeatDir = 0;
+    } else if (dir != g_repeatDir) {
+        g_repeatDir = dir;
+        g_repeatAt = g_frame + 30; // hold: repeat after 0.5 s, then every 10 frames
+        Navigate(d);
+    } else if (g_frame >= g_repeatAt) {
+        g_repeatAt = g_frame + 10;
+        Navigate(d);
+    }
+    if (g_pendingDir >= 0 && !LiveWaiting()) Navigate(g_pendingDir);
+    if (pressed & kPadB) {
+        PressKey(0);
+    } else if (pressed & kPadX) {
+        PressKey(1);
+    } else if (pressed & kPadY) {
+        PressKey(2);
+    } else if (pressed & kPadLB) {
+        PressKey(3);
+    } else if (pressed & kPadRB) {
+        PressKey(4);
+    }
+
+    // A: in pad mode it presses the selected button (the override makes it the hovered one); with the pointer, A is
+    // simply the remote's A.
+    // B with no button assigned on this screen is the remote's own B (back / cancel); on the fight's pause menu it is
+    // + (Start), which closes the pause menu like it opened it.
+    if ((pad_bits & kPadB) && KeyTarget(0) == 0) {
+        static const uint32_t kPause = FeHash("art/fe/PauseScreen"), kPauseH2H = FeHash("art/fe/H2H_PauseScreen");
+        remote |= g_activeHash == kPause || g_activeHash == kPauseH2H ? kRemotePlus : kRemoteB;
+    }
+
+    if (pressed & kPadA) {
+        NavLog("A on %s: %s", g_activeName, !pad ? "pointer" : g_sel.valid ? "selection" : "nothing selected");
+    }
+    if (g_click.active) {
+        if (!g_sel.valid) {
+            g_click.active = false;
+        } else if (g_frame >= g_click.pressAt) {
+            const uint32_t held = g_frame - g_click.pressAt;
+            if (held < 4) remote |= kRemoteA;
+            if (held >= 6) g_click.active = false;
+        }
+    } else if (pad_bits & kPadA) {
+        remote |= kRemoteA; // with nothing selected the game gets a plain A (prompts that take A anywhere)
+    }
+    g_menuRemote.store(remote, std::memory_order_relaxed);
+}
