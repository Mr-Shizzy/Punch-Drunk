+// ---------------------------------------------------------------------------------------------
+// Bring-up trace: with PUNCHOUT_GX_TRACE_FRAME=<n> in the environment, every GX native call made
+// while frame n is being built is logged to stderr ("[gxtrace] name a b c"). Off: one relaxed load.
+// ---------------------------------------------------------------------------------------------
+#include <atomic>
+#include <cstdio>
+#include <type_traits>
+#include "gx_worker.h"
+extern std::atomic<bool> g_gxTraceOn;
+extern std::atomic<bool> g_gxTraceStateOn;
+void GxTraceLine(const char* text);
+// PUNCHOUT_GX_TRACE_STATE=1: from boot, trace every GX call that is not one of the per-draw ones.
+bool GxTraceStateWanted(const char* name) noexcept;
+namespace GxTraceDetail {
+template <typename T>
+inline int Format(char* out, size_t room, const T& v) {
+    if constexpr (std::is_same_v<T, bool>) {
+        return std::snprintf(out, room, " %d", v ? 1 : 0);
+    } else if constexpr (std::is_integral_v<T> || std::is_enum_v<T>) {
+        return std::snprintf(out, room, " 0x%llX", static_cast<unsigned long long>(v));
+    } else if constexpr (std::is_floating_point_v<T>) {
+        return std::snprintf(out, room, " %g", static_cast<double>(v));
+    } else if constexpr (std::is_pointer_v<T>) {
+        return std::snprintf(out, room, " %p", static_cast<const void*>(v));
+    } else if constexpr (sizeof(T) == 4 && std::is_trivially_copyable_v<T>) {
+        uint32_t raw = 0;
+        std::memcpy(&raw, &v, 4);
+        return std::snprintf(out, room, " {%08X}", raw);
+    } else {
+        return std::snprintf(out, room, " ?");
+    }
+}
+} // namespace GxTraceDetail
+template <typename... A>
+inline void GxTraceCall(const char* name, const A&... args) {
+    // GX calls are recorded on the game thread and replayed on the GX worker, which re-enters the
+    // same native; trace only the game thread so each call appears once and in program order.
+    if (GxWorker::OnWorker()) {
+        return;
+    }
+    if (!g_gxTraceOn.load(std::memory_order_relaxed) &&
+        !(g_gxTraceStateOn.load(std::memory_order_relaxed) && GxTraceStateWanted(name))) {
+        return;
+    }
+    char line[512];
+    int used = std::snprintf(line, sizeof(line), "%s", name);
+    ((used += (used >= 0 && used < static_cast<int>(sizeof(line)))
+                  ? GxTraceDetail::Format(line + used, sizeof(line) - used, args)
+                  : 0),
+     ...);
+    GxTraceLine(line);
+}
+// Raw BP register writes are applied where GX executes (normally the worker), so these lines can
+// trail the game-thread calls that produced them.
+inline void GxTraceBp(uint32_t bpWord) {
+    const bool frame = g_gxTraceOn.load(std::memory_order_relaxed);
+    const uint32_t reg = bpWord >> 24;
+    const bool state = g_gxTraceStateOn.load(std::memory_order_relaxed) && (reg < 0x4F || reg > 0x52);
+    if (!frame && !state) {
+        return;
+    }
+    char line[48];
+    std::snprintf(line, sizeof(line), "BP 0x%08X", bpWord);
+    GxTraceLine(line);
+}
