+        std::fprintf(stderr, "[btn] OnEvent @%08X id %08X state %u -> event %u (r4 %08X r6 %08X) from lr %08X on %s\n", b,
+                     R32(b + 0x10u), R32(b + 0xCu), ctx->gpr[5], ctx->gpr[4], ctx->gpr[6], ctx->lr, g_activeName);
+    }
+    MKW_GUEST_FUNC(80FF001C)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF001C, PunchOut_ButtonOnEvent_pseudo, "PunchOut_ButtonOnEvent_pseudo");
+
+// FE cursor manager update (PO 80178EF8; pseudo PAL 80FF0020): in pad mode our selection goes into player 0's hovered
+// button / screen right before the update turns it into button events.
+extern "C" void PunchOut_CursorUpdate_pseudo(CpuContext* ctx) {
+    const uint32_t mgr = ctx->gpr[3];
+    // Hard / Insane career fights: the pause menu's Restart can be neither highlighted nor pressed (pointer or pad).
+    if (g_mem1 != nullptr && IsPtr(mgr) && mgr == R32(kCursorMgr) && InMem1(mgr + 0x160u) && (R32(mgr + 0x3Cu) == kIdRestart || R32(mgr + 0x3Cu) == kIdQuit) && RestartBlocked()) {
+        std::memset(g_mem1 + (mgr + 0x3Cu - kMem1), 0, 4);
+        std::memset(g_mem1 + (mgr + 0x44u - kMem1), 0, 4);
+    }
+    if (g_mem1 != nullptr && IsPtr(mgr) && mgr == R32(kCursorMgr) && InMem1(mgr + 0x160u) &&
+        g_padMode.load(std::memory_order_relaxed) && g_menuActive.load(std::memory_order_relaxed) &&
+        !(g_sel.valid && g_sel.point)) {
+        const uint32_t id = g_sel.valid ? g_sel.id : 0u, screen = g_sel.valid ? g_sel.screen : 0u;
+        uint8_t* m = g_mem1 + (mgr - kMem1);
+        const auto put = [m](uint32_t o, uint32_t v) {
+            m[o] = uint8_t(v >> 24); m[o + 1] = uint8_t(v >> 16); m[o + 2] = uint8_t(v >> 8); m[o + 3] = uint8_t(v);
+        };
+        put(0x3C, id);
+        put(0x44, screen);
+        m[0x32] = 1; // pointer valid, whatever the IR says
+    }
+    MKW_GUEST_FUNC(80FF0020)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0020, PunchOut_CursorUpdate_pseudo, "PunchOut_CursorUpdate_pseudo");
+
+// FE hit test (PO 80178BB8; pseudo PAL 80FF0024): answers the sweep's grid points with the game's own hit test
+// (player 0's pointer set to each point, +0x3C cleared, the test run, its answer read), then restores the pointer
+// fields and runs the real test for the real pointer.
+extern "C" void PunchOut_HitTest_pseudo(CpuContext* ctx) {
+    const uint32_t mgr = ctx->gpr[3];
+    bool pendingProbes = false;
+    for (const auto& p : g_probes) pendingProbes |= !p.done;
+    bool probeOk = false;
+    uint32_t offersThisFrame = 0;
+    if (g_mem1 != nullptr && IsPtr(mgr) && mgr == R32(kCursorMgr)) {
+        offersThisFrame = g_offerCount - g_offerCountAtHitTest;
+        g_offerCountAtHitTest = g_offerCount;
+    }
+    if (g_mem1 != nullptr && pendingProbes) {
+        ++g_pstats.calls;
+        uint32_t why = 0;
+        if (!(IsPtr(mgr) && mgr == R32(kCursorMgr) && InMem1(mgr + 0x160u))) {
+            why |= 1;
+        } else {
+            if (R32(mgr + 0x18u) == 0xFFFFFFFFu) why |= 2;
+            if (R32(mgr + 0x128u) != 2u) why |= 4;
+            if (R8(mgr + 0x150u) != 0u) why |= 8;
+        }
+        probeOk = why == 0;
+        if (!probeOk) {
+            ++g_pstats.skipped;
+            g_pstats.skipWhy |= why;
+        }
+    }
+    if (probeOk) {
+        uint8_t* m = g_mem1 + (mgr - kMem1);
+        uint8_t saved[0x48];
+        std::memcpy(saved, m, sizeof saved); // +0x28..+0x44 live in here
+        const uint32_t r3 = ctx->gpr[3], r4 = ctx->gpr[4];
+        float w = 0, h = 0;
+        HitScale(w, h);
+        const auto putf = [m](uint32_t o, float f) {
+            uint32_t v;
+            std::memcpy(&v, &f, 4);
+            m[o] = uint8_t(v >> 24); m[o + 1] = uint8_t(v >> 16); m[o + 2] = uint8_t(v >> 8); m[o + 3] = uint8_t(v);
+        };
+        for (auto& p : g_probes) {
+            if (p.done) continue;
+            // Queued after this frame's 2D buttons offered themselves: answer it next frame.
+            if (offersThisFrame > 0 && p.offers == 0) continue;
+            if (p.id != 0) { // a 2D button is there (the 3D test only runs when none is)
+                p.done = true;
+                if (!g_pstats.sampled || g_pstats.sampleId == 0) {
+                    g_pstats.sampled = true;
+                    g_pstats.sampleX = p.x;
+                    g_pstats.sampleY = p.y;
