+// ---- finding things in memory (client.py) ----
+std::optional<uint32_t> FindSaveSlot() {
+    const uint32_t m = R32(kProfileManagerPointer);
+    if (!InMem1(m) || R32(m + 0x5600) != 5) return std::nullopt;
+    return m + 8 + 5 * 0xC48;
+}
+bool SaveDataPlausible(int counter, const std::vector<uint8_t>& flags) {
+    if (counter > 26) return false;
+    int highest = 0;
+    for (int n = 1; n <= kNumFights; ++n) {
+        for (int c = 0; c < 3; ++c) {
+            const uint8_t v = flags[(n - 1) * kFightStride + c];
+            if (v > 1) return false;
+            if (v) highest = n;
+        }
+    }
+    return counter >= 26 || highest <= counter + 2;
+}
+uint32_t FindFight() {
+    uint32_t f = R32(kFightPointer);
+    if (InMem1(f) && R32(f) == kFightVtable) return f;
+    if (R32(kFightBackup) == kFightVtable) return kFightBackup;
+    return 0;
+}
+std::optional<uint32_t> StarBlockOf(uint32_t boxer) {
+    if (!InMem1(boxer)) return std::nullopt;
+    const uint32_t blk = R32(boxer + 0xCC);
+    if (!InMem1(blk)) return std::nullopt;
+    const float v = RF(blk + 0x10), l = RF(blk + 0x0C);
+    if (Bad(v) || Bad(l) || v < -0.01f || v > 3.01f || l < -0.01f || l > 3.01f) return std::nullopt;
+    return blk;
+}
+uint32_t FindMac() {
+    if (const uint32_t f = FindFight()) {
+        const uint32_t b = R32(f + 4);
+        if (StarBlockOf(b)) return b;
+    }
+    const uint32_t b = R32(kMacBackupPointer);
+    if (InMem1(b) && R32(b + 0xCC) == b + 0xB4A8 && StarBlockOf(b)) return b;
+    return 0;
+}
+std::optional<uint32_t> FindStar() {
+    const uint32_t mac = FindMac();
+    if (!mac) return std::nullopt;
+    const auto blk = StarBlockOf(mac);
+    if (!blk) return std::nullopt;
+    return *blk + 0x10;
+}
+uint32_t FindHealthMeter() {
+    const uint32_t mac = FindMac();
+    if (!mac) return 0;
+    const uint32_t m = R32(mac + 0xC4);
+    if (!InMem1(m)) return 0;
+    const float max = RF(m + 0x0C);
+    return !Bad(max) && max >= 1 && max <= 1000 ? m : 0;
+}
+float GetHealth(uint32_t star) {
+    if (const uint32_t m = FindHealthMeter()) return std::min(RF(m + 0x10), RF(m + 0x18));
+    return RF(star - 0x58);
+}
+void RefreshHealthBar(bool opponent, uint32_t opponentSlot = 0) {
+    W32(kHudFlag, opponent ? opponentSlot : 1u);
+}
+void SetHealth(uint32_t star, float value) {
+    if (const uint32_t m = FindHealthMeter()) {
+        WF(m + 0x18, value);
+        WF(m + 0x10, value);
+        RefreshHealthBar(false);
+    } else {
+        WF(star - 0x58, value);
+    }
+}
+std::optional<std::pair<uint32_t, uint32_t>> FindOpponent() {
+    const uint32_t f = FindFight(), mac = FindMac();
+    if (!f || !mac) return std::nullopt;
+    for (uint32_t s : {2u, 1u}) {
+        const uint32_t b = R32(f + 4 * s);
+        if (InWii(b) && b != mac) return std::make_pair(b, s);
+    }
+    return std::nullopt;
+}
+std::string CurrentOpponentName() {
+    const uint32_t st = R32(kGameStatePointer);
+    if (!InMem1(st)) return "";
+    std::string n;
+    for (uint32_t i = 0; i < 16; ++i) {
+        const uint8_t c = R8(st + 0x10 + i);
+        if (!c) break;
+        n.push_back(static_cast<char>(c));
+    }
+    return n;
+}
+bool InCareerMode() {
+    const uint32_t st = R32(kGameStatePointer);
+    return InMem1(st) && R32(st + 4) == 1;
+}
