+// The gamepad as the menu navigation sees it (punchout_menu.cpp PadBit): D-pad or left stick, A B X Y, bumpers.
+// 0 unless the emulated remote is the game's controller.
+extern "C" uint32_t Wiimote_PadButtons() {
+    if (!Wiimote::g_remoteReady.load(std::memory_order_acquire) || InputBindings::InputBlocked()) return 0;
+    // Keyboard: Insert marks the button under the pointer for the menu links, Delete takes a mark away (bits 10, 11).
+    uint32_t keyBits = 0;
+    int keyCount = 0;
+    if (const bool* keys = SDL_GetKeyboardState(&keyCount)) {
+        if (SDL_SCANCODE_INSERT < keyCount && keys[SDL_SCANCODE_INSERT]) keyBits |= 1u << 10;
+        if (SDL_SCANCODE_DELETE < keyCount && keys[SDL_SCANCODE_DELETE]) keyBits |= 1u << 11;
+    }
+    // Keyboard menu navigation through the fight bindings: directions, 1 chooses, 2 goes back; the page keys turn
+    // pages like the bumpers.
+    {
+        using namespace PunchOutControls;
+        const size_t order[10] = {Up, Down, Left, Right, One, Two, B, PunchOutControls::A, PagePrev, PageNext};
+        for (int i = 0; i < 10; ++i) {
+            if (KeyHeld(order[i])) keyBits |= 1u << i;
+        }
+    }
+    SDL_Gamepad* gamepad = Wiimote::FindGamepad();
+    if (gamepad == nullptr) return keyBits;
+    const auto held = [gamepad](SDL_GamepadButton button) { return SDL_GetGamepadButton(gamepad, button); };
+    const auto axis = [gamepad](SDL_GamepadAxis a) { return static_cast<int>(SDL_GetGamepadAxis(gamepad, a)); };
+    // Left stick with hysteresis (on past 60%, off under 35%), so a stick resting near the edge does not chatter.
+    constexpr int kOn = 19660, kOff = 11468;
+    static bool stick[4] = {};
+    const int lx = axis(SDL_GAMEPAD_AXIS_LEFTX), ly = axis(SDL_GAMEPAD_AXIS_LEFTY);
+    const int dirValue[4] = {-ly, ly, -lx, lx}; // up, down, left, right
+    for (int i = 0; i < 4; ++i) stick[i] = stick[i] ? dirValue[i] > kOff : dirValue[i] > kOn;
+    uint32_t bits = 0;
+    if (held(SDL_GAMEPAD_BUTTON_DPAD_UP) || stick[0]) bits |= 1u << 0;
+    if (held(SDL_GAMEPAD_BUTTON_DPAD_DOWN) || stick[1]) bits |= 1u << 1;
+    if (held(SDL_GAMEPAD_BUTTON_DPAD_LEFT) || stick[2]) bits |= 1u << 2;
+    if (held(SDL_GAMEPAD_BUTTON_DPAD_RIGHT) || stick[3]) bits |= 1u << 3;
+    if (held(SDL_GAMEPAD_BUTTON_SOUTH)) bits |= 1u << 4;
+    if (held(SDL_GAMEPAD_BUTTON_EAST)) bits |= 1u << 5;
+    if (held(SDL_GAMEPAD_BUTTON_WEST)) bits |= 1u << 6;
+    if (held(SDL_GAMEPAD_BUTTON_NORTH)) bits |= 1u << 7;
+    if (PunchOutControls::PadHeld(PunchOutControls::PagePrev, gamepad)) bits |= 1u << 8; // bumpers by default
+    if (PunchOutControls::PadHeld(PunchOutControls::PageNext, gamepad)) bits |= 1u << 9;
+    return bits | keyBits;
+}
+
+// The gamepad that drives the emulated remote (for the F10 rebind prompt), or nullptr.
+extern "C" SDL_Gamepad* Wiimote_ActiveGamepad() {
+    return Wiimote::FindGamepad();
+}
+
+// What the player pressed last: 0 nothing yet, 1 keyboard, 2 gamepad (the in-game prompts follow it).
+extern "C" int Wiimote_LastInputDevice() {
+    return Wiimote::g_lastInputDevice.load(std::memory_order_relaxed);
+}
+
+extern "C" uint32_t Wiimote_UserPointerMoves() {
+    return Wiimote::g_userPointerMoves.load(std::memory_order_relaxed);
+}
+
+extern "C" uint32_t Wiimote_AppliedWarp() {
+    return Wiimote::g_appliedWarp.load(std::memory_order_acquire);
+}
+
+extern "C" void Wiimote_PointerPosition(float* x, float* y) {
+    *x = Wiimote::g_pointerX.load(std::memory_order_relaxed);
+    *y = Wiimote::g_pointerY.load(std::memory_order_relaxed);
+}
