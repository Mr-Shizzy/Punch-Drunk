diff --git a/runtime/cmake/PublicProducts.cmake b/runtime/cmake/PublicProducts.cmake
index 809f22e..df6bdc3 100644
--- a/runtime/cmake/PublicProducts.cmake
+++ b/runtime/cmake/PublicProducts.cmake
@@ -283,7 +283,8 @@ function(mkw_configure_product target)
     # a fixed hardware ROM, this bundle is expected to be refreshed periodically as CAs rotate.
     # Windows gets its trust store from Schannel, so only the platforms that actually build the
     # mbed TLS path need the bundle beside the executable.
-    if(NOT MKW_PLATFORM_WINDOWS)
+    # Punch-Out!!'s Archipelago client verifies with this bundle on Windows as well.
+    if(TRUE)
         set(MKW_CA_CERTIFICATE_BUNDLE "${MKW_RUNTIME_SOURCE_DIR}/assets/certs/cacert.pem")
         if(NOT EXISTS "${MKW_CA_CERTIFICATE_BUNDLE}")
             message(FATAL_ERROR "Missing TLS root CA bundle: ${MKW_CA_CERTIFICATE_BUNDLE}")
diff --git a/runtime/include/abi_bridge.h b/runtime/include/abi_bridge.h
index 4ca4439..df609d7 100644
--- a/runtime/include/abi_bridge.h
+++ b/runtime/include/abi_bridge.h
@@ -46,6 +46,9 @@ public:
                   void (*rawCpuInvoker)(CpuContext*) = nullptr,
                   bool mustRemainDynamicallyDispatchable = true)
     {
+        if (::GuestRegion::IsAbsent(address)) {
+            return; // no counterpart in this region
+        }
         TranslatedFunctionInfo info;
         info.address = address;
         info.name = name ? name : "";
@@ -135,6 +138,9 @@ public:
                   void (*rawCpuInvoker)(CpuContext*) = nullptr,
                   bool mustRemainDynamicallyDispatchable = true)
     {
+        if (::GuestRegion::IsAbsent(address)) {
+            return; // no counterpart in this region
+        }
         TranslatedFunctionInfo info;
         info.address = address;
         info.name = name ? name : "";
