+        if (OptionsButtonEvent(ctx, g_opt.button, r4, event)) OptionsSwitch(ctx, true);
+        return;
+    }
+    // Submenu: Back (+0x2C) and the three choices (+0x48 / +0x64 / +0x80); the hidden Difficulty button is ignored.
+    for (int i = 0; i < 4; ++i) {
+        const uint32_t b = self + 0x2Cu + uint32_t(i) * 0x1Cu;
+        if (R32(b + 0x10u) != id) continue;
+        const bool chosen = OptionsButtonEvent(ctx, b, r4, event);
+        if (i >= 1 && event == 1u) OptionsDescription(i - 1);
+        if (chosen) {
+            if (i >= 1) {
+                RuntimeConfigFile::SetDifficulty(kDifficultyNames[i - 1]);
+                g_difficulty.store(i - 1, std::memory_order_relaxed);
+                std::fprintf(stderr, "[difficulty] set to %s (career fights)\n", kDifficultyNames[i - 1]);
+            }
+            OptionsSwitch(ctx, false);
+        }
+        return;
+    }
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0044, PunchOut_OptionsEvent_pseudo, "PunchOut_OptionsEvent_pseudo");
