+std::string ButtonsKey() {
+    std::string key = std::to_string(g_targets.size()) + "|";
+    for (const auto& b : g_buttons) {
+        char buf[64];
+        std::snprintf(buf, sizeof buf, "%X:%X:%d:%.2f:%.2f|", b.addr, b.inst, b.geom ? 1 : 0, b.cx, b.cy);
