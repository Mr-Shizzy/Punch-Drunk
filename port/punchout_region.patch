+bool Present(uint32_t id);
+
+// Nearest button that way, from positions (for links not written yet); presentOnly: only buttons on screen now
+// (a screen with pages, like Exhibition's Contender / Title Defense, keeps every page's buttons in its section).
+uint32_t AutoLink(const LinkScreen& sc, const LinkButton& from, int dir, bool presentOnly = false) {
+    const float dx = dir == 2 ? -1.f : dir == 3 ? 1.f : 0.f, dy = dir == 0 ? -1.f : dir == 1 ? 1.f : 0.f;
+    for (const float cone : {1.0f, 2.5f}) {
+        if (cone > 1.0f && dx != 0.f) break; // left / right stay strict; up / down may reach a row further over
+        uint32_t best = 0;
+        float bestScore = 1e9f;
+        for (const auto& b : sc.buttons) {
+            if (b.id == from.id) continue;
+            if (presentOnly && !Present(b.id)) continue;
+            const float vx = b.x - from.x, vy = b.y - from.y;
+            const float along = vx * dx + vy * dy;
+            if (along <= 0.03f) continue;
+            const float perp = std::fabs(vx * dy - vy * dx);
+            if (perp > along * cone) continue;
+            const float score = along + 2.5f * perp;
+            if (score < bestScore) {
+                bestScore = score;
+                best = b.id;
+            }
+        }
+        if (best) return best;
+    }
+    return 0;
+}
+
+// Fill in what is missing: links of new buttons, empty key assignments.
+void AutoFill(LinkScreen& sc, bool presentOnly = false) {
+    for (auto& b : sc.buttons) {
+        if (presentOnly && !Present(b.id)) continue; // a page not showing keeps its links for when it does
+        for (int d = 0; d < 4; ++d) {
+            if (b.link[d] == 0) b.link[d] = AutoLink(sc, b, d, presentOnly);
+        }
+    }
+    const auto has = [&sc](uint32_t id) { return LinkOf(&sc, id) != nullptr; };
+    if (!sc.keys[0] && has(kIdNavLeft)) sc.keys[0] = kIdNavLeft;
+    // X / Y: nothing by default (the D-pad reaches every button; the user: no use for them).
+    // LB / RB: the small boxes low on the screen (Exhibition's Contender / Title Defense arrows).
+    for (const auto& e : g_map) {
+        if (!has(e.id) || e.cy < 0.45f || e.x1 - e.x0 > 0.22f || e.y1 - e.y0 > 0.3f) continue;
+        const int k = e.cx < 0.15f ? 3 : 4;
+        if (!sc.keys[k]) sc.keys[k] = e.id;
+    }
+}
+
+void LinkMark(LinkScreen& sc, size_t idx);
+
+// A sweep finished: record the screen / new buttons into the links file.
+void RecordScreen() {
+    if (!g_linksLoaded) LoadLinks();
+    if (Dynamic()) return;
+    LinkScreen* sc = FileLinksFor(ScreenKey());
+    bool changed = false;
+    if (!sc) {
+        sc = EditableLinksFor(ScreenKey());
+        sc->live = LiveScreen();
+        changed = true;
+    } else if (!UserLinksFor(ScreenKey())) {
+        // Built in: only a button the built-in links lack (one we never saw unlocked) makes a copy in the user's file.
+        bool missing = false;
+        for (const auto& e : g_map) missing |= LinkOf(sc, e.id) == nullptr;
+        if (!missing) return;
+        sc = EditableLinksFor(ScreenKey());
+    }
+    std::vector<size_t> added;
+    for (const auto& e : g_map) {
+        if (LinkOf(sc, e.id)) continue;
+        added.push_back(sc->buttons.size());
+        LinkButton b;
+        b.id = e.id;
+        b.owner = OwnerOf(e.screen);
+        b.x = e.cx;
+        b.y = e.cy;
+        sc->buttons.push_back(b);
+        changed = true;
+        NavLog("recorded on %s: button %08X (%s) at (%.3f, %.3f), %.3f x %.3f", g_activeName, b.id, b.owner.c_str(), b.x,
+               b.y, e.x1 - e.x0, e.y1 - e.y0);
+    }
+    if (changed) {
+        // Only new buttons get links from positions (among the buttons showing now); the links already in the file
+        // stay as they are.
+        AutoFill(*sc, true);
+        // A button that shows up later (unlocked) also becomes the neighbours' link that way when it is the nearest.
+        const bool fresh = added.size() == sc->buttons.size();
+        if (!fresh) {
+            for (const size_t i : added) LinkMark(*sc, i);
+        }
+        SaveLinks();
+    }
+}
+
+// The next frame's batch of grid points (called at frame start; the hit-test wrapper answers them this frame).
+void SweepTick(bool padMode) {
+    if (!g_linksLoaded) LoadLinks();
+    // Collect the answers; a batch the hit test has not answered yet stays queued (for up to 10 frames).
+    bool pending = false;
+    for (const auto& p : g_probes) pending |= !p.done;
+    if (pending && g_frame - g_batchAt < 10 && g_sweepPres == g_activePres) return;
+    for (const auto& p : g_probes) {
+        if (!p.done) ++g_pstats.dropped;
+        if (p.done) ++g_pstats.answered;
+        if (p.done && p.id != 0) ++g_pstats.hits;
+        if (!p.done || p.id == 0) continue;
+        Acc* a = nullptr;
+        for (auto& c : g_acc) {
+            if (c.id == p.id && c.screen == p.screen) a = &c;
+        }
+        if (!a) {
+            g_acc.push_back({p.id, p.screen});
+            a = &g_acc.back();
+        }
+        a->sx += p.x;
+        a->sy += p.y;
+        a->x0 = std::min(a->x0, p.x);
+        a->x1 = std::max(a->x1, p.x);
+        a->y0 = std::min(a->y0, p.y);
+        a->y1 = std::max(a->y1, p.y);
+        ++a->n;
+    }
+    g_probes.clear();
+    if (g_sweepPres != g_activePres) {
+        g_sweepPres = g_activePres;
+        g_sweepNext = -1;
+        g_acc.clear();
+        g_map.clear();
+        g_mapValid = false;
+        g_live = LinkScreen{};
+        g_sweepAgainAt = g_frame + 6; // let the screen come up
+    }
+    if (g_sweepNext < 0) {
+        if (g_frame < g_sweepAgainAt) return;
+        g_sweepNext = 0;
+        g_acc.clear();
+        g_pstats = ProbeStats{};
+        g_sweepStartedAt = g_frame;
+        const bool liveGrid = LiveScreen() && padMode;
+        g_gridW = liveGrid ? kLiveGridW : kGridW;
+        g_gridH = liveGrid ? kLiveGridH : kGridH;
+        // Buttons marked by hand are looked for where they were marked (the grid can miss small ones).
+        if (!Dynamic()) {
+            if (const LinkScreen* sc = FileLinksFor(ScreenKey())) {
+                for (const auto& b : sc->buttons) {
+                    if (b.mark && !b.point) g_probes.push_back({b.x, b.y});
+                }
+            }
+        }
+    }
+    if (g_sweepNext >= g_gridW * g_gridH) {
+        // Done: this is the screen's map now.
+        std::vector<Entry> previous = std::move(g_map);
+        g_map.clear();
+        for (const auto& a : g_acc) {
+            g_map.push_back({a.id, a.screen, a.sx / a.n, a.sy / a.n, a.x0, a.x1, a.y0, a.y1});
+        }
+        {
+            static uint32_t loggedPres = 0;
+            static int perScreen = 0, total = 0;
+            if (loggedPres != g_activePres) {
+                loggedPres = g_activePres;
+                perScreen = 0;
+            }
+            if ((perScreen < 3 || (g_map.empty() && perScreen < 6)) && total < 300) {
+                ++perScreen;
+                ++total;
+                std::fprintf(stderr,
+                             "[nav] sweep on %s: %u hit tests run, %u probes answered, %u on a button, %u dropped, "
+                             "wrapper skipped %u (why %X); sample (%.1f, %.1f) -> %08X; %zu selectables\n",
+                             g_activeName, g_pstats.calls, g_pstats.answered, g_pstats.hits, g_pstats.dropped,
+                             g_pstats.skipped, g_pstats.skipWhy, g_pstats.sampleX, g_pstats.sampleY, g_pstats.sampleId,
+                             g_map.size());
+            }
+        }
+        // The probes found nothing: use the buttons from the screen's menu file layout instead.
+        g_mapFallback = false;
+        if (g_map.empty() && !g_targets.empty()) {
+            g_mapFallback = true;
+            for (const auto& t : g_targets) {
+                if (t.id == 0) continue;
+                const uint32_t screen = t.navBar && !g_navBars.empty() ? g_navBars.front().addr : g_activePres;
+                g_map.push_back({t.id, screen, t.cx, t.cy, t.cx - t.hw, t.cx + t.hw, t.cy - t.hh, t.cy + t.hh});
+            }
+        }
+        const bool first = !g_mapValid;
+        g_mapValid = true;
+        g_sweepNext = -1;
+        g_live = LinkScreen{ScreenKey(), {}, {}};
+        for (const auto& e : g_map) {
+            LinkButton b;
+            b.id = e.id;
+            b.owner = OwnerOf(e.screen);
+            b.x = e.cx;
+            b.y = e.cy;
+            g_live.buttons.push_back(b);
+        }
+        AutoFill(g_live);
+        // Written to the file only once two maps in a row agree (slide-ins over).
+        bool stable = !previous.empty() && previous.size() == g_map.size();
+        for (const auto& e : g_map) {
+            bool same = false;
+            for (const auto& o : previous) {
+                same |= o.id == e.id && std::fabs(o.cx - e.cx) < 0.02f && std::fabs(o.cy - e.cy) < 0.02f;
+            }
+            stable &= same;
+        }
+        // Settled (looser: 3D models bob a little): for live screens, where the camera turns.
+        bool settled = !previous.empty() && previous.size() == g_map.size();
+        for (const auto& e : g_map) {
+            bool same = false;
+            for (const auto& o : previous) {
+                same |= o.id == e.id && std::fabs(o.cx - e.cx) < 0.06f && std::fabs(o.cy - e.cy) < 0.06f;
+            }
+            settled &= same;
+        }
+        g_mapSettled = settled;
+        g_mapStartedAt = g_sweepStartedAt;
+        const bool live = LiveScreen();
+        if (first) NavLog("%s mapped: %zu selectables%s", g_activeName, g_map.size(), live ? " (live links)" : "");
+        if (stable || (live && settled)) RecordScreen();
+        // Again soon while the screen settles, the camera may move, or the pad drives (buttons come and go).
+        g_sweepAgainAt = g_frame + (!stable || (live && padMode) ? 2 : padMode ? 20 : 120);
+        return;
+    }
+    const int batch = g_gridW == kLiveGridW ? kLiveBatch : 128;
+    for (int k = 0; k < batch && g_sweepNext < g_gridW * g_gridH; ++k, ++g_sweepNext) {
+        g_probes.push_back({GridX(g_sweepNext), GridY(g_sweepNext)});
+    }
+    g_batchAt = g_frame;
+}
+
+struct Selection {
+    bool valid = false;
+    bool point = false; // a point mark: the real pointer goes there, the game's own hover does the rest
+    uint32_t id = 0, screen = 0;
+} g_sel;
+
+struct Click {
+    bool active = false;
+    uint32_t pressAt = 0;
+} g_click;
+
+bool g_autoSelect = false; // a new screen: with the pad, start on its first button
+
+
+void Warp(float x, float y) {
+    g_warpX.store(x, std::memory_order_relaxed);
+    g_warpY.store(y, std::memory_order_relaxed);
+    g_warpSeq.fetch_add(1, std::memory_order_release);
+}
+
+// The presentation a recorded button belongs to right now.
+uint32_t ScreenFor(const LinkButton& b) {
+    if (const Entry* e = MapOf(b.id)) return e->screen;
+    if (b.owner == "bar" && !g_navBars.empty()) return g_navBars.front().addr;
+    return g_activePres;
+}
+
+bool Present(uint32_t id) {
+    if ((id == kIdRestart || id == kIdQuit) && RestartBlocked()) return false; // Hard / Insane: no Restart / Quit
+    if (id == kIdDifficulty && (g_optionsSubmenu.load(std::memory_order_relaxed) || PunchOutAp::ClientActive())) {
+        return false; // hidden in the submenu; locked while Archipelago is on
+    }
+    if (MapOf(id) != nullptr) return true;
+    const LinkButton* b = LinkOf(LinksFor(ScreenKey()), id);
+    if (b == nullptr) return false;
+    // Point marks are always there on their screen; with nothing mapped (yet), so is everything in the file.
+    return b->point || g_map.empty();
+}
+
+void Select(uint32_t id, const char* what) {
+    LinkScreen* sc = LinksFor(ScreenKey());
+    const LinkButton* b = LinkOf(sc, id);
+    g_lastSelectAt = g_frame;
+    g_sel.valid = true;
+    g_sel.point = b != nullptr && b->point;
+    g_sel.id = id;
+    g_sel.screen = b ? ScreenFor(*b) : (MapOf(id) ? MapOf(id)->screen : g_activePres);
+    g_padMode.store(true, std::memory_order_relaxed);
+    g_cursorHidden.store(true, std::memory_order_relaxed);
+    // Park the hidden pointer on it, so the glove shows up there if the stick takes over.
+    if (g_sel.point) {
+        Warp(b->x, b->y);
+    } else if (const Entry* e = MapOf(id)) {
+        Warp(e->cx, e->cy);
+    }
+    NavLog("%s -> button %08X at (%.3f, %.3f) on %s", what, id, b ? b->x : 0.f, b ? b->y : 0.f, g_activeName);
+}
+
+const char* DirName(int d) {
+    return kDirNames[d];
+}
+
+// A live screen right after a choice: the camera is turning; wait for a map made after it stopped (1.5 s at most).
+bool LiveWaiting() {
+    return LiveScreen() && g_sel.valid && g_frame - g_lastSelectAt < 90 &&
+           !(g_mapSettled && g_mapStartedAt >= g_lastSelectAt + 2);
+}
+
+void Navigate(int dir) {
+    if (LiveWaiting()) {
+        g_pendingDir = dir;
+        return;
+    }
+    g_pendingDir = -1;
+    LinkScreen* sc = LinksFor(ScreenKey());
+    if (!sc || sc->buttons.empty()) {
+        NavLog("%s: %s not mapped yet", DirName(dir), g_activeName);
+        return;
+    }
+    if (!g_sel.valid || !LinkOf(sc, g_sel.id)) {
+        // Nothing selected: the first button that is there (top row, leftmost); on a screen with only the bottom
+        // bar (match results: Back / Continue), its rightmost button (B already goes back).
+        const LinkButton* first = nullptr;
+        for (const auto& b : sc->buttons) {
+            if (!Present(b.id) || b.owner == "bar") continue;
+            if (!first || std::lround(b.y / 0.12f) < std::lround(first->y / 0.12f) ||
+                (std::lround(b.y / 0.12f) == std::lround(first->y / 0.12f) && b.x < first->x)) {
+                first = &b;
+            }
+        }
+        if (!first) {
+            for (const auto& b : sc->buttons) {
+                if (Present(b.id) && (!first || b.x > first->x)) first = &b;
+            }
+        }
+        if (first) Select(first->id, DirName(dir));
+        return;
+    }
+    // Follow the link; if it goes to a button that is not there right now (locked, hidden, another page), the
+    // nearest button that way that is there.
+    const LinkButton* cur = LinkOf(sc, g_sel.id);
+    const uint32_t linked = cur ? cur->link[dir] : 0;
+    if (linked != 0 && linked != g_sel.id && Present(linked)) {
+        Select(linked, DirName(dir));
+        return;
+    }
+    if (cur && linked != 0) {
+        LinkButton from = *cur;
+        if (const Entry* e = MapOf(cur->id)) {
+            from.x = e->cx;
+            from.y = e->cy;
+        }
+        if (const uint32_t id = AutoLink(*sc, from, dir, true)) {
+            Select(id, DirName(dir));
+            return;
+        }
+    }
+    NavLog("%s: nothing that way from %08X on %s", DirName(dir), g_sel.id, g_activeName);
+}
+
+// The button a key presses on this screen (0 = none assigned).
+uint32_t KeyTarget(int k) {
+    LinkScreen* sc = LinksFor(ScreenKey());
+    const LinkScreen* file = Dynamic() ? nullptr : FileLinksFor(ScreenKey());
+    return file && file->keys[k] ? file->keys[k] : sc ? sc->keys[k] : 0;
+}
+
+void PressKey(int k) {
+    const uint32_t id = KeyTarget(k);
+    if (id == 0 && k == 0) return; // B with nothing assigned is the remote's B (see the tick)
+    if (id == 0 || !Present(id)) {
+        NavLog("%s: nothing assigned / there on %s", kKeyNames[k], g_activeName);
+        return;
+    }
+    Select(id, kKeyNames[k]);
+    // The game has the selection for a frame or two first (a point mark: the pointer needs a moment to get there).
+    g_click = {true, g_frame + (g_sel.point ? 10u : 2u)};
+}
+
+// Links for a mark: its own from positions, and every neighbour's link that way now goes to it if it is the nearest.
+void LinkMark(LinkScreen& sc, size_t idx) {
+    LinkButton& m = sc.buttons[idx];
+    for (int d = 0; d < 4; ++d) m.link[d] = AutoLink(sc, m, d, true);
+    for (size_t i = 0; i < sc.buttons.size(); ++i) {
+        if (i == idx || !Present(sc.buttons[i].id)) continue;
+        for (int d = 0; d < 4; ++d) {
+            if (AutoLink(sc, sc.buttons[i], d, true) == m.id) sc.buttons[i].link[d] = m.id;
+        }
+    }
+}
+
+const char* LinkText(const LinkButton& b, char* buf, size_t n) {
+    std::snprintf(buf, n, "up=%08X down=%08X left=%08X right=%08X", b.link[0], b.link[1], b.link[2], b.link[3]);
+    return buf;
+}
+
+// Insert: mark what is under the pointer.
+void MarkHere() {
+    if (!g_linksLoaded) LoadLinks();
+    float wx = 0, wy = 0;
+    Wiimote_PointerPosition(&wx, &wy);
+    const bool fresh = g_frame - g_real.frame <= 3;
+    if (Dynamic()) {
+        std::fprintf(stderr, "[nav] mark: not kept on the dialog (its layout changes per question); under the pointer: %08X\n",
+                     fresh ? g_real.id : 0u);
+        return;
+    }
+    LinkScreen* sc = EditableLinksFor(ScreenKey());
+    size_t idx = 0;
+    if (fresh && g_real.id != 0) {
+        LinkButton* b = LinkOf(sc, g_real.id);
+        const bool known = b != nullptr, mapped = MapOf(g_real.id) != nullptr;
+        if (!b) {
+            sc->buttons.push_back({});
+            b = &sc->buttons.back();
+            b->id = g_real.id;
+            b->owner = OwnerOf(g_real.screen);
+        }
+        b->mark = true;
+        b->point = false;
+        b->x = g_real.x;
+        b->y = g_real.y;
+        idx = static_cast<size_t>(b - sc->buttons.data());
+        if (!mapped) g_map.push_back({b->id, g_real.screen, b->x, b->y, b->x, b->x, b->y, b->y});
+        std::fprintf(stderr, "[nav] mark on %s: button %08X (%s) at (%.3f, %.3f) [pointer %.3f %.3f]; was %s, %s\n",
+                     g_activeName, b->id, b->owner.c_str(), b->x, b->y, wx, wy, known ? "in the file" : "new to the file",
+                     mapped ? "found by the grid" : "missed by the grid");
+    } else {
+        uint32_t id = 0xF0000001u;
+        while (LinkOf(sc, id)) ++id;
+        LinkButton b;
+        b.id = id;
+        b.owner = "point";
+        b.mark = b.point = true;
+        b.x = wx;
+        b.y = wy;
+        sc->buttons.push_back(b);
+        idx = sc->buttons.size() - 1;
+        std::fprintf(stderr, "[nav] mark on %s: point %08X at (%.3f, %.3f); the game reports no button there%s\n", g_activeName,
+                     id, wx, wy, fresh ? "" : " (hit test not running)");
+    }
+    LinkMark(*sc, idx);
+    char buf[96];
+    std::fprintf(stderr, "[nav]   links of %08X: %s\n", sc->buttons[idx].id, LinkText(sc->buttons[idx], buf, sizeof buf));
+    SaveLinks();
+}
+
+// Delete: take away the mark nearest the pointer.
+void UnmarkHere() {
+    if (!g_linksLoaded) LoadLinks();
+    LinkScreen* sc = Dynamic() || !FileLinksFor(ScreenKey()) ? nullptr : EditableLinksFor(ScreenKey());
+    if (!sc) return;
+    float wx = 0, wy = 0;
+    Wiimote_PointerPosition(&wx, &wy);
+    const bool fresh = g_frame - g_real.frame <= 3;
+    int best = -1;
+    float bestD = 0.15f;
+    for (size_t i = 0; i < sc->buttons.size(); ++i) {
+        const LinkButton& b = sc->buttons[i];
+        if (!b.mark) continue;
+        const float px = b.point || !fresh ? wx : g_real.x, py = b.point || !fresh ? wy : g_real.y;
+        const float dd = std::hypot(b.x - px, b.y - py);
+        if (dd < bestD) {
+            bestD = dd;
+            best = static_cast<int>(i);
+        }
+    }
+    if (best < 0) {
+        std::fprintf(stderr, "[nav] unmark on %s: no mark near the pointer\n", g_activeName);
+        return;
+    }
+    LinkButton& b = sc->buttons[static_cast<size_t>(best)];
+    std::fprintf(stderr, "[nav] unmark on %s: %08X\n", g_activeName, b.id);
+    if (!b.point) {
+        b.mark = false;
+    } else {
+        const uint32_t id = b.id;
+        sc->buttons.erase(sc->buttons.begin() + best);
+        for (auto& o : sc->buttons) {
+            for (auto& l : o.link) {
+                if (l == id) l = 0;
+            }
+        }
+        for (auto& k : sc->keys) {
+            if (k == id) k = 0;
+        }
+        AutoFill(*sc);
+        if (g_sel.id == id) g_sel = Selection{};
+    }
+    SaveLinks();
+}
+uint32_t DirOf(uint32_t pad) {
+    if (pad & kPadUp) return kPadUp;
+    if (pad & kPadDown) return kPadDown;
+    if (pad & kPadLeft) return kPadLeft;
+    if (pad & kPadRight) return kPadRight;
+    return 0;
+}
