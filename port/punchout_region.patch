+} // namespace
+
+// The game window's name and icon: "Re-Punched!!" (the project's name) with the launcher's glove (assets/punchout/icon.png) instead of
+// WiiCompiled's. The app ID is what Linux desktops match windows to icons and launchers by (Wayland app_id / X11
+// WM_CLASS); the launcher writes a matching re-punched.desktop. Called before aurora_initialize creates the window.
+extern "C" void PunchOut_WindowIdentity(void** rgba, uint32_t* width, uint32_t* height) {
+    SDL_SetAppMetadata("Re-Punched!!", nullptr, "re-punched");
+    const char* base = SDL_GetBasePath();
+    const std::filesystem::path file = std::filesystem::path(base ? base : "") / "assets" / "punchout" / "icon.png";
+    std::ifstream in(file, std::ios::binary);
+    const std::string bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    int w = 0, h = 0, channels = 0;
+    // Kept for the life of the process: Aurora builds the window icon from it when it creates the window.
+    static stbi_uc* pixels = nullptr;
+    if (!bytes.empty()) {
+        pixels = stbi_load_from_memory(reinterpret_cast<const stbi_uc*>(bytes.data()), static_cast<int>(bytes.size()),
+                                       &w, &h, &channels, 4);
+    }
+    if (pixels == nullptr) {
+        std::fprintf(stderr, "[punchout] no window icon at %s\n", file.string().c_str());
+        return;
+    }
+    *rgba = pixels;
+    *width = static_cast<uint32_t>(w);
+    *height = static_cast<uint32_t>(h);
+}
+
+extern "C" ImFont* PunchOut_BannerFont() {
+    return BannerFont();
+}
+
+// Called from the overlay's per-frame ImGui pass (settings_overlay.cpp Draw()).
+// "(LB) <  (RB) >   (A) OK  (B) Back" on menus: the page buttons only on screens where they turn a page
+// (PunchOut_MenuBumpers). Keyboard players get keycaps of their own keys instead.
+extern "C" void PunchOut_DrawPromptBanner() {
+    Style style = Style::Xbox;
+    const bool hasPad = ConnectedStyle(style);
+    // Keyboard art and keycaps while the keyboard was used last (or there is no controller at all).
+    const int last = Wiimote_LastInputDevice();
+    if (last == 1 || (last == 0 && !hasPad)) style = Style::Keyboard;
+    UpdateTexturePack(style); // also in fights: the mash prompt uses it
+    UpdatePromptArt(style);
+    const bool menu = PunchOut_MenuActive();
+    const bool keyboard = style == Style::Keyboard;
+    UpdateControlsLabel(keyboard, menu);
+    if (!menu || (!hasPad && !keyboard)) return;
+
+    // Controller: the glyphs of the fixed menu buttons (A / B) and the page buttons' bindings (bumpers by default).
+    // Keyboard: keycaps of the keys bound to the left punch (OK), right punch (Back) and the page keys.
+    struct Item {
+        const char* button;   // controller glyph (SDL position name), or nullptr
+        int key;              // keyboard: the key's code (PunchOutControls), kUnbound for none
+        uint32_t padBit;      // Wiimote_PadButtons bit: pressed look while held
+        const char* label;    // text, or nullptr for an arrow
+        int arrow;            // -1 left, +1 right
+        std::string fallback; // text when the glyph file is missing
+        bool groupEnd;        // wider gap after it
+    };
+    using namespace PunchOutControls;
+    const bool ps = style == Style::PlayStation;
+    const uint32_t bumpers = PunchOut_MenuBumpers();
+    std::vector<Item> items;
+    const auto add = [&](size_t control, const char* fixedGlyph, uint32_t bit, const char* label, int arrow,
+                         const std::string& fixedFallback, bool groupEnd) {
+        if (keyboard) {
+            const int key = FirstBinding(control, true);
+            if (key != kUnbound) items.push_back({nullptr, key, bit, label, arrow, "", groupEnd});
+            return;
+        }
+        if (fixedGlyph != nullptr) {
+            items.push_back({fixedGlyph, kUnbound, bit, label, arrow, fixedFallback, groupEnd});
+            return;
+        }
+        const int pad = FirstBinding(control, false);
+        if (pad == kUnbound) return;
+        items.push_back({PadGlyphName(pad), kUnbound, bit, label, arrow, PadName(pad), groupEnd});
+    };
+    if (bumpers & 1u) add(PagePrev, nullptr, 0x100u, nullptr, -1, "", !(bumpers & 2u));
+    if (bumpers & 2u) add(PageNext, nullptr, 0x200u, nullptr, +1, "", true);
+    add(One, "south", 0x10u, "OK", 0, ps ? "Cross" : "A", true);
+    add(Two, "east", 0x20u, "Back", 0, ps ? "Circle" : "B", true);
+    if (!items.empty() && !items.back().groupEnd) items.back().groupEnd = true;
+    const int count = static_cast<int>(items.size());
+    if (count == 0) return;
+
+    const ImGuiIO& io = ImGui::GetIO();
+    const float H = io.DisplaySize.y;
+    const float icon = H * 0.042f;     // glyph size
+    const float textSize = H * 0.028f; // label size
+    const float arrowW = textSize * 0.62f;
+    const float pad = icon * 0.35f, gap = icon * 0.25f, spacing = icon * 0.9f, small = icon * 0.4f;
+    ImFont* font = BannerFont();
+    // Keycaps (keyboard): the key's name or an arrow on a cap in the glyphs' look; wide names widen the cap.
+    const float capText = icon * 0.40f;
+    const auto capLabel = [&](const Item& it, int& arrowKey) { return KeycapLabel(it.key, arrowKey); };
+    const auto capWidth = [&](const Item& it) {
+        int arrowKey = 0;
+        const std::string text = capLabel(it, arrowKey);
+        if (arrowKey != 0) return icon;
+        return std::max(icon, font->CalcTextSizeA(capText, FLT_MAX, 0.0f, text.c_str()).x + icon * 0.55f);
+    };
+    const auto labelWidth = [&](const Item& it) {
+        return it.label ? font->CalcTextSizeA(textSize, FLT_MAX, 0.0f, it.label).x : arrowW;
+    };
+    const auto glyphWidth = [&](const Item& it) {
+        if (it.button == nullptr && it.key != kUnbound) return capWidth(it);
+        return it.button != nullptr && GetGlyph(style, it.button).ok
+                   ? icon : font->CalcTextSizeA(textSize, FLT_MAX, 0.0f, it.fallback.c_str()).x;
+    };
+
+    // Measure.
+    float width = pad;
+    for (int i = 0; i < count; ++i) {
+        width += glyphWidth(items[i]) + gap + labelWidth(items[i]);
+        width += i + 1 == count ? pad : items[i].groupEnd ? spacing : small;
+    }
+    const float height = icon + pad;
+    const ImVec2 p0(io.DisplaySize.x * 0.5f - width * 0.5f, H - height - H * 0.012f);
+    const ImVec2 p1(p0.x + width, p0.y + height);
+
+    ImDrawList* dl = ImGui::GetForegroundDrawList();
+    dl->AddRectFilled(p0, p1, IM_COL32(0, 0, 0, 150), height * 0.5f);
+    float x = p0.x + pad;
+    const float cy = p0.y + height * 0.5f;
+    const uint32_t held = Wiimote_PadButtons();
+    const ImU32 white = IM_COL32(255, 255, 255, 235);
+    for (int i = 0; i < count; ++i) {
+        const Item& it = items[i];
+        const bool down = (held & it.padBit) != 0;
+        if (it.button == nullptr && it.key != kUnbound) {
+            // Keycap: white rim, dark body, lighter top face (pushed in while held), then the name or an arrow.
+            const float w = capWidth(it), h = icon * 0.92f, r = h * 0.22f, rim = h * 0.07f;
+            const ImVec2 c0(x, cy - h * 0.5f), c1(x + w, cy + h * 0.5f);
+            dl->AddRectFilled(c0, c1, IM_COL32(255, 255, 255, 240), r);
+            dl->AddRectFilled(ImVec2(c0.x + rim, c0.y + rim), ImVec2(c1.x - rim, c1.y - rim), IM_COL32(44, 44, 46, 255),
+                              r - rim * 0.6f);
+            const float inset = h * 0.07f, push = down ? h * 0.08f : 0.f;
+            const ImVec2 t0(c0.x + rim + inset, c0.y + rim + inset * 0.6f + push);
+            const ImVec2 t1(c1.x - rim - inset, c1.y - rim - h * 0.16f + push);
+            dl->AddRectFilled(t0, t1, down ? IM_COL32(96, 96, 102, 255) : IM_COL32(70, 70, 74, 255), r * 0.7f);
+            const float tcx = (t0.x + t1.x) * 0.5f, tcy = (t0.y + t1.y) * 0.5f;
+            int arrowKey = 0;
+            const std::string text = capLabel(it, arrowKey);
+            if (arrowKey != 0) {
+                const float a = h * 0.17f;
+                ImVec2 v[3];
+                switch (arrowKey) {
+                case 1: v[0] = {tcx, tcy - a}; v[1] = {tcx - a, tcy + a * 0.7f}; v[2] = {tcx + a, tcy + a * 0.7f}; break;
+                case 2: v[0] = {tcx, tcy + a}; v[1] = {tcx + a, tcy - a * 0.7f}; v[2] = {tcx - a, tcy - a * 0.7f}; break;
+                case 3: v[0] = {tcx - a, tcy}; v[1] = {tcx + a * 0.7f, tcy + a}; v[2] = {tcx + a * 0.7f, tcy - a}; break;
+                default: v[0] = {tcx + a, tcy}; v[1] = {tcx - a * 0.7f, tcy - a}; v[2] = {tcx - a * 0.7f, tcy + a}; break;
+                }
+                dl->AddTriangleFilled(v[0], v[1], v[2], white);
+            } else {
+                const ImVec2 sz = font->CalcTextSizeA(capText, FLT_MAX, 0.0f, text.c_str());
+                dl->AddText(font, capText, ImVec2(tcx - sz.x * 0.5f, tcy - sz.y * 0.5f), white, text.c_str());
+            }
+            x += w;
+        } else {
+            const Glyph& up = it.button != nullptr ? GetGlyph(style, it.button) : Glyph{};
+            const Glyph& pressed = it.button != nullptr ? GetGlyph(style, it.button, true) : Glyph{};
+            const Glyph& g = down && pressed.ok ? pressed : up; // the pressed look while held
+            if (g.ok) {
+                dl->AddImage(g.tex, ImVec2(x, cy - icon * 0.5f), ImVec2(x + icon, cy + icon * 0.5f));
+                x += icon;
+            } else {
+                const ImVec2 sz = font->CalcTextSizeA(textSize, FLT_MAX, 0.0f, it.fallback.c_str());
+                dl->AddText(font, textSize, ImVec2(x, cy - sz.y * 0.5f), IM_COL32(255, 255, 255, 255), it.fallback.c_str());
+                x += sz.x;
+            }
+        }
+        x += gap;
+        if (it.label) {
+            const ImVec2 sz = font->CalcTextSizeA(textSize, FLT_MAX, 0.0f, it.label);
+            dl->AddText(font, textSize, ImVec2(x, cy - sz.y * 0.5f), white, it.label);
+        } else {
+            const float hh = arrowW * 0.62f; // half height
+            if (it.arrow < 0) {
+                dl->AddTriangleFilled(ImVec2(x, cy), ImVec2(x + arrowW, cy - hh), ImVec2(x + arrowW, cy + hh), white);
+            } else {
+                dl->AddTriangleFilled(ImVec2(x + arrowW, cy), ImVec2(x, cy - hh), ImVec2(x, cy + hh), white);
+            }
+        }
+        x += labelWidth(it) + (it.groupEnd ? spacing : small);
+    }
+}
