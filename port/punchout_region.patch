+enum class Style { Xbox, PlayStation, Keyboard };
+
+struct Glyph {
+    bool tried = false;
+    ImTextureID tex{};
+    bool ok = false;
+};
+std::unordered_map<std::string, Glyph> g_glyphs; // "<style>/<button>[_pressed]"
+
+// A glyph by SDL button position name (south, east, leftshoulder, ...), normal or pressed.
+const Glyph& GetGlyph(Style style, const char* button, bool pressed = false) {
+    std::string key = style == Style::PlayStation ? "playstation/" : "xbox/";
+    key += button;
+    if (pressed) key += "_pressed";
+    Glyph& g = g_glyphs[key];
+    if (g.tried) return g;
+    g.tried = true;
+    const char* base = SDL_GetBasePath();
+    const std::string path = std::string(base ? base : "") + "assets/glyphs/" + key + ".png";
+    int w = 0, h = 0, n = 0;
+    stbi_uc* rgba = stbi_load(path.c_str(), &w, &h, &n, 4);
+    if (rgba == nullptr) return g;
+    g.tex = aurora_imgui_add_texture(static_cast<uint32_t>(w), static_cast<uint32_t>(h), rgba);
+    stbi_image_free(rgba);
+    g.ok = true;
+    return g;
+}
+
+// The banner's font: Open Sans SemiBold (assets/fonts, SIL OFL), loaded once; ImGui 1.92+ rasterizes it at the
+// size asked for, so the labels stay sharp at any resolution. Missing file: ImGui's default font.
+ImFont* BannerFont() {
+    static bool tried = false;
+    static ImFont* font = nullptr;
+    if (!tried) {
+        tried = true;
+        const char* base = SDL_GetBasePath();
+        const std::string path = std::string(base ? base : "") + "assets/fonts/OpenSans-SemiBold.ttf";
+        if (FILE* f = std::fopen(path.c_str(), "rb")) {
+            std::fclose(f);
+            font = ImGui::GetIO().Fonts->AddFontFromFileTTF(path.c_str(), 32.0f);
+        }
+    }
+    return font ? font : ImGui::GetFont();
+}
