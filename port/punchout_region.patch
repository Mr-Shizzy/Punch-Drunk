+// Punch-Out!! Archipelago: game-side hooks (punchout_ap_game.cpp) and the memory the client shares with them. The
+// addresses are the Punch-Out Wii apworld's (dol_patch.py / client.py), so both sides match the Dolphin version.
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace PunchOutAp {
+
+// Game.
+constexpr uint32_t kFightPointer = 0x80412EA8u, kFightVtable = 0x8032CEACu, kFightBackup = 0x80B37810u;
+constexpr uint32_t kGameStatePointer = 0x80412EC0u; // +4 mode (1 = career), +0x10 opponent name
+constexpr uint32_t kProfileManagerPointer = 0x80412EE0u;
+constexpr uint32_t kMacBackupPointer = 0x80B37F6Cu;
+constexpr uint32_t kTiredTint = 0x804153A4u; // RGB, CC 33 FF
+// Patch data.
+constexpr uint32_t kSeedTag = 0x8021247Cu, kSeedMagic = 0x80212480u;
+constexpr uint32_t kSwapDebug = 0x80212490u, kSwapArmed = 0x802124A8u, kSwapTable = 0x802124ACu;
+constexpr uint32_t kInputMask = 0x80205A6Cu;
+constexpr uint32_t kHudFlag = 0x8023E734u, kStarTrapFlag = 0x8023E738u;
+constexpr uint32_t kSecondChances = 0x8023E73Cu, kSecondChancesFired = 0x8023E740u;
+constexpr uint32_t kSuperMacFlag = 0x8023E744u;
+constexpr uint32_t kFxState = 0x8031FEE8u, kFxLastMac = 0x8031FEECu;
+constexpr uint32_t kSuperMacIgnored = 0x8034118Cu, kTiredEffectName = 0x80341190u;
+constexpr uint32_t kClockTrapFlag = 0x803411BCu, kMacKnockdowns = 0x803411C0u, kMacKnockouts = 0x803411C4u;
+constexpr uint32_t kDamageMultiplier = 0x80342340u;
+
+struct GameSeedData {
+    uint32_t seedTag = 0;
+    uint8_t fighterOrder[26] = {};
+    // Cosmetics (the apworld's "cosmetics"): music shuffle as {fighter's event, track's event, GameMode state} rows,
+    // and Little Mac's outfits (0 = the game's own, 1 = per circuit, 2 = per fight; outfits 0 Minor, 1 Major, 2 World,
+    // 3 Alternate, 4 Evolved).
+    struct MusicRow {
+        uint32_t from, to, mode;
+    };
+    std::vector<MusicRow> music;
+    int outfitMode = 0;
+    uint8_t circuitOutfits[4] = {};
+    uint8_t boxerOutfits[32] = {};
+};
