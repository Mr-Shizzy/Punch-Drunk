+// ---- choosing buttons without the pointer ----
+// The FE cursor manager *(0x80413AF0), per player i (stride 0x20; per-player words at +4i):
+//   +0x18+4i controller (-1 = none), +0x128+4i mode (2 = pointing), +0x28/+0x2C pointer (screen units, y up, centre
+//   0), +0x32 pointer valid, +0x3C hovered button id, +0x40 pressed id, +0x44 hovered screen (presentation object),
+//   +0xBC/+0xC0/+0xC4 last frame's +0x3C/+0x40/+0x44, +0x158 list of registered selectables.
+// 80178BB8 (hit test) casts a ray through (0.5 + x/W, 0.5 - y/H) (W = 854 widescreen / 640, H = (480 - 2 *
+// *(0x80413D6C)) * 1.05882) against the selectables and fills +0x3C/+0x44 when +0x3C is 0; then 80178EF8 turns
+// changes into screen->OnButtonEvent(player, id, event) (vtable +0x2C): 1 enter, 2 stay, 3 leave, 4 A pressed, 5 held,
+// 6 released; the screen passes them to its button (state, sound, slide). +0x3C is cleared after the update.
+//
+// Mapping a screen: the hit-test wrapper (pseudo PAL 80FF0024) runs the game's own hit test again for points we
+// choose (pointer fields set, called, answer read, fields restored), 128 points a frame over a 48 x 27 grid: every
+// selectable the game would answer for (buttons, bare regions, 3D models like the hub's fighter) with its real area.
+// No pointer moves, nothing lags. Choosing: the cursor-update wrapper (pseudo PAL 80FF0020) writes the selected
+// (id, screen) into +0x3C/+0x44 right before the update, so the game highlights, sounds and presses that one.
+// Links: menu_links.txt in the user folder (UserData) holds per screen the buttons (by id), their D-pad links and which
+// one B / X / Y / LB / RB press. Screens not in it are recorded there on first visit (links from positions), and new
+// buttons are added as they show up; edit the file to change links (read at start).
+// Marks: point at something with the mouse / right stick and press Insert. If the game highlights a button there, that
+// button is kept at that spot (looked for there on every visit, even if the grid misses it) and linked to its
+// neighbours; if nothing highlights, a "point" mark is made: choosing it puts the real (hidden) pointer there and lets
+// the game's own pointer handling do the rest. Delete takes the nearest mark away again.
+
+constexpr uint32_t kCursorMgr = 0x80413AF0u;
+
+void NavLog(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void NavLog(const char* fmt, ...) {
+    if (g_navLogs >= 800) return;
+    ++g_navLogs;
+    char buf[512];
+    va_list args;
+    va_start(args, fmt);
+    std::vsnprintf(buf, sizeof buf, fmt, args);
+    va_end(args);
+    std::fprintf(stderr, "[nav] %s\n", buf);
+}
