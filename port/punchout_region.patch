+// Punch-Out!!: asynchronous reads complete later, from "interrupt" context, like the drive.
+// The data is copied at once, but the command block stays BUSY and the callback waits for the next
+// interrupt point (guest interrupt-enable edge or the scheduler idle loop). Wwise's I/O hook
+// (801B3CD0) issues DVDReadAsyncPrio and THEN marks its transfer pending; with the callback fired
+// inside the call, that write erased the completion, the stream starved and the music stopped mid-
+// fight / on the victory screens.
+struct PendingDvdCompletion {
+    uint32_t callback = 0;
+    int32_t result = 0;
+    uint32_t block = 0;
+};
+static std::mutex g_pendingDvdMutex;
+static std::deque<PendingDvdCompletion> g_pendingDvd;
+
+static bool DeferDvdCallbacks() {
+    return ::GuestRegion::Current() == ::GuestRegion::Id::PunchOut;
+}
+
+extern std::atomic<uint32_t> g_punchOutDvdReads;
+extern std::atomic<uint64_t> g_punchOutDvdBytes;
+
+// Load diagnostics: async reads per completion callback (identifies the reader: Wwise's I/O hook
+// completes through 801B3D90) and the time from one read's completion delivery to the next read.
+struct DvdReaderStats {
+    uint32_t reads = 0;
+    uint64_t bytes = 0;
+};
+static std::mutex g_dvdStatsMutex;
+static std::unordered_map<uint32_t, DvdReaderStats> g_dvdReaderStats;
+static std::chrono::steady_clock::time_point g_lastDvdDelivery{};
+static uint64_t g_dvdGapMicros = 0;
+static uint32_t g_dvdGapCount = 0;
+static uint32_t g_dvdGapMaxMicros = 0;
+
+extern "C" void DVD_HLE_PrintReaderStats() {
+    if (!PunchOutAudioTrace()) {
+        return;
+    }
+    std::vector<std::pair<uint32_t, DvdReaderStats>> rows;
+    uint64_t gapSum = 0;
+    uint32_t gapCount = 0;
+    uint32_t gapMax = 0;
+    {
+        std::lock_guard<std::mutex> lock(g_dvdStatsMutex);
+        rows.assign(g_dvdReaderStats.begin(), g_dvdReaderStats.end());
+        g_dvdReaderStats.clear();
+        gapSum = g_dvdGapMicros;
+        gapCount = g_dvdGapCount;
+        gapMax = g_dvdGapMaxMicros;
+        g_dvdGapMicros = 0;
+        g_dvdGapCount = 0;
+        g_dvdGapMaxMicros = 0;
+    }
+    if (rows.empty()) {
+        return;
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.second.reads > b.second.reads; });
+    std::fprintf(stderr, "[dvd] completion->next read avg %.2f ms max %.2f ms | by callback:",
+                 gapCount ? gapSum / 1000.0 / gapCount : 0.0, gapMax / 1000.0);
+    for (size_t i = 0; i < rows.size() && i < 4; ++i) {
+        std::fprintf(stderr, " %08X=%u reads/%.0f KB", rows[i].first, rows[i].second.reads,
+                     rows[i].second.bytes / 1024.0);
+    }
+    std::fprintf(stderr, "\n");
+}
+
+static void QueueDvdCompletion(uint32_t callbackPtr, int32_t result, uint32_t blockPtr) {
+    g_punchOutDvdReads.fetch_add(1, std::memory_order_relaxed);
+    {
+        std::lock_guard<std::mutex> lock(g_dvdStatsMutex);
+        auto& row = g_dvdReaderStats[callbackPtr];
+        row.reads++;
+        row.bytes += result > 0 ? static_cast<uint64_t>(result) : 0u;
+        if (g_lastDvdDelivery.time_since_epoch().count() != 0) {
+            const auto gap = std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - g_lastDvdDelivery).count();
+            if (gap >= 0 && gap < 1'000'000) {
+                g_dvdGapMicros += static_cast<uint64_t>(gap);
+                g_dvdGapCount++;
+                g_dvdGapMaxMicros = std::max(g_dvdGapMaxMicros, static_cast<uint32_t>(gap));
+            }
+        }
