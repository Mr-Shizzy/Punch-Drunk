+    static uint64_t lastFrames = ~0ull;
+    static int dumps = 0;
+    const uint64_t frames = g_punchOutPresentedFrames.load();
+    if (frames == lastFrames && dumps < 4) {
+        ++dumps;
+        PunchOutDumpThreads();
+    }
+    lastFrames = frames;
+    std::fflush(stderr);
+}
