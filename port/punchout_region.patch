+// Punch-Out!! busy-waits with interrupts briefly disabled and re-enabled (for example
+// `while (WPADGetStatus() != WPAD_STATE_SETUP) {}` during boot). On hardware, pending
+// interrupts land the moment they are re-enabled; here alarms, Bluetooth completions and
+// VI retraces only advance at frame/GX waits, so such loops never end. Deliver due work at
+// the enable point instead, rate-limited and never re-entrantly.
+void DeliverPendingAtInterruptEnable()
+{
+    if (::GuestRegion::Current() != ::GuestRegion::Id::PunchOut) {
+        return;
+    }
+    thread_local bool inside = false;
+    thread_local auto lastPump = std::chrono::steady_clock::time_point{};
+    if (inside) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (now - lastPump < std::chrono::microseconds(250)) {
+        return;
+    }
+    lastPump = now;
+    PunchOutHeartbeat("irq-enable");
+    SampleActivity();
+    inside = true;
+    // Like the deferred alarm path: run the interrupt callback, keep thread switches it
+    // causes (OSSendMessage -> OSWakeupThread) pending until we are back in guest code.
+    {
+        const uint32_t disableCount = ::Memory::Read32(kSchedulerIdleFlagAddr);
+        ::Memory::Write32(kSchedulerIdleFlagAddr, disableCount + 1u);
+        GX_HLE_DeliverPendingPeFinish();
+        DVD_HLE_DeliverPendingCallbacks();
+        ::Memory::Write32(kSchedulerIdleFlagAddr, disableCount);
+    }
+    VI_HLE_ProcessRetracesDeferred(2);
+    OS_HLE_ProcessAlarmsDeferred(8);
+    // Audio DMA ("AI interrupt", every 3 ms). It was only serviced when the scheduler went idle,
+    // a few ms per frame, so ~14 ms of AX frames were mixed back to back without the Wwise render
+    // thread ever running in between: its ring buffer was read past what it had written (stale
+    // audio, crackles, music "coming back" after a fade, cuts). Deliver it here like the other
+    // interrupts; the preemption check in the guest entry points then runs the woken thread.
+    // PUNCHOUT_AUDIO_EDGES=0 turns this off (A/B testing).
+    static const bool audioAtEdges = [] {
+        const char* v = std::getenv("PUNCHOUT_AUDIO_EDGES");
+        return !(v && *v == '0');
+    }();
+    if (audioAtEdges) {
+        Audio_HLE_PollDeferred();
+    }
+    inside = false;
