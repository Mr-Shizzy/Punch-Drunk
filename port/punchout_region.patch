+std::string DescribeButtons() {
+    std::string text;
+    for (const auto& t : g_targets) {
+        if (!t.extra) continue;
+        char buf[160];
+        std::snprintf(buf, sizeof buf, "\n    extra hit %08X at (%.3f, %.3f) %.3f x %.3f%s", t.hit, t.cx, t.cy, t.hw * 2, t.hh * 2,
+                      t.sx < 0 ? " flipped" : "");
+        text += buf;
+    }
+    for (const auto& b : g_buttons) {
+        char buf[200];
+        std::snprintf(buf, sizeof buf, "\n    %s+%03X%s vt %08X inst %08X %-24s state %u id %08X", b.navBar ? "bar" : "scr",
+                      b.addr >= g_activePres && b.addr < g_activePres + 0x800u ? b.addr - g_activePres : 0xFFFu,
+                      b.addr >= g_activePres && b.addr < g_activePres + 0x800u ? "" : "*", R32(b.addr), b.inst,
+                      b.name.empty() ? "-" : b.name.c_str(), b.state, b.id);
+        text += buf;
+        if (b.geom) {
+            std::snprintf(buf, sizeof buf, " hit %08X at (%.3f, %.3f) %.3f x %.3f%s", b.hit, b.cx, b.cy, b.hw * 2, b.hh * 2,
+                          b.sx < 0 ? " flipped" : "");
+        } else {
+            if (b.hit) {
+                std::snprintf(buf, sizeof buf, " hit %08X unusable: at (%.3f, %.3f) %.3f x %.3f", b.hit, b.cx, b.cy, b.hw * 2,
+                              b.hh * 2);
+            } else {
+                std::snprintf(buf, sizeof buf, " no hit region");
+            }
+        }
+        text += buf;
+    }
+    return text;
+}
