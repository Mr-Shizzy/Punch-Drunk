+// The style for the first connected controller (PlayStation pads get their own glyphs, everything else Xbox's).
+bool ConnectedStyle(Style& style) {
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetGamepads(&count);
+    if (ids == nullptr) return false;
+    const bool any = count > 0;
+    if (any) {
+        switch (SDL_GetGamepadTypeForID(ids[0])) {
+        case SDL_GAMEPAD_TYPE_PS3:
+        case SDL_GAMEPAD_TYPE_PS4:
+        case SDL_GAMEPAD_TYPE_PS5:
+            style = Style::PlayStation;
+            break;
+        default:
+            style = Style::Xbox;
+            break;
+        }
+    }
+    SDL_free(ids);
+    // [punchout] button_style = "xbox" / "playstation" forces the glyphs (any controller); "auto" goes by the pad.
+    static const std::string forced = RuntimeConfigFile::ButtonStyle();
+    if (forced == "playstation") style = Style::PlayStation;
+    if (forced == "xbox") style = Style::Xbox;
+    return any;
+}
+
+// The game's own Wii button art (mash 1 / 2, "Press A", the controls screen's remote) swapped for the connected
+// controller's: assets/texture_packs/<xbox|playstation> loaded as texture replacements at a high priority (over
+// UserData/texture_replacements), and swapped when the controller style changes. Nothing to copy by hand.
+void UpdateTexturePack(Style style) {
+    static int loaded = -1;
+    static aurora::texture::ReplacementGroup group;
+    const int want = static_cast<int>(style);
+    if (want == loaded) return;
+    if (loaded >= 0) aurora::texture::unregister_replacements(group);
+    const char* base = SDL_GetBasePath();
+    const std::filesystem::path dir = std::filesystem::path(base ? base : "") / "assets" / "texture_packs" /
+                                      (style == Style::PlayStation ? "playstation"
+                                       : style == Style::Keyboard  ? "keyboard"
+                                                                   : "xbox");
+    group = aurora::texture::load_replacement_directory(dir, aurora::texture::ReplacementOptions{.priority = 100});
+    loaded = want;
+    std::fprintf(stderr, "[prompts] texture pack: %s (%zu textures)\n",
+                 style == Style::PlayStation ? "playstation" : style == Style::Keyboard ? "keyboard" : "xbox",
+                 group.registrations.size());
+}
