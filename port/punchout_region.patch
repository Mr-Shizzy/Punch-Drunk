+}
+bool IsNavBar(uint32_t hash) {
+    return hash == FeHash("art/fe/navigation_widescreen") || hash == FeHash("art/fe/navigation_standard");
+}
+// In a fight (or a cutscene) the pad keeps the normal mapping.
