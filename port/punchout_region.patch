+// The hit test's screen size (as the game computes it).
+void HitScale(float& w, float& h) {
+    w = R8(0x80411DD0u) ? 854.f : 640.f;
+    h = static_cast<float>(static_cast<uint32_t>((480.f - 2.f * static_cast<float>(R32(0x80413D6Cu))) * 1.05882f));
+}
