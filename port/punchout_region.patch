+
+void CloseSocket(SocketHandle s) {
+#ifdef _WIN32
+    closesocket(s);
+#else
+    ::close(s);
+#endif
+}
+
+bool EnsureSockets() {
+#ifdef _WIN32
+    static const bool ok = [] {
+        WSADATA data;
+        return WSAStartup(MAKEWORD(2, 2), &data) == 0;
+    }();
+    return ok;
+#else
+    return true;
+#endif
+}
+
+// Waits until the socket is readable (or writable); false on timeout.
+bool WaitSocket(SocketHandle s, bool forWrite, int timeoutMs) {
+#ifdef _WIN32
+    WSAPOLLFD p{};
+    p.fd = s;
+    p.events = forWrite ? POLLWRNORM : POLLRDNORM;
+    return WSAPoll(&p, 1, timeoutMs) > 0;
+#else
+    pollfd p{};
+    p.fd = s;
+    p.events = forWrite ? POLLOUT : POLLIN;
+    int r;
+    do {
+        r = ::poll(&p, 1, timeoutMs);
+    } while (r < 0 && errno == EINTR);
+    return r > 0;
+#endif
+}
+
+void SetBlocking(SocketHandle s, bool blocking) {
+#ifdef _WIN32
+    u_long mode = blocking ? 0 : 1;
+    ioctlsocket(s, FIONBIO, &mode);
+#else
+    const int flags = fcntl(s, F_GETFL, 0);
+    fcntl(s, F_SETFL, blocking ? (flags & ~O_NONBLOCK) : (flags | O_NONBLOCK));
+#endif
+}
+
+SocketHandle ConnectTcp(const std::string& host, uint16_t port, std::string& error) {
+    if (!EnsureSockets()) {
+        error = "sockets unavailable";
+        return kNoSocket;
+    }
+    addrinfo hints{};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    addrinfo* list = nullptr;
+    const std::string service = std::to_string(port);
+    if (getaddrinfo(host.c_str(), service.c_str(), &hints, &list) != 0 || list == nullptr) {
+        error = "can't find server " + host;
+        return kNoSocket;
+    }
+    SocketHandle result = kNoSocket;
+    for (addrinfo* a = list; a != nullptr && result == kNoSocket; a = a->ai_next) {
+        SocketHandle s = ::socket(a->ai_family, a->ai_socktype, a->ai_protocol);
+        if (s == kNoSocket) continue;
+        SetBlocking(s, false);
+        const int r = ::connect(s, a->ai_addr, static_cast<int>(a->ai_addrlen));
+        bool ok = r == 0;
+        if (!ok) {
+#ifdef _WIN32
+            const bool pending = WSAGetLastError() == WSAEWOULDBLOCK;
+#else
+            const bool pending = errno == EINPROGRESS;
+#endif
+            if (pending && WaitSocket(s, true, 8000)) {
+                int soError = 0;
+                socklen_t len = sizeof soError;
+                getsockopt(s, SOL_SOCKET, SO_ERROR, reinterpret_cast<char*>(&soError), &len);
+                ok = soError == 0;
+            }
+        }
+        if (ok) {
+            SetBlocking(s, true);
+            int one = 1;
+            setsockopt(s, IPPROTO_TCP, TCP_NODELAY, reinterpret_cast<const char*>(&one), sizeof one);
+            result = s;
+        } else {
+            CloseSocket(s);
+        }
+    }
+    freeaddrinfo(list);
+    if (result == kNoSocket) error = "can't connect to " + host + ":" + service;
+    return result;
+}
+
+std::string Base64(const uint8_t* data, size_t n) {
+    static const char* t = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;
+    for (size_t i = 0; i < n; i += 3) {
+        const uint32_t v = (uint32_t(data[i]) << 16) | (i + 1 < n ? uint32_t(data[i + 1]) << 8 : 0) |
+                           (i + 2 < n ? uint32_t(data[i + 2]) : 0);
+        out.push_back(t[(v >> 18) & 63]);
+        out.push_back(t[(v >> 12) & 63]);
+        out.push_back(i + 1 < n ? t[(v >> 6) & 63] : '=');
+        out.push_back(i + 2 < n ? t[v & 63] : '=');
+    }
+    return out;
+}
+
+#ifdef PO_AP_TLS
+// Same CA bundle the runtime's own TLS uses (cacert.pem next to the executable, or the source tree's).
+std::optional<std::filesystem::path> FindCaBundle() {
+    if (const auto dir = RuntimeConfigFile::ExecutableDirectory()) {
+        const auto p = *dir / "cacert.pem";
+        if (std::filesystem::is_regular_file(p)) return p;
+    }
+    for (auto base = std::filesystem::current_path(); !base.empty();) {
+        const auto p = base / "runtime" / "assets" / "certs" / "cacert.pem";
+        if (std::filesystem::is_regular_file(p)) return p;
+        const auto parent = base.parent_path();
+        if (parent == base) break;
+        base = parent;
+    }
+    for (const char* sys : {"/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt",
+                            "/etc/ssl/cert.pem"}) {
+        if (std::filesystem::is_regular_file(sys)) return std::filesystem::path(sys);
+    }
+    return std::nullopt;
+}
+
+struct TlsGlobals {
+    bool ok = false;
+    std::string error;
+    mbedtls_x509_crt ca;
+    mbedtls_entropy_context entropy;
+    mbedtls_ctr_drbg_context drbg;
+};
+TlsGlobals& Tls() {
+    static TlsGlobals g = [] {
+        TlsGlobals t;
+        mbedtls_x509_crt_init(&t.ca);
+        mbedtls_entropy_init(&t.entropy);
+        mbedtls_ctr_drbg_init(&t.drbg);
+        psa_crypto_init(); // TLS 1.3 in mbed TLS 3.x needs PSA
+        const char* pers = "punchout_archipelago";
+        if (mbedtls_ctr_drbg_seed(&t.drbg, mbedtls_entropy_func, &t.entropy,
+                                  reinterpret_cast<const unsigned char*>(pers), std::strlen(pers)) != 0) {
+            t.error = "TLS random number generator failed";
+            return t;
+        }
+        const auto bundle = FindCaBundle();
+        if (!bundle || mbedtls_x509_crt_parse_file(&t.ca, bundle->string().c_str()) < 0) {
+            t.error = "no TLS certificate bundle (cacert.pem)";
+            return t;
+        }
+        t.ok = true;
+        return t;
+    }();
+    return g;
+}
+#endif
+
+} // namespace ap_net
+using namespace ap_net;
+
+struct WebSocket::Impl {
+    SocketHandle sock = kNoSocket;
+    bool secure = false;
+    bool open = false;
+    std::vector<uint8_t> in;       // received, not yet parsed
+    std::string fragment;          // a message arriving in pieces
+    bool deflate = false;          // permessage-deflate agreed (server_no_context_takeover: each message on its own)
+    bool fragmentCompressed = false;
+    std::mt19937 rng{std::random_device{}()};
+#ifdef PO_AP_TLS
+    bool tlsReady = false;
+    mbedtls_net_context net;
+    mbedtls_ssl_context ssl;
+    mbedtls_ssl_config conf;
+#endif
+
+    // Raw I/O (through TLS when secure). Send: all or false. Recv: >0 bytes, 0 closed, -1 error, -2 nothing yet.
+    bool SendAll(const uint8_t* p, size_t n) {
+        while (n > 0) {
+#ifdef PO_AP_TLS
+            if (secure) {
+                const int r = mbedtls_ssl_write(&ssl, p, n);
+                if (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE) continue;
+                if (r <= 0) return false;
+                p += r;
+                n -= size_t(r);
+                continue;
+            }
+#endif
+#ifdef _WIN32
+            const int r = ::send(sock, reinterpret_cast<const char*>(p), static_cast<int>(n), 0);
+#elif defined(__APPLE__)
+            const ssize_t r = ::send(sock, p, n, 0);
+#else
+            const ssize_t r = ::send(sock, p, n, MSG_NOSIGNAL);
+#endif
+            if (r <= 0) return false;
+            p += r;
+            n -= size_t(r);
+        }
+        return true;
+    }
+    int Recv(uint8_t* p, size_t n, int timeoutMs) {
+#ifdef PO_AP_TLS
+        if (secure) {
+            if (mbedtls_ssl_get_bytes_avail(&ssl) == 0 && !WaitSocket(sock, false, timeoutMs)) return -2;
+            const int r = mbedtls_ssl_read(&ssl, p, n);
+            if (r == MBEDTLS_ERR_SSL_WANT_READ || r == MBEDTLS_ERR_SSL_WANT_WRITE) return -2;
+            if (r == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY || r == 0) return 0;
+            return r < 0 ? -1 : r;
+        }
+#endif
+        if (!WaitSocket(sock, false, timeoutMs)) return -2;
+#ifdef _WIN32
+        const int r = ::recv(sock, reinterpret_cast<char*>(p), static_cast<int>(n), 0);
+#else
+        const ssize_t r = ::recv(sock, p, n, 0);
+#endif
+        return r < 0 ? -1 : static_cast<int>(r);
+    }
+
+    bool SendFrame(uint8_t opcode, const uint8_t* data, size_t n) {
+        std::vector<uint8_t> f;
+        f.reserve(n + 14);
+        f.push_back(uint8_t(0x80 | opcode));
+        if (n < 126) {
+            f.push_back(uint8_t(0x80 | n));
+        } else if (n < 65536) {
+            f.push_back(0x80 | 126);
+            f.push_back(uint8_t(n >> 8));
+            f.push_back(uint8_t(n));
+        } else {
+            f.push_back(0x80 | 127);
+            for (int i = 7; i >= 0; --i) f.push_back(uint8_t(uint64_t(n) >> (i * 8)));
+        }
+        uint8_t mask[4];
+        for (uint8_t& m : mask) m = uint8_t(rng());
+        f.insert(f.end(), mask, mask + 4);
+        for (size_t i = 0; i < n; ++i) f.push_back(uint8_t(data[i] ^ mask[i & 3]));
+        return SendAll(f.data(), f.size());
+    }
+
+    void Shutdown() {
+#ifdef PO_AP_TLS
+        if (tlsReady) {
+            if (open) mbedtls_ssl_close_notify(&ssl);
+            mbedtls_ssl_free(&ssl);
+            mbedtls_ssl_config_free(&conf);
+            tlsReady = false;
+        }
+#endif
+        if (sock != kNoSocket) CloseSocket(sock);
+        sock = kNoSocket;
+        open = false;
+        in.clear();
+        fragment.clear();
+        deflate = false;
+        fragmentCompressed = false;
+    }
+};
+
+WebSocket::WebSocket() : m_impl(std::make_unique<Impl>()) {}
+WebSocket::~WebSocket() {
+    Close();
+}
+
+bool WebSocket::TlsAvailable() {
+#ifdef PO_AP_TLS
+    return true;
+#else
+    return false;
+#endif
+}
+
+bool WebSocket::Connected() const {
+    return m_impl->open;
+}
+
+bool WebSocket::Connect(const std::string& host, uint16_t port, bool secure, std::string& error) {
+    Impl& w = *m_impl;
+    w.Shutdown();
+    w.secure = secure;
+#ifndef PO_AP_TLS
+    if (secure) {
+        error = "secure (wss) connections aren't available in this build";
+        return false;
+    }
+#endif
+    w.sock = ConnectTcp(host, port, error);
+    if (w.sock == kNoSocket) return false;
+
+#ifdef PO_AP_TLS
+    if (secure) {
+        TlsGlobals& g = Tls();
+        if (!g.ok) {
+            error = g.error;
+            w.Shutdown();
+            return false;
+        }
+        mbedtls_ssl_init(&w.ssl);
+        mbedtls_ssl_config_init(&w.conf);
+        w.tlsReady = true;
+        if (mbedtls_ssl_config_defaults(&w.conf, MBEDTLS_SSL_IS_CLIENT, MBEDTLS_SSL_TRANSPORT_STREAM,
+                                        MBEDTLS_SSL_PRESET_DEFAULT) != 0) {
+            error = "TLS setup failed";
+            w.Shutdown();
+            return false;
+        }
+        mbedtls_ssl_conf_authmode(&w.conf, MBEDTLS_SSL_VERIFY_REQUIRED);
+        mbedtls_ssl_conf_ca_chain(&w.conf, &g.ca, nullptr);
+        mbedtls_ssl_conf_rng(&w.conf, mbedtls_ctr_drbg_random, &g.drbg);
+        if (mbedtls_ssl_setup(&w.ssl, &w.conf) != 0) {
+            error = "TLS setup failed";
+            w.Shutdown();
+            return false;
+        }
+        mbedtls_ssl_set_hostname(&w.ssl, host.c_str());
+        mbedtls_net_init(&w.net);
+        w.net.fd = static_cast<int>(w.sock);
+        mbedtls_ssl_set_bio(&w.ssl, &w.net, mbedtls_net_send, mbedtls_net_recv, nullptr);
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(6);
+        int r;
+        while ((r = mbedtls_ssl_handshake(&w.ssl)) != 0) {
+            if ((r != MBEDTLS_ERR_SSL_WANT_READ && r != MBEDTLS_ERR_SSL_WANT_WRITE) ||
+                std::chrono::steady_clock::now() > deadline) {
+                char buf[160];
+                mbedtls_strerror(r, buf, sizeof buf);
+                error = std::string("secure connection failed: ") + buf;
+                w.Shutdown();
+                return false;
+            }
+        }
+    }
+#endif
+
+    // HTTP upgrade.
+    uint8_t keyBytes[16];
+    for (uint8_t& b : keyBytes) b = uint8_t(w.rng());
+    const std::string request = "GET / HTTP/1.1\r\nHost: " + host + ":" + std::to_string(port) +
+                                "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " +
+                                Base64(keyBytes, 16) + "\r\nSec-WebSocket-Version: 13\r\n" +
+                                // Compressed messages (Archipelago asks for them), each one on its own so a
+                                // stateless inflate can read it; ours go out uncompressed (allowed).
+                                "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; "
+                                "client_no_context_takeover\r\n" +
+                                "User-Agent: WiiCompiled-PunchOut\r\n\r\n";
+    if (!w.SendAll(reinterpret_cast<const uint8_t*>(request.data()), request.size())) {
+        error = "server closed the connection";
+        w.Shutdown();
+        return false;
+    }
+    std::string response;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (response.find("\r\n\r\n") == std::string::npos) {
+        uint8_t buf[1024];
+        const int r = w.Recv(buf, sizeof buf, 200);
+        if (r == -2) {
+            if (std::chrono::steady_clock::now() > deadline) break;
+            continue;
+        }
+        if (r <= 0) break;
+        response.append(reinterpret_cast<const char*>(buf), size_t(r));
+        if (response.size() > 65536) break;
+    }
+    const size_t end = response.find("\r\n\r\n");
+    if (end == std::string::npos || response.compare(0, 12, "HTTP/1.1 101") != 0) {
+        error = end == std::string::npos ? "no answer from the server"
+                                         : "not an Archipelago server (" + response.substr(0, response.find("\r\n")) + ")";
+        w.Shutdown();
+        return false;
+    }
+    {
+        std::string headers = response.substr(0, end);
+        for (char& c : headers) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        w.deflate = headers.find("sec-websocket-extensions:") != std::string::npos &&
+                    headers.find("permessage-deflate") != std::string::npos;
+    }
+    // Anything after the headers is already WebSocket data.
+    w.in.assign(response.begin() + static_cast<std::ptrdiff_t>(end + 4), response.end());
+    w.open = true;
+    return true;
+}
+
+bool WebSocket::SendText(const std::string& text) {
+    Impl& w = *m_impl;
+    if (!w.open) return false;
+    if (!w.SendFrame(0x1, reinterpret_cast<const uint8_t*>(text.data()), text.size())) {
+        w.Shutdown();
+        return false;
+    }
+    return true;
+}
+
+bool WebSocket::Poll(int timeoutMs, std::vector<std::string>& messages, std::string& error) {
+    Impl& w = *m_impl;
+    if (!w.open) {
+        error = "not connected";
+        return false;
+    }
+    // Read what's there (waiting at most timeoutMs for the first bytes).
+    for (int round = 0; round < 64; ++round) {
+        uint8_t buf[16384];
+        const int r = w.Recv(buf, sizeof buf, round == 0 ? timeoutMs : 0);
+        if (r == -2) break;
+        if (r <= 0) {
+            error = r == 0 ? "the server closed the connection" : "connection lost";
+            w.Shutdown();
+            return false;
+        }
+        w.in.insert(w.in.end(), buf, buf + r);
+    }
+    // Parse complete frames.
+    size_t pos = 0;
+    while (true) {
+        const size_t avail = w.in.size() - pos;
+        if (avail < 2) break;
+        const uint8_t* p = w.in.data() + pos;
+        const bool fin = (p[0] & 0x80) != 0;
+        const uint8_t opcode = p[0] & 0x0F;
+        const bool masked = (p[1] & 0x80) != 0;
+        uint64_t len = p[1] & 0x7F;
+        size_t header = 2;
+        if (len == 126) {
+            if (avail < 4) break;
+            len = (uint64_t(p[2]) << 8) | p[3];
+            header = 4;
+        } else if (len == 127) {
+            if (avail < 10) break;
+            len = 0;
+            for (int i = 0; i < 8; ++i) len = (len << 8) | p[2 + i];
+            header = 10;
+        }
+        if (len > (64ull << 20)) {
+            error = "message too big";
+            w.Shutdown();
+            return false;
+        }
+        const size_t maskAt = header;
+        if (masked) header += 4;
+        if (avail < header + len) break;
+        std::string payload(reinterpret_cast<const char*>(p + header), size_t(len));
+        if (masked) {
+            for (size_t i = 0; i < payload.size(); ++i) payload[i] = char(payload[i] ^ p[maskAt + (i & 3)]);
+        }
+        pos += header + size_t(len);
+        switch (opcode) {
+        case 0x0: // continuation
+        case 0x1: // text
+        case 0x2: // binary
+            if (opcode != 0x0) w.fragmentCompressed = w.deflate && (p[0] & 0x40) != 0; // RSV1 on the first frame
+            w.fragment += payload;
+            if (fin) {
+                if (w.fragmentCompressed) {
+                    // Raw deflate ending in a sync flush; 00 00 FF FF completes it and 03 00 (an empty final block)
+                    // ends the stream for the one-shot decoder.
+                    w.fragment.append("\x00\x00\xff\xff\x03\x00", 6);
+                    int outLen = 0;
+                    char* out = stbi_zlib_decode_noheader_malloc(w.fragment.data(), static_cast<int>(w.fragment.size()), &outLen);
+                    if (out == nullptr) {
+                        error = "couldn't read a compressed message";
+                        w.Shutdown();
+                        return false;
+                    }
+                    messages.emplace_back(out, static_cast<size_t>(outLen));
+                    std::free(out);
+                } else {
+                    messages.push_back(std::move(w.fragment));
+                }
+                w.fragment.clear();
+                w.fragmentCompressed = false;
+            }
+            break;
+        case 0x8: // close
+            w.SendFrame(0x8, reinterpret_cast<const uint8_t*>(payload.data()), std::min<size_t>(payload.size(), 2));
+            w.in.clear();
+            error = "the server closed the connection";
+            w.Shutdown();
+            return false;
+        case 0x9: // ping
+            w.SendFrame(0xA, reinterpret_cast<const uint8_t*>(payload.data()), payload.size());
+            break;
+        default:
+            break;
+        }
+    }
+    w.in.erase(w.in.begin(), w.in.begin() + static_cast<std::ptrdiff_t>(pos));
+    return true;
+}
+
+void WebSocket::Close() {
+    if (m_impl->open) m_impl->SendFrame(0x8, nullptr, 0);
+    m_impl->Shutdown();
+}
+
+bool ParseServerAddress(const std::string& text, ServerAddress& out) {
+    std::string s = text;
+    s.erase(0, s.find_first_not_of(" \t"));
+    s.erase(s.find_last_not_of(" \t/") + 1);
+    out = ServerAddress{};
+    if (s.rfind("wss://", 0) == 0) {
+        out.scheme = 2;
+        s = s.substr(6);
+    } else if (s.rfind("ws://", 0) == 0) {
+        out.scheme = 1;
+        s = s.substr(5);
+    }
+    if (s.empty()) return false;
+    const size_t colon = s.rfind(':');
+    if (colon != std::string::npos && s.find(']') == std::string::npos) {
+        const std::string port = s.substr(colon + 1);
+        if (port.empty() || port.find_first_not_of("0123456789") != std::string::npos) return false;
+        const unsigned long p = std::stoul(port);
+        if (p == 0 || p > 65535) return false;
+        out.port = static_cast<uint16_t>(p);
+        s = s.substr(0, colon);
+    }
+    out.host = s;
+    return !out.host.empty();
+}
+
+} // namespace PunchOutAp
diff --git a/runtime/src/hle/punchout_ap_net.h b/runtime/src/hle/punchout_ap_net.h
new file mode 100644
index 0000000..07c4e89
--- /dev/null
+++ b/runtime/src/hle/punchout_ap_net.h
@@ -0,0 +1,45 @@
+// Punch-Out!! Archipelago: a small WebSocket client (RFC 6455, client side) over TCP, with TLS (wss://) through
+// mbed TLS where the runtime builds it (not Windows yet: there only ws:// connects). Blocking calls; meant to be
+// owned by one network thread (punchout_ap_client.cpp).
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace PunchOutAp {
+
+class WebSocket {
+public:
+    WebSocket();
+    ~WebSocket();
+    WebSocket(const WebSocket&) = delete;
+    WebSocket& operator=(const WebSocket&) = delete;
+
+    // Connects and upgrades. secure = wss (TLS). Returns false with a readable reason.
+    bool Connect(const std::string& host, uint16_t port, bool secure, std::string& error);
+    bool Connected() const;
+    bool SendText(const std::string& text);
+    // Waits up to timeoutMs for data, then returns every complete text message received (pings answered).
+    // False once the connection is closed or broken (error says why).
+    bool Poll(int timeoutMs, std::vector<std::string>& messages, std::string& error);
+    void Close();
+
+    static bool TlsAvailable();
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+// "host", "host:port", "ws://host:port", "wss://host:port" -> parts. Port defaults to 38281; no scheme = try
+// wss then ws (what Archipelago's own clients do).
+struct ServerAddress {
+    std::string host;
+    uint16_t port = 38281;
+    int scheme = 0; // 0 either (wss first), 1 ws only, 2 wss only
+};
+bool ParseServerAddress(const std::string& text, ServerAddress& out);
+
+} // namespace PunchOutAp
diff --git a/runtime/src/hle/punchout_ap_session.cpp b/runtime/src/hle/punchout_ap_session.cpp
new file mode 100644
index 0000000..511a316
--- /dev/null
+++ b/runtime/src/hle/punchout_ap_session.cpp
@@ -0,0 +1,415 @@
+// Punch-Out!! Archipelago server session (see punchout_ap_session.h).
+
+#include "punchout_ap_session.h"
+
+#include "punchout_ap_net.h"
+#include "runtime_config.h"
+
+#include <cctype>
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <sstream>
+
+namespace PunchOutAp {
+namespace ap_session {
+
+namespace fs = std::filesystem;
+
+// Archipelago's text colours (the ones its own clients use).
+constexpr uint32_t kWhite = 0xFFFFFF, kMagenta = 0xEE00EE, kYellow = 0xFAFAD2, kGreen = 0x00FF7F,
+                   kCyan = 0x00EEEE, kPlum = 0xAF99EF, kSlateBlue = 0x6D8BE8, kSalmon = 0xFA8072, kBlue = 0x6495ED,
+                   kRed = 0xEE0000;
+
+double Seconds() {
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+}
+
+fs::path CacheDir() {
+    return RuntimeConfigFile::ApplicationDataDirectory() / "Cache" / "archipelago";
+}
+
+std::string SafeName(const std::string& s) {
+    std::string out;
+    for (char c : s) out.push_back((std::isalnum(static_cast<unsigned char>(c)) || c == '-' || c == '_') ? c : '_');
+    return out;
+}
+
+// A stable id for this install (Archipelago wants one per client).
+std::string ClientUuid() {
+    const fs::path p = CacheDir() / "uuid.txt";
+    std::ifstream in(p);
+    std::string id;
+    if (in && std::getline(in, id) && id.size() >= 16) return id;
+    std::mt19937_64 rng{std::random_device{}()};
+    char buf[40];
+    std::snprintf(buf, sizeof buf, "%016llx%016llx", static_cast<unsigned long long>(rng()),
+                  static_cast<unsigned long long>(rng()));
+    std::error_code ec;
+    fs::create_directories(p.parent_path(), ec);
+    std::ofstream(p) << buf << "\n";
+    return buf;
+}
+
+uint32_t ItemColor(int flags) {
+    if (flags & 1) return kPlum;      // progression
+    if (flags & 2) return kSlateBlue; // useful
+    if (flags & 4) return kSalmon;    // trap
+    return kCyan;
+}
+
+} // namespace ap_session
+using namespace ap_session;
+
+Session& Session::Get() {
+    static Session s;
+    return s;
+}
+
+double Session::Now() const {
+    return Seconds() - m_start;
+}
+
+void Session::Start(const SessionSettings& settings) {
+    Stop();
+    m_stop = false;
+    m_start = Seconds();
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_outbox.clear();
+        m_inbox.clear();
+        m_status = "Connecting...";
+    }
+    m_state = SessionState::Connecting;
+    m_thread = std::thread([this, settings] { Run(settings); });
+}
+
+void Session::Stop() {
+    m_stop = true;
+    if (m_thread.joinable()) m_thread.join();
+    m_state = SessionState::Off;
+    m_slot = -1;
+}
+
+std::string Session::StatusText() const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_status;
+}
+
+void Session::Send(Json command) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_outbox.push_back(std::move(command));
+}
+
+bool Session::PopEvent(Json& out) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_inbox.empty()) return false;
+    out = std::move(m_inbox.front());
+    m_inbox.pop_front();
+    return true;
+}
+
+std::string Session::PlayerName(int slot) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto it = m_players.find(slot);
+    if (it != m_players.end()) return it->second.first;
+    return slot == 0 ? "Server" : "Player " + std::to_string(slot);
+}
+
+std::string Session::PlayerGame(int slot) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto it = m_players.find(slot);
+    return it != m_players.end() ? it->second.second : std::string("Archipelago");
+}
+
+std::string Session::ItemName(const std::string& game, int64_t id) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (const std::string& g : {game, std::string("Archipelago")}) {
+        const auto t = m_itemNames.find(g);
+        if (t == m_itemNames.end()) continue;
+        const auto n = t->second.find(id);
+        if (n != t->second.end()) return n->second;
+    }
+    return "Item " + std::to_string(id);
+}
+
+std::string Session::LocationName(const std::string& game, int64_t id) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (const std::string& g : {game, std::string("Archipelago")}) {
+        const auto t = m_locationNames.find(g);
+        if (t == m_locationNames.end()) continue;
+        const auto n = t->second.find(id);
+        if (n != t->second.end()) return n->second;
+    }
+    return "Location " + std::to_string(id);
+}
+
+void Session::Log(std::vector<LogSegment> segments) {
+    std::string plain;
+    for (const auto& s : segments) plain += s.text;
+    std::fprintf(stderr, "[archipelago] %s\n", plain.c_str());
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_log.push_back({std::move(segments), Seconds() - m_start});
+    while (m_log.size() > 300) m_log.pop_front();
+    ++m_logSerial;
+}
+
+void Session::LogText(const std::string& text, uint32_t color) {
+    Log({{text, color}});
+}
+
+std::vector<LogLine> Session::LogSnapshot(size_t max) const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const size_t n = std::min(max, m_log.size());
+    return std::vector<LogLine>(m_log.end() - static_cast<std::ptrdiff_t>(n), m_log.end());
+}
+
+void Session::LoadDataPackage(const Json& games) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (auto it = games.begin(); it != games.end(); ++it) {
+        auto& items = m_itemNames[it.key()];
+        auto& locations = m_locationNames[it.key()];
+        if (it->contains("item_name_to_id")) {
+            for (auto i = (*it)["item_name_to_id"].begin(); i != (*it)["item_name_to_id"].end(); ++i) {
+                items[i->get<int64_t>()] = i.key();
+            }
+        }
+        if (it->contains("location_name_to_id")) {
+            for (auto l = (*it)["location_name_to_id"].begin(); l != (*it)["location_name_to_id"].end(); ++l) {
+                locations[l->get<int64_t>()] = l.key();
+            }
+        }
+    }
+}
+
+void Session::PrintJson(const Json& cmd) {
+    if (!cmd.contains("data") || !cmd["data"].is_array()) return;
+    std::vector<LogSegment> line;
+    const int me = m_slot.load();
+    for (const Json& part : cmd["data"]) {
+        const std::string type = part.value("type", "text");
+        const std::string text = part.value("text", "");
+        if (type == "player_id") {
+            const int slot = std::atoi(text.c_str());
+            line.push_back({PlayerName(slot), slot == me ? kMagenta : kYellow});
+        } else if (type == "player_name") {
+            line.push_back({text, kYellow});
+        } else if (type == "item_id") {
+            const int owner = part.value("player", 0);
+            line.push_back({ItemName(PlayerGame(owner), std::atoll(text.c_str())), ItemColor(part.value("flags", 0))});
+        } else if (type == "item_name") {
+            line.push_back({text, ItemColor(part.value("flags", 0))});
+        } else if (type == "location_id") {
+            const int owner = part.value("player", 0);
+            line.push_back({LocationName(PlayerGame(owner), std::atoll(text.c_str())), kGreen});
+        } else if (type == "location_name") {
+            line.push_back({text, kGreen});
+        } else if (type == "entrance_name") {
+            line.push_back({text, kBlue});
+        } else if (type == "color") {
+            const std::string c = part.value("color", "");
+            uint32_t col = kWhite;
+            if (c == "red") col = kRed;
+            else if (c == "green") col = kGreen;
+            else if (c == "yellow") col = kYellow;
+            else if (c == "blue") col = kBlue;
+            else if (c == "magenta") col = kMagenta;
+            else if (c == "cyan") col = kCyan;
+            line.push_back({text, col});
+        } else {
+            line.push_back({text, kWhite});
+        }
+    }
+    if (!line.empty()) Log(std::move(line));
+}
+
+void Session::Handle(const Json& cmd, const SessionSettings& s) {
+    const std::string name = cmd.value("cmd", "");
+    if (name == "RoomInfo") {
+        // Names of every game in the room: from the cache when the checksum matches, else asked for.
+        std::vector<std::string> missing;
+        if (cmd.contains("datapackage_checksums") && cmd["datapackage_checksums"].is_object()) {
+            for (auto it = cmd["datapackage_checksums"].begin(); it != cmd["datapackage_checksums"].end(); ++it) {
+                const fs::path p = CacheDir() / (SafeName(it.key()) + "_" + SafeName(it->get<std::string>()) + ".json");
+                std::ifstream in(p);
+                Json cached;
+                bool ok = false;
+                if (in) {
+                    try {
+                        in >> cached;
+                        ok = true;
+                    } catch (...) {
+                    }
+                }
+                if (ok) {
+                    Json one;
+                    one[it.key()] = cached;
+                    LoadDataPackage(one);
+                } else {
+                    missing.push_back(it.key());
+                }
+            }
+        }
+        if (!missing.empty()) {
+            Send({{"cmd", "GetDataPackage"}, {"games", missing}});
+        }
+        Json version = cmd.contains("version") ? cmd["version"] : Json{{"major", 0}, {"minor", 6}, {"build", 0}};
+        version["class"] = "Version";
+        Send({{"cmd", "Connect"},
+              {"password", s.password},
+              {"game", s.game},
+              {"name", s.slot},
+              {"uuid", ClientUuid()},
+              {"version", version},
+              {"items_handling", s.itemsHandling},
+              {"tags", s.tags},
+              {"slot_data", true}});
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_status = "Logging in as " + s.slot + "...";
+    } else if (name == "DataPackage") {
+        if (cmd.contains("data") && cmd["data"].contains("games")) {
+            const Json& games = cmd["data"]["games"];
+            LoadDataPackage(games);
+            std::error_code ec;
+            fs::create_directories(CacheDir(), ec);
+            for (auto it = games.begin(); it != games.end(); ++it) {
+                const std::string checksum = it->value("checksum", "");
+                if (checksum.empty()) continue;
+                std::ofstream(CacheDir() / (SafeName(it.key()) + "_" + SafeName(checksum) + ".json")) << it->dump();
+            }
+        }
+        return; // nothing for the game
+    } else if (name == "Connected") {
+        m_slot = cmd.value("slot", -1);
+        m_team = cmd.value("team", 0);
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (cmd.contains("slot_info")) {
+                for (auto it = cmd["slot_info"].begin(); it != cmd["slot_info"].end(); ++it) {
+                    m_players[std::atoi(it.key().c_str())] = {it->value("name", ""), it->value("game", "")};
+                }
+            }
+            if (cmd.contains("players")) {
+                for (const Json& p : cmd["players"]) {
+                    if (p.value("team", 0) != m_team.load()) continue;
+                    m_players[p.value("slot", 0)].first = p.value("alias", p.value("name", ""));
+                }
+            }
+            m_status = "Connected as " + s.slot;
+        }
+        m_state = SessionState::Connected;
+    } else if (name == "RoomUpdate" && cmd.contains("players")) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        for (const Json& p : cmd["players"]) {
+            if (p.value("team", 0) != m_team.load()) continue;
+            m_players[p.value("slot", 0)].first = p.value("alias", p.value("name", ""));
+        }
+    } else if (name == "ConnectionRefused") {
+        std::string why;
+        if (cmd.contains("errors")) {
+            for (const Json& e : cmd["errors"]) {
+                const std::string code = e.get<std::string>();
+                if (!why.empty()) why += ", ";
+                why += code == "InvalidSlot"       ? "no slot called \"" + s.slot + "\""
+                       : code == "InvalidGame"     ? "that slot isn't a Punch-Out!! slot"
+                       : code == "InvalidPassword" ? "wrong password"
+                       : code == "IncompatibleVersion" ? "server version not supported"
+                       : code == "InvalidItemsHandling" ? "client setting rejected"
+                                                         : code;
+            }
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_status = "Login refused: " + (why.empty() ? std::string("unknown reason") : why);
+        }
+        m_state = SessionState::Refused;
+        LogText(StatusText(), kRed);
+    } else if (name == "PrintJSON") {
+        PrintJson(cmd);
+    }
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_inbox.push_back(cmd);
+}
+
+void Session::Run(SessionSettings s) {
+    ServerAddress address;
+    if (!ParseServerAddress(s.server, address)) {
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_status = "Server address not understood: " + s.server;
+        }
+        m_state = SessionState::Refused;
+        return;
+    }
+    int attempt = 0;
+    while (!m_stop) {
+        WebSocket ws;
+        std::string error;
+        bool open = false;
+        // No scheme: secure first (archipelago.gg), then plain (a server on this computer / LAN).
+        for (bool secure : {true, false}) {
+            if ((secure && address.scheme == 1) || (!secure && address.scheme == 2)) continue;
+            if (secure && !WebSocket::TlsAvailable() && address.scheme == 0) continue;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_status = "Connecting to " + address.host + ":" + std::to_string(address.port) + "...";
+            }
+            std::string e;
+            if (ws.Connect(address.host, address.port, secure, e)) {
+                open = true;
+                break;
+            }
+            error = e;
+        }
+        if (!open) {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_status = "Can't reach the server (" + error + "), retrying...";
+            }
+            if (attempt++ == 0) LogText("Can't reach " + s.server + ": " + error, kRed);
+            m_state = SessionState::Lost;
+            for (int i = 0; i < 50 && !m_stop; ++i) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            continue;
+        }
+        attempt = 0;
+        m_state = SessionState::Connecting;
+        std::vector<std::string> messages;
+        while (!m_stop) {
+            // Outgoing.
+            std::deque<Json> out;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                out.swap(m_outbox);
+            }
+            for (Json& c : out) ws.SendText(Json::array({std::move(c)}).dump());
+            messages.clear();
+            if (!ws.Poll(30, messages, error)) break;
+            for (const std::string& m : messages) {
+                Json arr;
+                try {
+                    arr = Json::parse(m);
+                } catch (...) {
+                    continue;
+                }
+                if (!arr.is_array()) continue;
+                for (const Json& c : arr) Handle(c, s);
+            }
+            if (m_state == SessionState::Refused) break;
+        }
+        ws.Close();
+        if (m_stop || m_state == SessionState::Refused) break;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_status = "Connection lost (" + error + "), reconnecting...";
+            m_inbox.push_back(Json{{"cmd", "_Disconnected"}});
+        }
+        LogText("Connection lost: " + error + ". Reconnecting...", kRed);
+        m_state = SessionState::Lost;
+        for (int i = 0; i < 30 && !m_stop; ++i) std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+}
+
+} // namespace PunchOutAp
diff --git a/runtime/src/hle/punchout_ap_session.h b/runtime/src/hle/punchout_ap_session.h
new file mode 100644
index 0000000..99767b9
--- /dev/null
+++ b/runtime/src/hle/punchout_ap_session.h
@@ -0,0 +1,91 @@
+// Punch-Out!! Archipelago: the server session (protocol only, no game logic). A network thread owns the
+// WebSocket; the game thread sends commands and takes events through queues. Also keeps the data package
+// (item / location / player names, for the log) and the log the panel shows.
+#pragma once
+
+#include "third_party/nlohmann/json.hpp"
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace PunchOutAp {
+
+using Json = nlohmann::json;
+
+struct LogSegment {
+    std::string text;
+    uint32_t color; // 0xRRGGBB
+};
+struct LogLine {
+    std::vector<LogSegment> segments;
+    double time = 0; // seconds since the session started (for fading)
+};
+
+enum class SessionState { Off, Connecting, Connected, Refused, Lost };
+
+struct SessionSettings {
+    std::string server;   // "host:port" (wss first, then ws)
+    std::string slot;
+    std::string password;
+    std::string game;     // "Punch-Out Wii"
+    std::vector<std::string> tags;
+    int itemsHandling = 0b111;
+};
+
+class Session {
+public:
+    static Session& Get();
+
+    void Start(const SessionSettings& settings);
+    void Stop();
+    SessionState State() const { return m_state.load(); }
+    std::string StatusText() const;
+
+    // Game thread -> server (a command object; queued, sent as a one-command array).
+    void Send(Json command);
+    // Server -> game thread: every server command (RoomInfo, Connected, ReceivedItems, Bounced, ...).
+    bool PopEvent(Json& out);
+
+    // Names (from the data package; numbers when unknown).
+    std::string PlayerName(int slot) const;
+    std::string PlayerGame(int slot) const;
+    std::string ItemName(const std::string& game, int64_t id) const;
+    std::string LocationName(const std::string& game, int64_t id) const;
+    int Slot() const { return m_slot.load(); }
+    int Team() const { return m_team.load(); }
+
+    // The log panel.
+    void Log(std::vector<LogSegment> segments);
+    void LogText(const std::string& text, uint32_t color = 0xFFFFFF);
+    std::vector<LogLine> LogSnapshot(size_t max) const;
+    uint64_t LogSerial() const { return m_logSerial.load(); }
+    double Now() const;
+
+private:
+    Session() = default;
+    void Run(SessionSettings settings);
+    void Handle(const Json& cmd, const SessionSettings& s);
+    void LoadDataPackage(const Json& games);
+    void PrintJson(const Json& cmd);
+
+    std::thread m_thread;
+    std::atomic<bool> m_stop{false};
+    std::atomic<SessionState> m_state{SessionState::Off};
+    std::atomic<int> m_slot{-1}, m_team{0};
+    mutable std::mutex m_mutex; // everything below
+    std::string m_status;
+    std::deque<Json> m_outbox, m_inbox;
+    std::unordered_map<int, std::pair<std::string, std::string>> m_players; // slot -> (alias, game)
+    std::unordered_map<std::string, std::unordered_map<int64_t, std::string>> m_itemNames, m_locationNames;
+    std::deque<LogLine> m_log;
+    std::atomic<uint64_t> m_logSerial{0};
+    double m_start = 0;
+};
+
+} // namespace PunchOutAp
diff --git a/runtime/src/hle/punchout_ap_ui.cpp b/runtime/src/hle/punchout_ap_ui.cpp
new file mode 100644
index 0000000..ad95cca
--- /dev/null
+++ b/runtime/src/hle/punchout_ap_ui.cpp
@@ -0,0 +1,174 @@
+// Punch-Out!! Archipelago: the F10 bar's "Archipelago" menu (server, slot, password, connect) and the message panel
+// on the right side of the screen (items found and received, death links, chat: what Archipelago's own text
+// client lists). Drawn from settings_overlay.cpp's per-frame ImGui pass.
+
+#include "punchout_ap_client.h"
+#include "punchout_ap_session.h"
+#include "runtime_config.h"
+
+#include <imgui.h>
+
+#include <algorithm>
+#include <cfloat>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+extern "C" ImFont* PunchOut_BannerFont(); // punchout_prompts.cpp (Open Sans, sharp at any size)
+
+namespace ap_ui {
+
+struct LoginFields {
+    bool loaded = false;
+    char server[128] = {};
+    char slot[64] = {};
+    char password[64] = {};
+    char patchFile[512] = {};
+    bool showLog = true;
+} g_fields;
+
+void LoadFields() {
+    if (g_fields.loaded) return;
+    g_fields.loaded = true;
+    std::snprintf(g_fields.server, sizeof g_fields.server, "%s", RuntimeConfigFile::ArchipelagoServer().c_str());
+    std::snprintf(g_fields.slot, sizeof g_fields.slot, "%s", RuntimeConfigFile::ArchipelagoSlot().c_str());
+    std::snprintf(g_fields.password, sizeof g_fields.password, "%s", RuntimeConfigFile::ArchipelagoPassword().c_str());
+    std::snprintf(g_fields.patchFile, sizeof g_fields.patchFile, "%s", RuntimeConfigFile::ArchipelagoPatchFile().c_str());
+    g_fields.showLog = RuntimeConfigFile::ArchipelagoShowLog();
+}
+
+ImU32 Col(uint32_t rgb, float alpha) {
+    return IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, static_cast<int>(alpha * 255.0f));
+}
+
+
+
+// The F10 bar's menu (settings_overlay.cpp DrawTopBar).
+extern "C" void PunchOut_DrawArchipelagoMenu() {
+    LoadFields();
+    using PunchOutAp::SessionState;
+    const SessionState state = PunchOutAp::Session::Get().State();
+    const bool on = state != SessionState::Off;
+    const char* label = state == SessionState::Connected ? "Archipelago: Connected###ApMenu"
+                        : on                              ? "Archipelago: ...###ApMenu"
+                                                          : "Archipelago###ApMenu";
+    if (!ImGui::BeginMenu(label)) return;
+    ImGui::PushItemWidth(ImGui::GetFontSize() * 16.0f);
+    ImGui::BeginDisabled(on);
+    ImGui::InputText("Server", g_fields.server, sizeof g_fields.server);
+    ImGui::InputText("Slot name", g_fields.slot, sizeof g_fields.slot);
+    ImGui::InputText("Password", g_fields.password, sizeof g_fields.password, ImGuiInputTextFlags_Password);
+    ImGui::EndDisabled();
+    ImGui::PopItemWidth();
+    if (!on) {
+        const bool ready = g_fields.server[0] != 0 && g_fields.slot[0] != 0;
+        ImGui::BeginDisabled(!ready);
+        if (ImGui::Button("Connect")) {
+            RuntimeConfigFile::SetArchipelagoLogin(g_fields.server, g_fields.slot, g_fields.password);
+            RuntimeConfigFile::SetArchipelagoEnabled(true);
+            PunchOutAp::ClientStart(g_fields.server, g_fields.slot, g_fields.password);
+        }
+        ImGui::EndDisabled();
+    } else if (ImGui::Button("Disconnect")) {
+        RuntimeConfigFile::SetArchipelagoEnabled(false);
+        PunchOutAp::ClientStop();
+    }
+    ImGui::SameLine();
+    const std::string status = on ? PunchOutAp::Session::Get().StatusText() : std::string("Not connected");
+    ImGui::TextColored(state == SessionState::Connected ? ImVec4(0.4f, 1.0f, 0.5f, 1.0f)
+                       : state == SessionState::Refused ? ImVec4(1.0f, 0.4f, 0.4f, 1.0f)
+                                                        : ImVec4(0.85f, 0.85f, 0.85f, 1.0f),
+                       "%s", status.c_str());
+    for (const std::string& line : PunchOutAp::ClientInfoLines()) ImGui::TextDisabled("%s", line.c_str());
+    ImGui::Separator();
+    if (ImGui::Checkbox("Show the message panel", &g_fields.showLog)) {
+        RuntimeConfigFile::SetArchipelagoShowLog(g_fields.showLog);
+    }
+    ImGui::PushItemWidth(ImGui::GetFontSize() * 22.0f);
+    if (ImGui::InputText("Patch file (.appunchout)", g_fields.patchFile, sizeof g_fields.patchFile,
+                         ImGuiInputTextFlags_EnterReturnsTrue)) {
+        RuntimeConfigFile::SetArchipelagoPatchFile(g_fields.patchFile);
+    }
+    ImGui::PopItemWidth();
+    ImGui::TextDisabled("Only needed when the server's Punch-Out!! apworld doesn't send the fighter order.");
+    ImGui::EndMenu();
+}
+
+// Connects at start when it was connected last time ([archipelago] enabled).
+extern "C" void PunchOut_ArchipelagoAutoStart() {
+    static bool done = false;
+    if (done) return;
+    done = true;
+    LoadFields();
+    if (RuntimeConfigFile::ArchipelagoEnabled() && g_fields.server[0] != 0 && g_fields.slot[0] != 0) {
+        PunchOutAp::ClientStart(g_fields.server, g_fields.slot, g_fields.password);
+    }
+}
+
+// The message panel: right side, newest at the bottom; lines fade out after a while unless the F10 bar is open.
+extern "C" void PunchOut_DrawArchipelagoLog(bool menuOpen) {
+    PunchOut_ArchipelagoAutoStart();
+    LoadFields();
+    if (!g_fields.showLog || PunchOutAp::Session::Get().State() == PunchOutAp::SessionState::Off) return;
+    const ImGuiIO& io = ImGui::GetIO();
+    const float W = io.DisplaySize.x, H = io.DisplaySize.y;
+    const float textSize = std::max(13.0f, H * 0.022f);
+    const float width = W * 0.30f, pad = textSize * 0.5f;
+    const float right = W - pad, left = right - width;
+    float y = H * 0.80f; // above the prompt banner
+    const double now = PunchOutAp::Session::Get().Now();
+    constexpr double kShowSeconds = 12.0, kFadeSeconds = 2.0;
+    ImFont* font = PunchOut_BannerFont();
+    ImDrawList* dl = ImGui::GetForegroundDrawList();
+    const auto lines = PunchOutAp::Session::Get().LogSnapshot(menuOpen ? 30 : 10);
+    for (auto it = lines.rbegin(); it != lines.rend() && y > H * 0.08f; ++it) {
+        const double age = now - it->time;
+        float alpha = 1.0f;
+        if (!menuOpen) {
+            if (age > kShowSeconds + kFadeSeconds) break;
+            if (age > kShowSeconds) alpha = static_cast<float>(1.0 - (age - kShowSeconds) / kFadeSeconds);
+        }
+        // Lay the line out (word wrap across its coloured segments).
+        struct Piece {
+            std::string text;
+            uint32_t color;
+            float x;
+            int row;
+        };
+        std::vector<Piece> pieces;
+        float x = 0;
+        int row = 0;
+        const float maxW = width - pad * 2;
+        for (const auto& seg : it->segments) {
+            size_t i = 0;
+            while (i < seg.text.size()) {
+                size_t j = seg.text.find(' ', i);
+                j = j == std::string::npos ? seg.text.size() : j + 1;
+                const std::string word = seg.text.substr(i, j - i);
+                const float w = font->CalcTextSizeA(textSize, FLT_MAX, 0.0f, word.c_str()).x;
+                if (x + w > maxW && x > 0) {
+                    x = 0;
+                    ++row;
+                }
+                pieces.push_back({word, seg.color, x, row});
+                x += w;
+                i = j;
+            }
+        }
+        const float lineH = textSize * 1.2f;
+        const float h = (row + 1) * lineH + pad * 0.5f;
+        y -= h;
+        dl->AddRectFilled(ImVec2(left, y), ImVec2(right, y + h), IM_COL32(0, 0, 0, static_cast<int>(140 * alpha)),
+                          textSize * 0.3f);
+        for (const Piece& p : pieces) {
+            const ImVec2 pos(left + pad + p.x, y + pad * 0.25f + p.row * lineH);
+            dl->AddText(font, textSize, ImVec2(pos.x + 1, pos.y + 1), IM_COL32(0, 0, 0, static_cast<int>(200 * alpha)),
+                        p.text.c_str());
+            dl->AddText(font, textSize, pos, Col(p.color, alpha), p.text.c_str());
+        }
+        y -= pad * 0.3f;
+    }
+}
+
+} // namespace ap_ui
diff --git a/runtime/src/hle/punchout_audio_trace.cpp b/runtime/src/hle/punchout_audio_trace.cpp
new file mode 100644
index 0000000..955ece0
--- /dev/null
+++ b/runtime/src/hle/punchout_audio_trace.cpp
@@ -0,0 +1,108 @@
+// Punch-Out!! music diagnostics: log the game's Wwise state changes and posted events with a
+// timestamp that matches the "[ax]" and "[wav]" lines, to see who ends the knockdown music early
+// in career fights (the game setting the InGame state back, or Wwise on its own).
+//   800209E8  audio manager SetState(r3 manager, r4 state group, r5 state, r6 ...)
+//   802CF200  Wwise PostEvent(r3 event, r4 game object, r5 flags, r6 callback, r7 cookie)
+// Both run the original translation after logging.
+
+#include "punchout_trace.h"
+#include "hle_stubs.h"
+#include "abi_bridge.h"
+#include "guest_function_imports.h"
+#include "ppc_runtime.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <unordered_map>
+
+namespace {
+double Now() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+const char* StateName(uint32_t id) {
+    switch (id) {
+    case 984691642u: return "InGame";
+    case 261089142u: return "GameMode";
+    case 1825748u: return "LoseFight";
+    case 231750206u: return "PauseFE";
+    case 361865448u: return "ProfileSelect";
+    case 427765245u: return "WinFight";
+    case 514064485u: return "Fight";
+    case 735985273u: return "LoadScreen";
+    case 748895195u: return "None";
+    case 1884610335u: return "RoundDisplay";
+    case 1923802435u: return "OpponentDownMac";
+    case 2201105581u: return "Credits";
+    case 2271899938u: return "Championship";
+    case 2409054962u: return "OpponentDown";
+    case 2497415422u: return "BigMac";
+    case 2798823618u: return "PreFight";
+    case 2838402773u: return "WiiFitTutorial";
+    case 2992916738u: return "Exhibition";
+    case 3092587493u: return "Pause";
+    case 3140745524u: return "SplashScreen";
+    case 3166776270u: return "Cornerman";
+    case 3668113100u: return "WiiBBTutorial";
+    case 4158285989u: return "GameOver";
+    default: return "?";
+    }
+}
+
+std::unordered_map<uint32_t, uint32_t> g_lastState;
+int g_stateLogs = 0;
+int g_eventLogs = 0;
+} // namespace
+
+extern "C" void PunchOut_MenuNoteInGameState(uint32_t state);
+
+extern "C" void PunchOut_SetState_pseudo(CpuContext* ctx) {
+    const uint32_t group = ctx->gpr[4];
+    const uint32_t state = ctx->gpr[5];
+    if (group == 984691642u) PunchOut_MenuNoteInGameState(state); // InGame: the menu navigation tracks fights
+    auto it = g_lastState.find(group);
+    if (PunchOutAudioTrace() && (it == g_lastState.end() || it->second != state) && g_stateLogs < 2000) {
+        ++g_stateLogs;
+        std::fprintf(stderr, "[state] t=%.3f %s = %s (%u, r6 %u, lr %08X)\n", Now(), StateName(group), StateName(state),
+                     state, ctx->gpr[6], ctx->lr);
+        g_lastState[group] = state;
+    }
+    MKW_GUEST_FUNC(80FF0010)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0010, PunchOut_SetState_pseudo, "PunchOut_SetState_pseudo");
+
+// Play_FE_Hover: the front end plays it when the pointer (or the selection) moves onto a button.
+// The menu navigation (punchout_menu.cpp) uses it to tell a live button from a dead one.
+constexpr uint32_t kEventFeHover = 698229078u;
+std::atomic<uint32_t> g_hoverSequence{0};
+extern "C" void Wiimote_PointerPosition(float* x, float* y);
+extern "C" const char* PunchOut_TopScreenName();
+
+extern "C" uint32_t PunchOut_HoverSequence() {
+    return g_hoverSequence.load(std::memory_order_acquire);
+}
+
+extern "C" uint32_t PunchOut_ApMusicEvent(uint32_t event); // punchout_ap_game.cpp (Archipelago music shuffle)
+
+extern "C" void PunchOut_PostEvent_pseudo(CpuContext* ctx) {
+    ctx->gpr[3] = PunchOut_ApMusicEvent(ctx->gpr[3]);
+    if (ctx->gpr[3] == kEventFeHover) {
+        g_hoverSequence.fetch_add(1, std::memory_order_acq_rel);
+        static int hoverLogs = 0;
+        if (hoverLogs < 300) {
+            ++hoverLogs;
+            float x = 0, y = 0;
+            Wiimote_PointerPosition(&x, &y);
+            std::fprintf(stderr, "[fe] hover at pointer (%.3f, %.3f) on %s\n", x, y, PunchOut_TopScreenName());
+        }
+    }
+    if (PunchOutAudioTrace() && g_eventLogs < 4000) {
+        ++g_eventLogs;
+        std::fprintf(stderr, "[event] t=%.3f %u obj %08X flags %X cb %08X (lr %08X)\n", Now(), ctx->gpr[3], ctx->gpr[4],
+                     ctx->gpr[5], ctx->gpr[6], ctx->lr);
+    }
+    MKW_GUEST_FUNC(80FF0014)(ctx);
+}
+REGISTER_NATIVE_WRAPPER_AS(0x80FF0014, PunchOut_PostEvent_pseudo, "PunchOut_PostEvent_pseudo");
diff --git a/runtime/src/hle/punchout_disc_patches.cpp b/runtime/src/hle/punchout_disc_patches.cpp
new file mode 100644
index 0000000..7ea516c
--- /dev/null
+++ b/runtime/src/hle/punchout_disc_patches.cpp
@@ -0,0 +1,489 @@
+// Punch-Out!! disc file patches made at run time from the player's own disc (nothing from the disc is shipped).
+// A patched copy goes to UserData/Cache/disc_patches/v<N>/<disc path> and the DVD layer reads that instead
+// (storage/dvd.cpp: PunchOut_PatchedDiscFile at both places disc files get their host path; a copy that grew gets
+// its real size and its own disc range).
+//
+// art/fe/<language>.loc: the front end's string table ("NLOC": magic, version, hash, count, 1, then count
+// (key hash, offset) pairs sorted by hash, then UTF-16BE strings each ending in 00 00; an offset counts UTF-16 units
+// from the first string). Key hash = FeHash(key). Patches:
+//   - English: the controls screen's "Wii Remote" option label -> "Gamepad" (whole string, in place).
+//   - every language: the Options menu's Difficulty strings (new keys, see kDifficultyStrings), so the menu's text is
+//     drawn by the game in its own font.
+//
+// art/fe/main_menu_options.data (+ its .dict / .debug, which give the bundle chunk size the game reads): the Options
+// panel ("FENL" package, see PatchOptionsMenu) gets a fourth button,
+// btn_difficulty (a copy of btn_tutorial), all buttons move up a little, and a one-line text "desc" sits under the
+// title's group for the Difficulty submenu's descriptions. punchout_menu.cpp drives the submenu.
+
+#include "guest_abi/guest_region.h"
+#include "runtime_config.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+namespace po_disc {
+
+// Bump when any patch changes: cached copies of an older version are not reused.
+constexpr int kPatchVersion = 3;
+
+constexpr uint32_t FeHash(const char* s) {
+    uint32_t h = 0xFFFFFFFFu;
+    for (; *s; ++s) {
+        uint32_t c = static_cast<uint8_t>(*s);
+        if (c >= 'A' && c <= 'Z') c |= 0x20;
+        h = h * 33u + c;
+    }
+    return h;
+}
+
+uint32_t Rd(const std::vector<uint8_t>& d, size_t o) {
+    return (uint32_t(d[o]) << 24) | (uint32_t(d[o + 1]) << 16) | (uint32_t(d[o + 2]) << 8) | d[o + 3];
+}
+void Wr(std::vector<uint8_t>& d, size_t o, uint32_t v) {
+    d[o] = uint8_t(v >> 24);
+    d[o + 1] = uint8_t(v >> 16);
+    d[o + 2] = uint8_t(v >> 8);
+    d[o + 3] = uint8_t(v);
+}
+float RdF(const std::vector<uint8_t>& d, size_t o) {
+    const uint32_t v = Rd(d, o);
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+void WrF(std::vector<uint8_t>& d, size_t o, float f) {
+    uint32_t v;
+    std::memcpy(&v, &f, 4);
+    Wr(d, o, v);
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Strings
+
+std::vector<uint8_t> Utf16Be(const char* s) {
+    std::vector<uint8_t> out;
+    for (; *s; ++s) {
+        out.push_back(0);
+        out.push_back(static_cast<uint8_t>(*s));
+    }
+    return out;
+}
+
+// Whole strings only: the match must start right after a 00 00 terminator and be followed by 00 00.
+int ReplaceWholeStrings(std::vector<uint8_t>& data, const char* from, const char* to) {
+    const std::vector<uint8_t> f = Utf16Be(from), t = Utf16Be(to);
+    if (t.size() > f.size() || f.empty()) return 0;
+    int count = 0;
+    for (size_t i = 2; i + f.size() + 2 <= data.size(); i += 2) {
+        if (data[i - 2] != 0 || data[i - 1] != 0) continue;
+        if (!std::equal(f.begin(), f.end(), data.begin() + static_cast<std::ptrdiff_t>(i))) continue;
+        if (data[i + f.size()] != 0 || data[i + f.size() + 1] != 0) continue;
+        std::copy(t.begin(), t.end(), data.begin() + static_cast<std::ptrdiff_t>(i));
+        std::fill(data.begin() + static_cast<std::ptrdiff_t>(i + t.size()),
+                  data.begin() + static_cast<std::ptrdiff_t>(i + f.size()), 0);
+        ++count;
+    }
+    return count;
+}
+
+struct LocString {
+    const char* key;
+    const char16_t* text;
+};
+
+// The Difficulty menu (keys shared with punchout_menu.cpp, which switches the texts' string ids).
+#define PO_DIFFICULTY_STRINGS(Difficulty, Normal, Hard, Insane, Current, DescHard, DescInsane)                      \
+    {                                                                                                               \
+        {"difficulty", Difficulty}, {"difficulty_normal", Normal}, {"difficulty_hard", Hard},                       \
+            {"difficulty_insane", Insane}, {"difficulty_normal_current", Normal Current},                           \
+            {"difficulty_hard_current", Hard Current}, {"difficulty_insane_current", Insane Current},               \
+            {"difficulty_desc_none", u" "}, {"difficulty_desc_normal", u" "}, {"difficulty_desc_hard", DescHard},   \
+            {"difficulty_desc_insane", DescInsane},                                                                 \
+    }
+const LocString kStringsEnglish[] = PO_DIFFICULTY_STRINGS(u"Difficulty", u"Normal", u"Hard", u"Insane", u" (Current)",
+                                                          u"No restarting or quitting mid-fight.",
+                                                          u"No restart/quit. One knockdown and you're out.");
+const LocString kStringsFrench[] = PO_DIFFICULTY_STRINGS(u"Difficulté", u"Normal", u"Difficile", u"Infernal", u" (actuel)",
+                                                         u"Impossible de recommencer ou d'abandonner un combat.",
+                                                         u"Ni recommencer ni abandonner. Une chute et c'est fini.");
+const LocString kStringsSpanish[] = PO_DIFFICULTY_STRINGS(u"Dificultad", u"Normal", u"Difícil", u"Demencial", u" (actual)",
+                                                          u"No puedes reiniciar ni abandonar un combate.",
+                                                          u"Sin reiniciar ni abandonar. Una caída y estás fuera.");
+const LocString kStringsGerman[] = PO_DIFFICULTY_STRINGS(u"Schwierigkeit", u"Normal", u"Schwer", u"Wahnsinn", u" (aktuell)",
+                                                         u"Kein Neustart oder Aufgeben im Kampf.",
+                                                         u"Kein Neustart/Aufgeben. Ein Niederschlag und du bist raus.");
+const LocString kStringsItalian[] = PO_DIFFICULTY_STRINGS(u"Difficoltà", u"Normale", u"Difficile", u"Folle", u" (attuale)",
+                                                          u"Niente riavvio o abbandono durante l'incontro.",
+                                                          u"Niente riavvio/abbandono. Un atterramento e sei fuori.");
+#undef PO_DIFFICULTY_STRINGS
+
+// Adds strings under new keys (keys already in the table are left alone). Returns how many were added.
+int AddLocStrings(std::vector<uint8_t>& data, const LocString* add, size_t addCount) {
+    if (data.size() < 0x14 || std::memcmp(data.data(), "NLOC", 4) != 0) return 0;
+    const uint32_t count = Rd(data, 0x0C);
+    const size_t base = 0x14 + size_t(count) * 8;
+    if (base > data.size() || ((data.size() - base) & 1u) != 0) return 0;
+    struct Entry {
+        uint32_t hash, offset;
+    };
+    std::vector<Entry> entries(count);
+    for (uint32_t i = 0; i < count; ++i) entries[i] = {Rd(data, 0x14 + i * 8), Rd(data, 0x18 + i * 8)};
+    std::vector<uint8_t> strings(data.begin() + static_cast<std::ptrdiff_t>(base), data.end());
+    int added = 0;
+    for (size_t i = 0; i < addCount; ++i) {
+        const uint32_t h = FeHash(add[i].key);
+        if (std::any_of(entries.begin(), entries.end(), [h](const Entry& e) { return e.hash == h; })) continue;
+        entries.push_back({h, static_cast<uint32_t>(strings.size() / 2)});
+        for (const char16_t* c = add[i].text; *c; ++c) {
+            strings.push_back(uint8_t(*c >> 8));
+            strings.push_back(uint8_t(*c));
+        }
+        strings.push_back(0);
+        strings.push_back(0);
+        ++added;
+    }
+    if (added == 0) return 0;
+    std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) { return a.hash < b.hash; });
+    std::vector<uint8_t> out(data.begin(), data.begin() + 0x14);
+    Wr(out, 0x0C, static_cast<uint32_t>(entries.size()));
+    out.resize(0x14 + entries.size() * 8);
+    for (size_t i = 0; i < entries.size(); ++i) {
+        Wr(out, 0x14 + i * 8, entries[i].hash);
+        Wr(out, 0x18 + i * 8, entries[i].offset);
+    }
+    out.insert(out.end(), strings.begin(), strings.end());
+    data.swap(out);
+    return added;
+}
+
+int PatchLoc(const std::string& key, std::vector<uint8_t>& data) {
+    int changes = 0;
+    if (key == "/art/fe/english.loc" || key == "/art/fe/ukenglish.loc") {
+        changes += ReplaceWholeStrings(data, "Wii Remote", "Gamepad");
+    }
+    const LocString* table = kStringsEnglish;
+    if (key == "/art/fe/french.loc" || key == "/art/fe/nafrench.loc") table = kStringsFrench;
+    if (key == "/art/fe/spanish.loc" || key == "/art/fe/naspanish.loc") table = kStringsSpanish;
+    if (key == "/art/fe/german.loc") table = kStringsGerman;
+    if (key == "/art/fe/italian.loc") table = kStringsItalian;
+    changes += AddLocStrings(data, table, std::size(kStringsEnglish));
+    return changes;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// FENL packages (art/fe/*.data): "FENL", version, data length, pointer table length; the data (pointers are offsets
+// from its start, FFFFFFFF = null); the pointer table (the offset of every pointer field; the loader adds the
+// data's address to each); padding. The game copies the data to the heap and uses it in place.
+//
+// Layout used here (Punch-Out's NLG FE, matching the Mario Strikers Charged decomp up to a few offsets):
+//   instance: +0 next, +4 prev (sibling ring), +8 children, +C library object, +18 name[32], +38 FeHash(name),
+//     +3C attributes (+40 position y, +54/+58 scale x/y), +84 overload flags, +88 type (3 text, 4 component,
+//     7 hit region), +8E visible; text: +90 string id (key hash); hit region: +94 button id
+//   slide: +0 next, +8 children, +C animations, +24 name, +44 hash
+//   animation: +4 next, +8 prev, +C target instance, +14 kind (1 = position), +18 keys (ring, next at +3C);
+//     key: per axis {value, handle, handle, time, 0} for x, y (+14 value, +18/+1C handles; -1 = none), z
+//   library object: +0 next, +4 prev (library ring), +50 hash, +54 name[32]; component: +78 slides, +7C active slide
+struct Fenl {
+    uint32_t version = 0;
+    std::vector<uint8_t> data;
+    std::vector<uint32_t> ptrs;
+    std::vector<uint8_t> tail;
+};
+
+bool ParseFenl(const std::vector<uint8_t>& raw, Fenl& f) {
+    if (raw.size() < 16 || std::memcmp(raw.data(), "FENL", 4) != 0) return false;
+    f.version = Rd(raw, 4);
+    const uint32_t dlen = Rd(raw, 8), plen = Rd(raw, 12);
+    if (16ull + dlen + plen > raw.size() || (plen & 3u) != 0) return false;
+    f.data.assign(raw.begin() + 16, raw.begin() + 16 + dlen);
+    f.ptrs.resize(plen / 4);
+    for (size_t i = 0; i < f.ptrs.size(); ++i) f.ptrs[i] = Rd(raw, 16 + dlen + i * 4);
+    f.tail.assign(raw.begin() + 16 + dlen + plen, raw.end());
+    return true;
+}
+
+std::vector<uint8_t> BuildFenl(const Fenl& f) {
+    std::vector<uint8_t> out(16);
+    std::memcpy(out.data(), "FENL", 4);
+    Wr(out, 4, f.version);
+    Wr(out, 8, static_cast<uint32_t>(f.data.size()));
+    Wr(out, 12, static_cast<uint32_t>(f.ptrs.size() * 4));
+    out.insert(out.end(), f.data.begin(), f.data.end());
+    const size_t at = out.size();
+    out.resize(at + f.ptrs.size() * 4);
+    for (size_t i = 0; i < f.ptrs.size(); ++i) Wr(out, at + i * 4, f.ptrs[i]);
+    out.insert(out.end(), f.tail.begin(), f.tail.end());
+    return out;
+}
+
+std::string CStr(const std::vector<uint8_t>& d, size_t o) {
+    std::string s;
+    for (size_t i = 0; i < 32 && o + i < d.size() && d[o + i] != 0; ++i) s.push_back(static_cast<char>(d[o + i]));
+    return s;
+}
+void SetName(std::vector<uint8_t>& d, size_t nameAt, size_t hashAt, const char* name) {
+    std::fill(d.begin() + static_cast<std::ptrdiff_t>(nameAt), d.begin() + static_cast<std::ptrdiff_t>(nameAt + 32), 0);
+    std::memcpy(d.data() + nameAt, name, std::strlen(name));
+    Wr(d, hashAt, FeHash(name));
+}
+
+// Inserts node x into a ring right after node a (fields at nextOff / prevOff).
+void RingInsertAfter(std::vector<uint8_t>& d, uint32_t a, uint32_t x, uint32_t nextOff, uint32_t prevOff) {
+    const uint32_t b = Rd(d, a + nextOff);
+    Wr(d, x + nextOff, b);
+    Wr(d, x + prevOff, a);
+    Wr(d, a + nextOff, x);
+    Wr(d, b + prevOff, x);
+}
+// The same for a chain of library objects first..last (already linked to each other).
+void RingInsertChainAfter(std::vector<uint8_t>& d, uint32_t a, uint32_t first, uint32_t last) {
+    const uint32_t b = Rd(d, a);
+    Wr(d, last, b);
+    Wr(d, first + 4, a);
+    Wr(d, a, first);
+    Wr(d, b + 4, last);
+}
+
+// Moves an animation's position keys (and the instance's own start position) up or down by dy.
+void ShiftY(std::vector<uint8_t>& d, uint32_t instance, uint32_t anim, float dy) {
+    WrF(d, instance + 0x40, RdF(d, instance + 0x40) + dy);
+    const uint32_t head = Rd(d, anim + 0x18);
+    uint32_t k = head;
+    for (int i = 0; i < 16; ++i) {
+        for (uint32_t o : {0x14u, 0x18u, 0x1Cu}) {
+            const float v = RdF(d, k + o);
+            if (o == 0x14u || v != -1.0f) WrF(d, k + o, v + dy);
+        }
+        k = Rd(d, k + 0x3C);
+        if (k == head || k + 0x44 > d.size()) break;
+    }
+}
+
+// Options panel buttons, top to bottom: y 95 / 35 / -25 / -85 (were 70 / 10 / -50, 60 apart), each sliding in from
+// 430 below. punchout_menu.cpp finds the new parts by name at run time.
+namespace PunchOutOptionsLayout {
+constexpr float kMoveUp = 25.0f;                            // every original button
+constexpr float kDifficultyFromTutorial = kMoveUp - 60.0f;  // btn_difficulty: one row under Tutorial
+constexpr float kDescY = -85.0f;                            // "desc": btn_difficulty's row (hidden in the submenu)
+constexpr float kDescScale = 0.42f;
+} // namespace PunchOutOptionsLayout
+
+// main_menu_options.data, US disc (checked before patching; anything else is left alone).
+bool PatchOptionsMenu(std::vector<uint8_t>& raw) {
+    Fenl f;
+    if (!ParseFenl(raw, f) || f.data.size() != 0x7950u || f.ptrs.size() != 940u) return false;
+    std::vector<uint8_t>& d = f.data;
+    struct Check {
+        uint32_t at;
+        const char* name;
+    };
+    // Instances (+0x18 name) and library objects (+0x54 name) the patch relies on.
+    const Check checks[] = {
+        {0x3450u + 0x18u, "btn_controller"}, {0x1A54u + 0x18u, "btn_profile"}, {0x4B8Cu + 0x18u, "btn_tutorial"},
+        {0x7440u + 0x18u, "btn_controller"}, {0x72C8u + 0x18u, "btn_profile"}, {0x75B8u + 0x18u, "btn_tutorial"},
+        {0x0504u + 0x18u, "Text"},           {0x6890u + 0x18u, "Text"},        {0x4C1Cu + 0x54u, "btn_tutorial"},
+        {0x4F88u + 0x54u, "Text"},           {0x55E4u + 0x54u, "Component"},   {0x5884u + 0x54u, "Component2"},
+        {0x635Cu + 0x54u, "Layer"},          {0x62C8u + 0x18u, "Layer2"},       {0x7730u + 0x18u, "Layer2"},
+    };
+    for (const Check& c : checks) {
+        if (CStr(d, c.at) != c.name) return false;
+    }
+    // Animations: in-slide controller / profile / tutorial, out-slide the same.
+    const uint32_t inAnims[3] = {0x4A60u, 0x3324u, 0x619Cu}, inInst[3] = {0x3450u, 0x1A54u, 0x4B8Cu};
+    const uint32_t outAnims[3] = {0x74D0u, 0x7358u, 0x7648u}, outInst[3] = {0x7440u, 0x72C8u, 0x75B8u};
+    for (int i = 0; i < 3; ++i) {
+        if (Rd(d, inAnims[i] + 0xC) != inInst[i] || Rd(d, outAnims[i] + 0xC) != outInst[i]) return false;
+    }
+    if (Rd(d, 0x0504u + 0x90u) != 0xCA4C4339u || Rd(d, 0x6890u + 0x90u) != 0xCA4C4339u) return false; // "Options"
+    if (Rd(d, 0x5884u) != 0x635Cu || Rd(d, 0x4C1Cu + 4u) != 0x4148u) return false; // library chain ends
+
+    // Copies: btn_tutorial's in-slide instance with its component (and the component's Text / Component /
+    // Component2 library objects) and its in-slide animation; its out-slide instance and animation; the title text
+    // of both slides (for "desc"). Ranges end where the next unrelated object starts.
+    struct Copy {
+        uint32_t lo, hi, at;
+    };
+    Copy copies[] = {{0x4B8Cu, 0x62C8u, 0}, {0x75B8u, 0x7730u, 0}, {0x0504u, 0x062Cu, 0}, {0x6890u, 0x69B8u, 0}};
+    // A 0x40-byte block right before the first copy: punchout_menu.cpp builds btn_difficulty's button object there
+    // (it lives and dies with the package). "PODF" at +0x38 marks it.
+    size_t end = (d.size() + 15u) & ~size_t(15);
+    const uint32_t block = static_cast<uint32_t>(end);
+    end += 0x40;
+    for (Copy& c : copies) {
+        c.at = static_cast<uint32_t>(end);
+        end = (end + (c.hi - c.lo) + 15u) & ~size_t(15);
+    }
+    d.resize(end, 0);
+    std::memcpy(d.data() + block + 0x38, "PODF", 4);
+    Wr(d, block + 0x3C, 1);
+    const auto mapPtr = [&copies](uint32_t v) {
+        for (const Copy& c : copies) {
+            if (v >= c.lo && v < c.hi) return v - c.lo + c.at;
+        }
+        return v;
+    };
+    std::vector<uint32_t> added;
+    for (const Copy& c : copies) {
+        std::memcpy(d.data() + c.at, d.data() + c.lo, c.hi - c.lo);
+        for (uint32_t p : f.ptrs) {
+            if (p < c.lo || p >= c.hi) continue;
+            const uint32_t np = p - c.lo + c.at, v = Rd(d, p);
+            if (v != 0xFFFFFFFFu) Wr(d, np, mapPtr(v));
+            added.push_back(np);
+        }
+    }
+    const auto M = [&copies](int i, uint32_t orig) { return orig - copies[i].lo + copies[i].at; };
+
+    // Names, hashes, ids: btn_difficulty (instances and component), its hit regions and labels "difficulty".
+    const uint32_t kTutorial = FeHash("tutorial"), kDifficulty = FeHash("difficulty");
+    for (uint32_t o = copies[0].at; o < copies[0].at + (copies[0].hi - copies[0].lo); o += 4) {
+        if (Rd(d, o) == kTutorial) Wr(d, o, kDifficulty);
+    }
+    SetName(d, M(0, 0x4B8Cu) + 0x18u, M(0, 0x4B8Cu) + 0x38u, "btn_difficulty");
+    SetName(d, M(1, 0x75B8u) + 0x18u, M(1, 0x75B8u) + 0x38u, "btn_difficulty");
+    SetName(d, M(0, 0x4C1Cu) + 0x54u, M(0, 0x4C1Cu) + 0x50u, "btn_difficulty");
+    for (int i : {2, 3}) {
+        const uint32_t t = M(i, i == 2 ? 0x0504u : 0x6890u);
+        SetName(d, t + 0x18u, t + 0x38u, "desc");
+        Wr(d, t + 0x90u, FeHash("difficulty_desc_none"));
+        WrF(d, t + 0x40u, PunchOutOptionsLayout::kDescY);
+        WrF(d, t + 0x54u, PunchOutOptionsLayout::kDescScale);
+        WrF(d, t + 0x58u, PunchOutOptionsLayout::kDescScale);
+    }
+
+    // Rings: the new button after Profile (both slides; render order stays behind nothing), its animations after
+    // Tutorial's, its library objects after Tutorial's, "desc" after each title text.
+    RingInsertAfter(d, 0x1A54u, M(0, 0x4B8Cu), 0x0u, 0x4u);
+    RingInsertAfter(d, 0x72C8u, M(1, 0x75B8u), 0x0u, 0x4u);
+    RingInsertAfter(d, 0x619Cu, M(0, 0x619Cu), 0x4u, 0x8u);
+    RingInsertAfter(d, 0x7648u, M(1, 0x7648u), 0x4u, 0x8u);
+    RingInsertChainAfter(d, 0x5884u, M(0, 0x4C1Cu), M(0, 0x5884u));
+    RingInsertAfter(d, 0x0504u, M(2, 0x0504u), 0x0u, 0x4u);
+    RingInsertAfter(d, 0x6890u, M(3, 0x6890u), 0x0u, 0x4u);
+
+    // Positions: everything up by kMoveUp; the copy one row under Tutorial.
+    for (int i = 0; i < 3; ++i) {
+        ShiftY(d, inInst[i], inAnims[i], PunchOutOptionsLayout::kMoveUp);
+        ShiftY(d, outInst[i], outAnims[i], PunchOutOptionsLayout::kMoveUp);
+    }
+    ShiftY(d, M(0, 0x4B8Cu), M(0, 0x619Cu), PunchOutOptionsLayout::kDifficultyFromTutorial);
+    ShiftY(d, M(1, 0x75B8u), M(1, 0x7648u), PunchOutOptionsLayout::kDifficultyFromTutorial);
+
+    std::sort(added.begin(), added.end());
+    f.ptrs.insert(f.ptrs.end(), added.begin(), added.end());
+    // The file is a one-chunk bundle: the FENL padded to 0x800, then a 12-byte footer {03027000, FENL size, 0}; the
+    // .dict / .debug next to it give the chunk size (the game allocates and reads that much), see PatchOptionsDict.
+    f.tail.clear();
+    std::vector<uint8_t> out = BuildFenl(f);
+    const uint32_t fenlSize = static_cast<uint32_t>(out.size());
+    out.resize((out.size() + 0x7FFu) & ~size_t(0x7FF), 0);
+    const size_t footer = out.size();
+    out.resize(footer + 12, 0);
+    Wr(out, footer, 0x03027000u);
+    Wr(out, footer + 4, fenlSize);
+    raw.swap(out);
+    return true;
+}
+
+// The bundle sizes of the patched main_menu_options.data (from the disc copy next to the .dict).
+bool OptionsMenuSizes(const fs::path& dataFile, uint32_t& chunk, uint32_t& fenl) {
+    std::ifstream in(dataFile, std::ios::binary);
+    if (!in) return false;
+    std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    if (!PatchOptionsMenu(data) || data.size() < 12) return false;
+    chunk = static_cast<uint32_t>(data.size() - 12);
+    fenl = Rd(data, data.size() - 8);
+    return true;
+}
+
+// main_menu_options.dict: {a9f32458, 06010000, 1, 0, 1, 0xC, chunk size 0x9000, 8, 0...};
+// main_menu_options.debug: {0, 1, 0xC, chunk size, 8, 0..., 03027000, FENL size 0x8810, 0}.
+int PatchOptionsDict(const std::string& key, std::vector<uint8_t>& data, uint32_t chunk, uint32_t fenl) {
+    if (data.size() != 88) return 0;
+    if (key == "/art/fe/main_menu_options.dict" && Rd(data, 0) == 0xA9F32458u && Rd(data, 24) == 0x9000u) {
+        Wr(data, 24, chunk);
+        return 1;
+    }
+    if (key == "/art/fe/main_menu_options.debug" && Rd(data, 12) == 0x9000u && Rd(data, 80) == 0x8810u) {
+        Wr(data, 12, chunk);
+        Wr(data, 80, fenl);
+        return 1;
+    }
+    return 0;
+}
+
+std::string Lower(std::string s) {
+    for (char& c : s) {
+        if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    }
+    return s;
+}
+
+bool IsPatchedPath(const std::string& key) {
+    if (key == "/art/fe/main_menu_options.data" || key == "/art/fe/main_menu_options.dict" ||
+        key == "/art/fe/main_menu_options.debug") {
+        return true;
+    }
+    return key.rfind("/art/fe/", 0) == 0 && key.size() > 12 && key.compare(key.size() - 4, 4, ".loc") == 0 &&
+           key.find('/', 8) == std::string::npos;
+}
+
+} // namespace po_disc
+
+// Test hook (tools): the patch for one disc path, applied to `data` in memory. Returns the number of changes.
+int PunchOut_PatchDiscData(const std::string& dvdPath, std::vector<uint8_t>& data) {
+    using namespace po_disc;
+    const std::string key = Lower(dvdPath);
+    if (key == "/art/fe/main_menu_options.data") return PatchOptionsMenu(data) ? 1 : 0;
+    if (IsPatchedPath(key)) return PatchLoc(key, data);
+    return 0;
+}
+
+// The host file the game should read for a disc path: a patched copy when one applies, else the original.
+fs::path PunchOut_PatchedDiscFile(const std::string& dvdPath, const fs::path& original) {
+    using namespace po_disc;
+    if (GuestRegion::Current() != GuestRegion::Id::PunchOut) return original;
+    const std::string key = Lower(dvdPath);
+    if (!IsPatchedPath(key)) return original;
+
+    std::error_code ec;
+    const fs::path out = RuntimeConfigFile::ApplicationDataDirectory() / "Cache" / "disc_patches" /
+                         ("v" + std::to_string(kPatchVersion)) / fs::path(key.substr(1));
+    // Up to date: newer than the original (rebuilt when the disc copy changes or the file is deleted).
+    if (fs::exists(out, ec) && fs::last_write_time(out, ec) >= fs::last_write_time(original, ec) && !ec) return out;
+
+    std::ifstream in(original, std::ios::binary);
+    if (!in) return original;
+    std::vector<uint8_t> data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    int changes = 0;
+    if (key == "/art/fe/main_menu_options.dict" || key == "/art/fe/main_menu_options.debug") {
+        uint32_t chunk = 0, fenl = 0;
+        if (OptionsMenuSizes(original.parent_path() / "main_menu_options.data", chunk, fenl)) {
+            changes = PatchOptionsDict(key, data, chunk, fenl);
+        }
+    } else {
+        changes = PunchOut_PatchDiscData(key, data);
+    }
+    if (changes == 0) {
+        std::fprintf(stderr, "[dvd] %s: no patch applied (unexpected contents)\n", dvdPath.c_str());
+        return original;
+    }
+    fs::create_directories(out.parent_path(), ec);
+    std::ofstream o(out, std::ios::binary | std::ios::trunc);
+    if (!o) return original;
+    o.write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
+    o.close();
+    if (!o) return original;
+    std::fprintf(stderr, "[dvd] %s: patched (%d change(s)) -> %s\n", dvdPath.c_str(), changes, out.string().c_str());
+    return out;
+}
