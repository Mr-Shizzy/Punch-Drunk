+    float x = 0, y = 0;
+    uint32_t link[4] = {0, 0, 0, 0}; // up, down, left, right (0 = none)
+    bool mark = false;           // placed by hand (Insert): looked for at x y on every visit
+    bool point = false;          // a mark with no button under it: chosen by moving the real pointer there
+};
+struct LinkScreen {
+    std::string name;
+    std::vector<LinkButton> buttons;
+    uint32_t keys[5] = {0, 0, 0, 0, 0}; // B, X, Y, LB, RB
+    bool live = false;                   // "[name] live": D-pad links from where things are right now (moving camera)
+};
+std::vector<LinkScreen> g_links;    // the user's file (UserData/menu_links.txt): recorded screens, marks, edits
+std::vector<LinkScreen> g_defaults; // built into the port (punchout_menu_links_default.inc)
+bool g_linksLoaded = false;
+const char* const kDefaultLinks =
+#include "punchout_menu_links_default.inc"
+    ;
+const char* const kKeyNames[5] = {"B", "X", "Y", "LB", "RB"};
+const char* const kDirNames[4] = {"up", "down", "left", "right"};
+
+std::filesystem::path LinksPath() {
+    return RuntimeConfigFile::ApplicationDataDirectory() / "menu_links.txt";
+}
+
+uint32_t ParseId(const std::string& v) {
+    if (v.empty() || v == "-") return 0;
+    try {
+        return static_cast<uint32_t>(std::stoul(v, nullptr, 16));
+    } catch (...) {
+        return 0;
+    }
+}
+
+void ParseLinks(std::istream& in, std::vector<LinkScreen>& into) {
+    std::string line;
+    LinkScreen* cur = nullptr;
+    while (std::getline(in, line)) {
+        const auto hash = line.find('#');
+        if (hash != std::string::npos) line.erase(hash);
+        std::istringstream ls(line);
+        std::string first;
+        if (!(ls >> first)) continue;
+        if (first.size() > 2 && first.front() == '[' && first.back() == ']') {
+            into.push_back({first.substr(1, first.size() - 2), {}, {}});
+            cur = &into.back();
+            std::string flag;
+            while (ls >> flag) {
+                if (flag == "live") cur->live = true;
+            }
+            continue;
+        }
+        if (!cur) continue;
+        if (first == "keys") {
+            std::string kv;
+            while (ls >> kv) {
+                const auto eq = kv.find('=');
+                if (eq == std::string::npos) continue;
+                for (int k = 0; k < 5; ++k) {
+                    if (kv.substr(0, eq) == kKeyNames[k]) cur->keys[k] = ParseId(kv.substr(eq + 1));
+                }
+            }
+            continue;
+        }
+        LinkButton b;
+        b.id = ParseId(first);
+        if (b.id == 0) continue;
+        std::string word;
+        while (ls >> word) {
+            if (word == "at") {
+                ls >> b.x >> b.y;
+                continue;
+            }
+            const auto eq = word.find('=');
+            if (eq == std::string::npos) {
+                if (word == "mark") {
+                    b.mark = true;
+                } else {
+                    b.owner = word;
+                    if (word == "point") b.mark = b.point = true;
+                }
+                continue;
+            }
+            for (int d = 0; d < 4; ++d) {
+                if (word.substr(0, eq) == kDirNames[d]) b.link[d] = ParseId(word.substr(eq + 1));
+            }
+        }
+        cur->buttons.push_back(b);
+    }
+}
+
+// The built-in links, then the user's file on top: a screen in the user's file replaces the built-in one, so the
+// file can be deleted at any time (back to the built-in links, recording starts over for screens they lack).
+void LoadLinks() {
+    g_linksLoaded = true;
+    std::istringstream builtIn{std::string(kDefaultLinks)};
+    ParseLinks(builtIn, g_defaults);
+    if (std::ifstream in(LinksPath()); in) ParseLinks(in, g_links);
+    std::fprintf(stderr, "[nav] menu links: %zu built in, %zu from %s\n", g_defaults.size(), g_links.size(),
+                 LinksPath().string().c_str());
+}
+
+void SaveLinks() {
+    std::error_code ec;
+    std::filesystem::create_directories(LinksPath().parent_path(), ec);
+    std::ofstream out(LinksPath(), std::ios::trunc);
+    if (!out) return;
+    out << "# Punch-Out!! controller menu links: your own (written by the game, yours to edit; read at start).\n"
+           "# The port has built-in links for every screen. A screen listed here replaces its built-in links; screens\n"
+           "# the built-in links lack are recorded here when you visit them. Delete this file any time to go back to\n"
+           "# the built-in links: nothing is lost.\n"
+           "# One block per screen. A button line: <id> <owner> at <x> <y> up=<id> down=<id> left=<id> right=<id>\n"
+           "#   id: the game's button id; owner: screen / bar (the bottom bar) / other; x y: where it is (-1..1, y down);\n"
+           "#   a link to a button that is not there at the moment (locked, hidden) is followed on in the same direction;\n"
+           "#   '-' = nowhere. 'keys' says which button B, X, Y, LB and RB press on that screen.\n"
+           "# Marks (Insert in the game, Delete to take away): 'mark' = a button placed by hand, looked for at x y;\n"
+           "#   owner 'point' = a spot with no button the game reports: choosing it moves the hidden pointer there.\n"
+           "# '[name] live': the camera moves on that screen (career hubs): the D-pad goes by where things are right\n"
+           "#   now and the button lines only keep marks; the keys line still applies.\n";
+    char buf[64];
+    for (const auto& sc : g_links) {
+        out << "\n[" << sc.name << "]" << (sc.live ? " live" : "") << "\n";
+        for (const auto& b : sc.buttons) {
+            std::snprintf(buf, sizeof buf, "%08X %s%s at %.3f %.3f", b.id, b.owner.c_str(), b.mark && !b.point ? " mark" : "",
+                          b.x, b.y);
+            out << buf;
+            for (int d = 0; d < 4; ++d) {
+                if (b.link[d]) {
+                    std::snprintf(buf, sizeof buf, " %s=%08X", kDirNames[d], b.link[d]);
+                } else {
+                    std::snprintf(buf, sizeof buf, " %s=-", kDirNames[d]);
+                }
+                out << buf;
+            }
+            out << "\n";
+        }
+        out << "keys";
+        for (int k = 0; k < 5; ++k) {
+            if (sc.keys[k]) {
+                std::snprintf(buf, sizeof buf, " %s=%08X", kKeyNames[k], sc.keys[k]);
+            } else {
+                std::snprintf(buf, sizeof buf, " %s=-", kKeyNames[k]);
+            }
+            out << buf;
+        }
+        out << "\n";
+    }
+}
