+    uint32_t screen = 0, scene = 0, button = 0;
+    uint32_t inst = 0, outInst = 0;   // btn_difficulty in the "in" / "out" slides
+    uint32_t titles[2] = {}, descs[2] = {};
+    uint32_t labels[3][8] = {};       // Controllers / Profile / Tutorial label texts (one per component slide)
+    int labelCount[3] = {};
+    uint32_t labelIds[3] = {}, titleId = 0;
