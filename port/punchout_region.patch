+bool ReadyToWrite() {
+    if (g.slot < 0 || g.connectedAt == 0) return false;
+    if (!g.itemsSynced && Wall() - g.connectedAt > 2.0) g.itemsSynced = true;
+    return g.itemsSynced && g.seedReady;
