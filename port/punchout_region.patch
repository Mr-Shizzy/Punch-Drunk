+// Punch-Out!! (R7PE01) frame-start function, 801BCB18 in the game's engine.
+//
+// The game paces its main loop in software: at the start of every frame it measures the time since
+// the previous frame started and, in vsync mode 1 (60 fps), sleeps the rest of 1/60 s with
+// OSSleepTicks, then takes the time again. On hardware the wake-up costs microseconds. Here every
+// wake-up costs ~0.2 ms, and because the next frame is measured from the moment after waking, that
+// cost accumulates: 16.86 ms frames, 59.3 fps, and a frame that misses its retrace every second or
+// so. The game's own swap thread is locked to the VI retrace (VIWaitForRetrace), so the loop is meant
+// to run at the retrace rate. This replacement does exactly what the original does, except that in
+// mode 1 the sleep is "wait for the next retrace", which locks the loop to the VI clock: a steady 60.
+//
+// Original (checked by disassembly, see WIP.md):
+//   if (*(f32*)0x80413E48 == 0.0f) 801BC658();   // wait for the previous frame's draw-done message
+//   else                           801BCA6C();   // same, with a timeout that aborts the GPU frame
+//   801BCC64(*(u32*)0x80413E40);
+//   801BCCC4(*(u32*)0x80413E40, *(u32*)0x80413E10);
+//   if (mode = *(u32*)0x80411DEC, mode - 1 <= 1) {
+//       elapsed_us = ((OSGetTick() - lastTick) << 3) / (timer_clock / 125000);
+//       target_us  = (u32)(1000000.0f * (1.0f / (f32)fps));        // fps = *(u32*)0x80411DD8
+//       if (elapsed_us < target_us) OSSleepTicks(OSMicrosecondsToTicks(target_us - elapsed_us));
+//   }
+//   lastTick = OSGetTick();                       // *(u32*)0x80413DE4
+//   801BCA00();                                   // flips the XFB index 0x80413E10
+
+#include "hle_stubs.h"
+#include "memory.h"
+#include "abi_bridge.h"
+#include "ppc_runtime.h"
+#include "runtime_log.h"
+
+#include <cstdint>
+#include <cstring>
+
+extern "C" void VIWaitForRetrace_HLE_801b99ec(CpuContext* ctx);
+extern "C" uint32_t VI_HLE_RetraceCount();
+extern "C" void PunchOut_MenuTick();
+extern "C" void PunchOut_ArchipelagoFrame();
+
+namespace {
+constexpr uint32_t kDrawDoneTimeoutSeconds = 0x80413E48; // f32; 0 = wait without a timeout
+constexpr uint32_t kSwapSync = 0x80413E40;
+constexpr uint32_t kXfbIndex = 0x80413E10;
+constexpr uint32_t kVsyncMode = 0x80411DEC;
+constexpr uint32_t kFrameRate = 0x80411DD8;
+constexpr uint32_t kLastFrameTick = 0x80413DE4;
+constexpr uint32_t kBusClock = 0x800000F8;
+
+constexpr uint32_t kWaitDrawDone = 0x801BC658;
+constexpr uint32_t kWaitDrawDoneTimed = 0x801BCA6C;
+constexpr uint32_t kSwapSyncWait = 0x801BCC64;
+constexpr uint32_t kSwapSyncSet = 0x801BCCC4;
+constexpr uint32_t kFlipXfbIndex = 0x801BCA00;
+constexpr uint32_t kOSSleepTicks = 0x80207C04;
+
+uint32_t g_retraceAtFrameStart = ~0u;
+
+float ReadF32(uint32_t addr) {
+    const uint32_t bits = Memory::Read32(addr);
+    float value = 0.0f;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+void Call(uint32_t target, CpuContext* cpu) {
+    InvokeIndirectCpu(target, cpu);
+}
+} // namespace
+
+extern "C" void PunchOut_FrameStart_pseudo(CpuContext* ctx) {
+    CpuContext* cpu = ctx ? ctx : &GetPersistentCpuContext();
+
+    Call(ReadF32(kDrawDoneTimeoutSeconds) == 0.0f ? kWaitDrawDone : kWaitDrawDoneTimed, cpu);
+
+    cpu->gpr[3] = Memory::Read32(kSwapSync);
+    Call(kSwapSyncWait, cpu);
+    cpu->gpr[3] = Memory::Read32(kSwapSync);
+    cpu->gpr[4] = Memory::Read32(kXfbIndex);
+    Call(kSwapSyncSet, cpu);
+
+    const uint32_t mode = Memory::Read32(kVsyncMode);
+    if (mode - 1u <= 1u) {
+        const uint32_t elapsedTicks = PPC_Mftb() - Memory::Read32(kLastFrameTick);
+        const uint32_t ticksPerEighthUs = (Memory::Read32(kBusClock) >> 2) / 125000u;
+        const uint32_t elapsedUs = ticksPerEighthUs ? (elapsedTicks << 3) / ticksPerEighthUs : 0u;
+        const uint32_t fps = Memory::Read32(kFrameRate);
+        const uint32_t targetUs =
+            fps ? static_cast<uint32_t>(1000000.0f * (1.0f / static_cast<float>(fps))) : 0u;
+        if (elapsedUs < targetUs) {
+            if (mode == 1u) {
+                // 60 fps: the frame ends at the next retrace. If one already passed since this frame
+                // started, the boundary is behind us and the next frame starts now.
+                if (VI_HLE_RetraceCount() == g_retraceAtFrameStart) {
+                    VIWaitForRetrace_HLE_801b99ec(cpu);
+                }
+            } else {
+                // Mode 2 (30 fps) keeps the game's own timed sleep.
+                const uint64_t ticks = (static_cast<uint64_t>(targetUs - elapsedUs) * ticksPerEighthUs) / 8u;
+                cpu->gpr[3] = static_cast<uint32_t>(ticks >> 32);
+                cpu->gpr[4] = static_cast<uint32_t>(ticks);
+                Call(kOSSleepTicks, cpu);
+            }
+        }
+    }
+
+    Memory::Write32(kLastFrameTick, PPC_Mftb());
+    g_retraceAtFrameStart = VI_HLE_RetraceCount();
+    PunchOut_MenuTick();
+    PunchOut_ArchipelagoFrame(); // hle/punchout_ap_client.cpp
+    Call(kFlipXfbIndex, cpu);
+}
+PPC_NATIVE_OVERRIDE_VOID(80FF000C, PunchOut_FrameStart_pseudo, (CpuContext* ctx), (ctx));
