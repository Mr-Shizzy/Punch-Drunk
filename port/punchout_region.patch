+// ---- guest memory ----
+constexpr uint32_t kMem1 = 0x80000000u, kMem1Size = 0x01800000u, kMem2 = 0x90000000u, kMem2Size = 0x04000000u;
+uint8_t* Ram(uint32_t a, uint32_t n) {
+    if (a >= kMem1 && a - kMem1 <= kMem1Size - n) {
+        auto* m = static_cast<uint8_t*>(Memory::GetPointer(kMem1, kMem1Size));
+        return m ? m + (a - kMem1) : nullptr;
+    }
+    if (a >= kMem2 && a - kMem2 <= kMem2Size - n) {
+        auto* m = static_cast<uint8_t*>(Memory::GetPointer(kMem2, kMem2Size));
+        return m ? m + (a - kMem2) : nullptr;
+    }
+    return nullptr;
+}
+bool InMem1(uint32_t a) { return a >= kMem1 && a < kMem1 + kMem1Size; }
+bool InWii(uint32_t a) { return InMem1(a) || (a >= kMem2 && a < kMem2 + kMem2Size); }
+uint32_t R32(uint32_t a) {
+    const uint8_t* p = Ram(a, 4);
+    return p ? (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3] : 0;
+}
+uint8_t R8(uint32_t a) {
+    const uint8_t* p = Ram(a, 1);
+    return p ? *p : 0;
+}
+float RF(uint32_t a) {
+    const uint32_t v = R32(a);
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+void W32(uint32_t a, uint32_t v) {
+    if (uint8_t* p = Ram(a, 4)) {
+        p[0] = uint8_t(v >> 24); p[1] = uint8_t(v >> 16); p[2] = uint8_t(v >> 8); p[3] = uint8_t(v);
+    }
+}
+void W8(uint32_t a, uint8_t v) {
+    if (uint8_t* p = Ram(a, 1)) *p = v;
+}
+void WF(uint32_t a, float f) {
+    uint32_t v;
+    std::memcpy(&v, &f, 4);
+    W32(a, v);
+}
+bool ReadBytes(uint32_t a, uint8_t* out, uint32_t n) {
+    const uint8_t* p = Ram(a, n);
+    if (!p) return false;
+    std::memcpy(out, p, n);
+    return true;
+}
+bool Bad(float v) { return std::isnan(v); }
+
+uint32_t Crc32(const std::string& s) {
+    uint32_t c = 0xFFFFFFFFu;
+    for (unsigned char ch : s) {
+        c ^= ch;
+        for (int k = 0; k < 8; ++k) c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
+    }
+    return ~c;
+}
+
+double Now() {
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+}
+double Wall() {
+    using namespace std::chrono;
+    return duration<double>(system_clock::now().time_since_epoch()).count();
+}
+
+// ---- reading an .appunchout (a zip with punchout.json) ----
+std::optional<Json> ReadPatchFile(const std::string& path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return std::nullopt;
+    std::vector<uint8_t> z((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    const auto u16 = [&z](size_t o) { return uint32_t(z[o]) | (uint32_t(z[o + 1]) << 8); };
+    const auto u32 = [&z](size_t o) { return uint32_t(z[o]) | (uint32_t(z[o + 1]) << 8) | (uint32_t(z[o + 2]) << 16) | (uint32_t(z[o + 3]) << 24); };
+    // Central directory (sizes are reliable there).
+    size_t eocd = std::string::npos;
+    for (size_t i = z.size() >= 22 ? z.size() - 22 : 0; i + 22 <= z.size(); --i) {
+        if (u32(i) == 0x06054B50u) {
+            eocd = i;
+            break;
+        }
+        if (i == 0) break;
+    }
+    if (eocd == std::string::npos) return std::nullopt;
+    size_t cd = u32(eocd + 16);
+    const uint32_t entries = u16(eocd + 10);
+    for (uint32_t e = 0; e < entries && cd + 46 <= z.size() && u32(cd) == 0x02014B50u; ++e) {
+        const uint32_t method = u16(cd + 10), csize = u32(cd + 20), nlen = u16(cd + 28), xlen = u16(cd + 30),
+                       clen = u16(cd + 32), local = u32(cd + 42);
+        const std::string name(reinterpret_cast<const char*>(&z[cd + 46]), nlen);
+        cd += 46 + nlen + xlen + clen;
+        if (name != "punchout.json" || local + 30 > z.size()) continue;
+        const size_t data = local + 30 + u16(local + 26) + u16(local + 28);
+        if (data + csize > z.size()) return std::nullopt;
+        std::string text;
+        if (method == 0) {
+            text.assign(reinterpret_cast<const char*>(&z[data]), csize);
+        } else if (method == 8) {
+            int outLen = 0;
+            char* out = stbi_zlib_decode_noheader_malloc(reinterpret_cast<const char*>(&z[data]), static_cast<int>(csize), &outLen);
+            if (!out) return std::nullopt;
+            text.assign(out, static_cast<size_t>(outLen));
+            std::free(out);
+        } else {
+            return std::nullopt;
+        }
+        try {
+            return Json::parse(text);
+        } catch (...) {
+            return std::nullopt;
+        }
+    }
+    return std::nullopt;
+}
