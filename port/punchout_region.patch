+void PunchOutHeartbeat(const char* source) noexcept
+{
+    if (::GuestRegion::Current() != ::GuestRegion::Id::PunchOut) {
+        return;
+    }
+    static std::atomic<int64_t> lastMs{0};
+    static const auto start = std::chrono::steady_clock::now();
+    const int64_t nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    int64_t last = lastMs.load(std::memory_order_relaxed);
+    if (nowMs - last < 5000 || !lastMs.compare_exchange_strong(last, nowMs)) {
+        return;
+    }
+    const CpuContext* cpu = TryGetCpuContext();
+    std::fprintf(stderr,
+                 "[heartbeat] t=%llds from=%s active=0x%08X lr=0x%08X frames=%llu draws=%llu copydisp=%llu xfb=%llu drawdone=%llu\n",
+                 static_cast<long long>(nowMs / 1000), source, RecompMod::CurrentTranslatedExecutionAddress(),
+                 cpu ? cpu->lr : 0u, static_cast<unsigned long long>(g_punchOutPresentedFrames.load()),
+                 static_cast<unsigned long long>(g_punchOutGxBegins.load()),
+                 static_cast<unsigned long long>(g_punchOutCopyDisps.load()),
+                 static_cast<unsigned long long>(g_punchOutXfbReady.load()),
+                 static_cast<unsigned long long>(g_punchOutPeFinishes.load()));
+    // Guest call chain from the saved-LR words of the PowerPC stack frames.
+    if (cpu) {
+        std::fprintf(stderr, "[heartbeat]   stack:");
+        uint32_t sp = cpu->gpr[1];
+        for (int depth = 0; depth < 16; ++depth) {
+            uint32_t next = 0;
+            uint32_t savedLr = 0;
+            if (!Memory::TryRead32(sp, next) || next <= sp || next - sp > 0x10000u ||
+                !Memory::TryRead32(next + 4u, savedLr)) {
+                break;
+            }
+            std::fprintf(stderr, " %08X", savedLr);
+            sp = next;
+        }
+        std::fprintf(stderr, "\n");
