# POW: Recompiled!! Steam Deck build environment: Ubuntu 24.04 with everything the port's build needs. The Steam Deck
# launcher carries this (exported as buildroot.tar.xz), unpacks it into its tools folder and builds the game inside
# it through bubblewrap, so SteamOS needs nothing installed. Ubuntu 24.04's glibc (2.39) is older than SteamOS's, so
# the game built here runs on SteamOS itself.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash coreutils ca-certificates curl git xz-utils bubblewrap file \
      clang lld llvm g++ libc6-dev cmake ninja-build make pkg-config python3 \
      libicu74 libssl3t64 zlib1g \
      libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxfixes-dev libxi-dev libxss-dev libxtst-dev \
      libxinerama-dev libxkbcommon-dev libwayland-dev wayland-protocols libdecor-0-dev \
      libegl-dev libgl-dev libgles-dev libdrm-dev libgbm-dev libvulkan-dev \
      libpulse-dev libpipewire-0.3-dev libasound2-dev libudev-dev libdbus-1-dev \
 && rm -rf /var/lib/apt/lists/*
# .NET 8: Microsoft's newest 8.0 SDK (Ubuntu's own dotnet-sdk-8.0 is the 8.0.1xx band, too old for the translator).
RUN curl -sSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && bash /tmp/dotnet-install.sh --channel 8.0 --install-dir /opt/dotnet \
 && ln -s /opt/dotnet/dotnet /usr/local/bin/dotnet && rm -f /tmp/dotnet-install.sh
# Smaller, and ready for bubblewrap (home folders and SD cards are bound over these). /etc/resolv.conf is left alone:
# Docker and podman mount their own over it while building; the launcher makes it a plain file when it unpacks this.
RUN rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /var/cache/apt/* /var/log/* \
 && mkdir -p /home /run/media /media /mnt
