{
  "name": "punch-drunk",
  "version": "1.0.0",
  "private": true,
  "description": "Punch-Drunk: Punch-Out (Wii) Recomp. A portable launcher that builds the Punch-Out!! (Wii) and Doc Louis's Punch-Out!! PC ports on your computer from your own copies",
  "main": "src/main.js",
  "license": "MIT",
  "author": "Mr-Shizzy (fork of POW: Recompiled!!)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/wad.test.js test/art.test.js test/updater.test.js",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "node packaging/build_release.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "io.github.mrshizzy.punchdrunk",
    "productName": "Punch-Drunk",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "build_port.sh",
          "build_port.ps1"
        ]
      },
      {
        "from": "../port",
        "to": "port-source",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Punch-Drunk.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "buildkit",
          "to": "buildkit",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal"
  }
}
