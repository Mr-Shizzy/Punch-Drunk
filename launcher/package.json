{
  "name": "pow-recompiled-launcher",
  "version": "0.3.1",
  "private": true,
  "description": "POW: Recompiled!! (POW = Punch-Out!! Wii): sets up and launches the Punch-Out!! (Wii) PC port, built on your computer from your own disc",
  "main": "src/main.js",
  "license": "MIT",
  "author": "POW: Recompiled!! contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "dev.fistin.launcher",
    "productName": "POW Recompiled Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "build_port.sh",
          "build_port.ps1"
        ]
      },
      {
        "from": "../port",
        "to": "port-source",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "POW-Recompiled-Launcher.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "POW-Recompiled-Launcher-Setup.${ext}",
      "compression": "maximum"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POW Recompiled!!",
      "uninstallDisplayName": "POW: Recompiled!! Launcher",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal"
  }
}
