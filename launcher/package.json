{
  "name": "pow-recompiled-launcher",
  "version": "0.3.1",
  "private": true,
  "description": "POW: Recompiled!! (POW = Punch-Out!! Wii): a portable launcher that builds the Punch-Out!! (Wii) and Doc Louis's Punch-Out!! PC ports on your computer from your own copies",
  "main": "src/main.js",
  "license": "MIT",
  "author": "POW: Recompiled!! contributors",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/wad.test.js",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "node packaging/build_release.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "dev.fistin.launcher",
    "productName": "POW Recompiled Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "build_port.sh",
          "build_port.ps1"
        ]
      },
      {
        "from": "../port",
        "to": "port-source",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "POW-Recompiled-Launcher.${ext}",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "normal"
  }
}
