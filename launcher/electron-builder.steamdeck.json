{
  "appId": "dev.fistin.launcher",
  "productName": "Punch-Drunk",
  "files": [
    "src/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "scripts",
      "to": "scripts",
      "filter": [
        "build_port.sh",
        "build_port_steamdeck.sh",
        "setup_steamdeck_tools.sh"
      ]
    },
    {
      "from": "../port",
      "to": "port-source",
      "filter": [
        "**/*"
      ]
    }
  ],
  "linux": {
    "target": "AppImage",
    "category": "Game",
    "icon": "build/icon.png",
    "artifactName": "Punch-Drunk-SteamDeck.${ext}",
    "executableArgs": [
      "--no-sandbox"
    ],
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../port/LICENSE",
        "to": "LICENSE-port.txt"
      },
      {
        "from": "packaging/THIRD_PARTY_NOTICES-linux.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ]
  },
  "electronLanguages": [
    "en-US"
  ],
  "compression": "normal",
  "directories": {
    "output": "dist"
  }
}
